<!-- Crispness settings on the Window below, inherited by everything in it.

     UseLayoutRounding: without it, layout lands on fractional device pixels, so
     a 1px divider gets spread across two pixels as two grey halves. Subtle at
     100% scaling, obvious at the 125-150% that 4K laptop and 27"+ users
     typically run.

     TextOptions.TextFormattingMode is deliberately NOT set, i.e. left at WPF's
     default "Ideal", which positions glyphs at fractional pixels so text stays
     geometrically correct under scaling. The alternative, "Display", snaps them
     to the pixel grid the way native Windows apps do - measurably crisper at
     the 9-20pt sizes used here, but it thickens the strokes, and that tradeoff
     was judged by eye on a 4K screen at 150% rather than assumed. Re-add it
     here if that judgement ever changes; nothing else depends on it. -->
<Window x:Class="SidebarExplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SidebarExplorer.App"
        xmlns:models="clr-namespace:SidebarExplorer.App.Models"
        xmlns:services="clr-namespace:SidebarExplorer.App.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="Edgetree"
        Icon="pack://application:,,,/Resources/app.ico"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        Background="{DynamicResource SidebarBackground}"
        Left="0"
        Top="0"
        Height="600"
        Width="280"
        MouseEnter="MainWindow_MouseEnter"
        MouseLeave="MainWindow_MouseLeave"
        AllowDrop="True"
        DragEnter="MainWindow_DragOver"
        DragOver="MainWindow_DragOver"
        DragLeave="MainWindow_DragLeave"
        Drop="MainWindow_Drop">
    <shell:WindowChrome.WindowChrome>
        <!-- CaptionHeight/ResizeBorderThickness start at 0 (docked: fixed position,
             no native move/resize). Undock()/Dock() in code-behind flip these when
             the header is dragged away from / pinned back to the left edge.

             GlassFrameThickness starts NONZERO and stays that way in both modes:
             zero would put WindowChromeWorker on its non-glass path, which
             re-applies a window region (a full-frame invalidate) on every
             WM_WINDOWPOSCHANGED - see Dock() for the measurement that caught it. -->
        <shell:WindowChrome x:Name="ChromeSettings"
                             CaptionHeight="0"
                             ResizeBorderThickness="0"
                             GlassFrameThickness="0,0,0,1"
                             CornerRadius="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Popups only (context/options menus, submenus) - never the docked
             sidebar itself, which sits flush against the screen edge with
             nothing to visually separate from there. Popups already render
             through a transparent-capable host window (unlike this Window,
             which is AllowsTransparency="False" - see Dock/Undock's own
             GlassFrameThickness toggle for how the main window's shadow is
             handled instead, only while floating in 창모드), so a plain
             DropShadowEffect works directly here. Cheap to leave applied even
             while open - it's not re-rendered on any kind of per-frame loop,
             just once whenever a menu opens. -->
        <DropShadowEffect x:Key="MenuDropShadow"
                Color="Black"
                Direction="270"
                ShadowDepth="2"
                BlurRadius="8"
                Opacity="0.4"/>
        <!-- Applied to every header element except AppIcon (see the TODO note
             this came from: divider 2px lower, everything but the icon 1px
             higher). A RenderTransform, not a Margin tweak, so it's a pure
             visual nudge that doesn't change each element's own layout slot
             or spacing relative to its neighbors - and it's safe to share one
             instance across every element that uses it, since none of them
             ever mutate it at runtime (unlike the color-setting brushes
             elsewhere in this file, which do and so can't be shared once a
             sealed Style freezes them). -->
        <TranslateTransform x:Key="ShiftUp1px"
                Y="-1"/>

        <!-- The header glyphs are not all optically centred by the same amount:
             their drawn shapes sit differently inside their boxes, so a single
             shared nudge leaves some looking high and others low. Judged on a
             magnified capture against guide lines rather than by eye at size.
             The X reads a pixel low with the shared nudge and takes this one
             instead; the pin and the "..." read a pixel high and take none at
             all (they are simply left untransformed). -->
        <TranslateTransform x:Key="ShiftUp2px"
                Y="-2"/>

        <!-- One visual step up for every header GLYPH (pin, magnifier,
             collapse arrow, "...", minimize bar, close X) - applied to the
             glyph element inside each button, never the button itself, so the
             hit-box, margins and header layout stay byte-identical (a
             RenderTransform happens after layout, same reasoning as the
             nudges above). ~15% ≈ +2px on these 10-13px shapes. On the
             options button it scales only the three-dot StackPanel, not the
             update-available dot overlaid in the same Grid.

             Unlike the nudges above, this one IS mutated at runtime:
             ApplyHeaderMetrics steps it back to 1.0 when the window narrows
             to 224 or less. That only works while the instance stays
             unfrozen - keep it out of any Style setter (sealed styles freeze
             their freezables). -->
        <ScaleTransform x:Key="HeaderGlyphGrow"
                ScaleX="1.15"
                ScaleY="1.15"/>

        <SolidColorBrush x:Key="SidebarBackground"
                Color="#FF1A1A1A"/>
        <SolidColorBrush x:Key="FavoritesBackground"
                Color="#FF1C1C1C"/>
        <SolidColorBrush x:Key="HeaderBackground"
                Color="#FF1E1E1E"/>
        <!-- The auto-hidden handle/bar (AppSettings.AutoHideHandleColorHex).
             Painted by AutoHideHandleOverlay at the very bottom of this file,
             not by any of the panels - see its comment. -->
        <SolidColorBrush x:Key="AutoHideHandleBackground"
                Color="#FF1A1A1A"/>
        <!-- ForegroundText/HighlightForeground (general header/menu/favorites
             chrome text) now live in App.xaml instead - Application-level so
             ColorSettingsWindow/AboutWindow can share them too, see its own
             comment for why they're deliberately kept separate from the
             customizable tree colors just below. -->
        <!-- Folder-name colors (AppSettings.FolderNameColorHex/
             FolderNameHighlightColorHex) - only ever used by the tree's own
             TreeViewItem style (folder rows inherit these; file rows have
             their own FileNameForeground/FileNameHighlightForeground pair
             below). Defaults identical to ForegroundText/HighlightForeground
             so the tree looks the same as before until customized. -->
        <SolidColorBrush x:Key="FolderNameForeground"
                Color="#FFA8AAAE"/>
        <SolidColorBrush x:Key="FolderNameHighlightForeground"
                Color="#FFF0F2F6"/>
        <!-- File-name colors (AppSettings.FileNameColorHex) - only ever used
             by the tree row's own NameText (see the HierarchicalDataTemplate
             triggers below), for the ShowFileIcons-driven folder/file split.
             Defaults identical to ForegroundText/HighlightForeground so files
             look the same as before until customized independently. -->
        <SolidColorBrush x:Key="FileNameForeground"
                Color="#FFA8AAAE"/>
        <SolidColorBrush x:Key="FileNameHighlightForeground"
                Color="#FFF0F2F6"/>
        <SolidColorBrush x:Key="TreeRowHoverBackground"
                Color="#FF2A2C32"/>
        <!-- Folder/file hover text colors (AppSettings.FolderNameHoverColorHex/
             FileNameHoverColorHex) - same folder-vs-file split as the name
             colors above, just for the hover state. -->
        <SolidColorBrush x:Key="FolderNameHoverForeground"
                Color="#FFA8AAAE"/>
        <SolidColorBrush x:Key="FileNameHoverForeground"
                Color="#FFA8AAAE"/>
        <!-- The "…더 보기 (N개)" overflow row's own text color
             (AppSettings.ShowMoreColorHex) - previously just inherited
             FolderNameForeground at reduced opacity (see ShowMoreText's own
             Opacity below); same default so existing users see no change
             until they customize it separately. -->
        <SolidColorBrush x:Key="ShowMoreForeground"
                Color="#FFA8AAAE"/>
        <SolidColorBrush x:Key="TreeRowSelectedActiveBackground"
                Color="#FF323438"/>
        <SolidColorBrush x:Key="TreeGuideLineBrush"
                Color="#FF323438"/>
        <SolidColorBrush x:Key="TreeGuideLineActiveBrush"
                Color="#FF5C5E62"/>
        <!-- Header/favorites/tree panel-separator lines (AppSettings.
             PanelDividerColorHex) - a dedicated resource, not a reuse of
             TreeGuideLineBrush (see the header divider's own comment below
             for why that used to be the case). -->
        <SolidColorBrush x:Key="PanelDividerBrush"
                Color="#FF323438"/>
        <!-- The image viewer panel's backdrop (AppSettings.
             ViewerBackgroundColorHex) - its own colour row in 색상 설정, so a
             photo can sit on near-black while the tree keeps its colour. -->
        <SolidColorBrush x:Key="ViewerBackground"
                Color="#FF1A1A1A"/>


        <!-- Folder icons only (see the HierarchicalDataTemplate's IsDirectory
             DataTrigger below) - swapped live via Resources[...] = ... in
             code-behind on toggle, same pattern as the color settings'
             DynamicResource brushes, so every currently-visible folder row
             picks it up immediately without per-item property-changed
             plumbing. -->
        <Visibility x:Key="FolderIconVisibility">Visible</Visibility>
        <Visibility x:Key="FileIconVisibility">Visible</Visibility>

        <!-- Row icon/name size/margins - see MainWindow.xaml.cs's
             ApplyIconMetrics for how these four are actually computed
             (font-size-scaled, and FileRowIconMargin/FileNameMargin
             depending on both icon toggles); the values here are just
             defaults matching FontSize=12 until that first runs.
             FolderRowIconMargin is also the default Margin every row's
             RowIcon starts with in the template below - FileRowIconMargin
             overrides it only for file rows (IsDirectory=False trigger).
             FileNameMargin likewise only applies to a file row's NameText/
             NameEditBox, for the one combination (folder icons on, file
             icons off) where RowIcon is Collapsed and so can't carry the
             alignment shift itself. -->
        <system:Double x:Key="IconSize">16</system:Double>
        <!-- Both replaced from ApplyLayoutMetrics; these are the values they
             hold until it first runs, and match AppSettings' own defaults. -->
        <system:Double x:Key="ScrollBarThickness">12</system:Double>
        <GridLength x:Key="ScrollGutterWidth">13</GridLength>
        <!-- The chip strips - the footer's filters and the viewer's zoom/
             transport row. All three numbers move together from one place in
             ApplyLayoutMetrics; these are what they hold until it first runs
             (tree at its default 12). The glyph and icon sizes are the text
             size plus two: a ⏸ or a fit_screen mark set at the label's own
             size reads smaller than the label beside it. -->
        <!-- The BOX every Material glyph is drawn inside, not the size of its
             ink. Those icons are designed at different sizes within a shared
             960-unit box - a magnifier fills 672 of it, a close X only 480, a
             chevron 384 - and that difference is the family's own optical
             sizing. Fitting each path's BOUNDS to a common size throws it away
             and the row stops looking like a set (reported with a screenshot,
             2026-08-10: "미묘하게 좀 달라보이는", and the pin, narrowest of
             them, and reading small).
             So every glyph's Data carries "M0-960H960M0 0H960" at the END: two
             absolute horizontal segments at the box's top and bottom. They
             enclose no area, so a Fill paints nothing (verified by rendering);
             they only make the geometry's bounds the whole box, which is what
             Stretch then fits. APPENDED, never prepended - most of these paths
             open with a relative "m", which would then start from wherever the
             box left the pen (measured: it moved the pin 624 units sideways). -->
        <system:Double x:Key="HeaderGlyphBox">18</system:Double>
        <system:Double x:Key="FooterChipFontSize">9</system:Double>
        <system:Double x:Key="ViewerChipGlyphFontSize">11</system:Double>
        <system:Double x:Key="ViewerChipIconSize">11</system:Double>
        <!-- Every button in the viewer's strip draws the same box, whether it
             holds an icon, a word or a single glyph - which is the only way a
             row mixing all three reads as one set of controls. Derived from the
             icon size so the box follows Ctrl +/- with everything else. -->
        <system:Double x:Key="ViewerChipBoxWidth">21</system:Double>
        <system:Double x:Key="ViewerChipBoxHeight">17</system:Double>
        <!-- The outline on the strip's word-and-glyph buttons (1:1, − +, < >).
             The icon chips beside them already read as controls because a mark
             has a shape; a bare "1:1" or "−" reads as text until something
             draws the box around it.
             Mid grey at low alpha rather than a theme colour, for the reason
             the navigator's plate takes fixed inks: what sits behind this strip
             is the viewer's own surface in either theme, and alpha lands
             somewhere sensible on both where a fixed grey would disappear into
             one of them. -->
        <SolidColorBrush x:Key="ViewerChipBorderBrush"
                Color="#808080"
                Opacity="0.4"/>
        <!-- The strip's two gaps, and they are Thicknesses rather than numbers
             for a reason worth keeping: a local Margin on a control REPLACES
             the style's whole Thickness, it does not merge with it. Writing
             Margin="6,0,0,0" on a chip to push it away from its neighbour
             therefore silently dropped the style's own right margin, and the
             two chips after it ended up touching (reported with a screenshot,
             2026-08-10). Every chip in the row now takes one of these two, so
             the right-hand gap is carried no matter which is applied.
             The group gap separates the three things this row does - set the
             zoom / step the zoom / switch a panel on. -->
        <Thickness x:Key="ViewerChipMargin">0,0,4,0</Thickness>
        <Thickness x:Key="ViewerChipGroupMargin">10,0,4,0</Thickness>
        <!-- The transport row's own outer margin. Its negative right cancels
             the last button's gap so the row centres on the buttons, exactly
             as ViewerCaptionChipRowGap does for the zoom row - and like that
             one it has to track the gap rather than restate it. -->
        <Thickness x:Key="ViewerMediaButtonRowMargin">0,4,-4,0</Thickness>
        <Thickness x:Key="FolderRowIconMargin">0,0,6,0</Thickness>
        <Thickness x:Key="FileRowIconMargin">0,0,6,0</Thickness>
        <Thickness x:Key="FileNameMargin">0,0,0,0</Thickness>

        <!-- The "들여쓰기 간격" (indent width) family - see MainWindow.xaml.cs's
             ApplyLayoutMetrics for how these three are actually computed
             from AppSettings.TabSpacing (user-adjustable 4~24 from the "..."
             options menu); the values here are just defaults matching the
             original hardcoded 16px until that first runs.
             TabSpacingWidth is the expand arrow's own column width
             (ExplorerTreeViewItemStyle's ExpanderColumn below) - every row,
             folder or file, reserves this much space for the arrow/gutter.
             TabSpacingGuideMargin/TabSpacingGuidePadding are the same
             template's ItemsHost Margin/Padding, which together with its
             fixed 1px BorderThickness produce the cascading per-level indent
             and position the guide line under the arrow's own center. -->
        <GridLength x:Key="TabSpacingWidth">16</GridLength>
        <Thickness x:Key="TabSpacingGuideMargin">8,0,0,0</Thickness>
        <Thickness x:Key="TabSpacingGuidePadding">7,0,0,0</Thickness>

        <!-- The column a file row's TreeViewItem template always reserves
             for the expand arrow it never shows (folders alone can expand) -
             only collapsed to 0 when BOTH folder and file icons are off, so a
             file's name sits flush with the true left edge, to the left of a
             sibling folder's still-visible arrow, instead of leaving an empty
             arrow-width gap before it. With either icon type still on, files
             keep this gutter (matching TabSpacingWidth) as before, aligning
             their icon/name with a folder's icon/name the normal way. -->
        <GridLength x:Key="FileArrowGutterWidth">16</GridLength>

        <Style x:Key="ToggleButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundText}"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <!-- Sized from a resource so the header row can shrink its buttons
                 as the window narrows (see ApplyHeaderMetrics) instead of
                 letting them overflow past the right edge. Buttons outside the
                 header (the search panel's) set their own Width/Height, which
                 overrides these. -->
            <Setter Property="Width"
                    Value="{DynamicResource HeaderButtonSize}"/>
            <Setter Property="Height"
                    Value="{DynamicResource HeaderButtonSize}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- The outline was declared on the style and never
                             DRAWN until 2026-08-11 - the template took the
                             Background and dropped the two border properties, so
                             a button asking for one silently got nothing. Bound
                             now; the style's own 0 keeps every header button
                             exactly as it was, and the path bar's two history
                             chevrons are the first to ask for a resting outline
                             (matching the path field they sit beside). -->
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <!-- Dimmed by default and brightened on hover (see the
                                 trigger below) - an Opacity toggle on the whole
                                 icon rather than recoloring each one's own
                                 Stroke/Fill individually, since every header
                                 icon (Path/Ellipse/Image) sets those directly
                                 rather than inheriting a bindable Foreground the
                                 way TextBlock does. -->
                            <ContentPresenter x:Name="Content"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0.85"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="Content"
                                        Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                            <!-- Declared after the hover trigger so it wins for
                                 a disabled button: the pin now stays in place
                                 greyed out when it isn't applicable (rather
                                 than vanishing and shifting the whole row) -
                                 see UpdatePinButtonVisibility. -->
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="Transparent"/>
                                <!-- Dim enough to read as unavailable, but not so
                                     dim it looks like a rendering fault - 0.3
                                     left the glyph barely visible against the
                                     header. -->
                                <Setter TargetName="Content"
                                        Property="Opacity"
                                        Value="0.45"/>
                                <Setter Property="Cursor"
                                        Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Overriding the system selection/hover brushes is the reliable way to
             re-theme TreeViewItem, since its default ControlTemplate reads these
             keys directly rather than the Background property. Both the focused
             (Highlight*) and unfocused (InactiveSelectionHighlight*) variants must
             be set, or losing focus (the common case for a sidebar utility) falls
             back to the default light/white selection color. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                Color="#FF37373D"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                Color="#FF2A2D2E"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                Color="#FFCCCCCC"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                Color="#FF2A2D2E"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"
                Color="#FFCCCCCC"/>

        <!-- How tall a menu may grow before it starts scrolling instead. Only a
             placeholder here: ApplyMenuMaxHeight overwrites it with the CURRENT
             monitor's work area minus the popup's own chrome, and keeps it in
             step with monitor/DPI/zoom changes. Both menu templates below bind
             their ScrollViewer's MaxHeight to it. -->
        <system:Double x:Key="MenuMaxHeight">600</system:Double>

        <!-- The scroll host both menu templates below wrap their items in.
             Shared as a Style so the two can't drift apart.

             The Padding trigger is the point of it: when the bar is actually
             showing, the content gets a gap of its own before the bar's lane
             starts. Without it a full-width row - the image thumbnail most
             visibly - ends flush against the thumb (2026-08-02: "썸네일 hover가
             스크롤바 썸에 딱 달라 붙어 있어요"). Keyed off
             ComputedVerticalScrollBarVisibility rather than applied always, so
             a short menu that never scrolls keeps exactly the symmetry it had
             before any of this existed.

             DynamicResource throughout: MinimalScrollViewerTemplate and the
             metrics are declared further down this same dictionary, and a
             StaticResource may only look backwards. -->
        <Style x:Key="MenuScrollViewerStyle"
                TargetType="ScrollViewer">
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="MaxHeight"
                    Value="{DynamicResource MenuMaxHeight}"/>
            <Setter Property="Template"
                    Value="{DynamicResource MinimalScrollViewerTemplate}"/>
            <Setter Property="VerticalScrollBarVisibility"
                    Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility"
                    Value="Disabled"/>
            <Setter Property="Padding"
                    Value="0"/>
            <!-- What turns MinimalScrollViewerTemplate's two "more this way"
                 chevrons on. Only menus attach this, which is what keeps those
                 glyphs invisible in the tree and the lists. -->
            <EventSetter Event="ScrollChanged"
                    Handler="MenuScrollViewer_ScrollChanged"/>
            <Style.Triggers>
                <Trigger Property="ComputedVerticalScrollBarVisibility"
                        Value="Visible">
                    <Setter Property="Padding"
                            Value="{DynamicResource MenuScrollContentPadding}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark ContextMenu/MenuItem/Separator chrome. The default templates
             don't respect a plain Background/Foreground Setter for these (same
             issue we hit with TreeViewItem), so - as before - the reliable fix
             is a full custom ControlTemplate rather than relying on the theme's
             own rendering to pick up simple property values. -->
        <Style x:Key="DarkContextMenuStyle"
                TargetType="ContextMenu">
            <!-- A touch darker than the sidebar's own background so the menu
                 still reads as a distinct surface, without contrasting hard. -->
            <Setter Property="Background"
                    Value="{DynamicResource PanelBackground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <!-- FontSize/Padding follow the tree's Ctrl +/- zoom - app-level
                 resources filled by ApplyLayoutMetrics (menus render in their
                 own popups, so they'd never inherit the tree's font on their
                 own). FontSize set here propagates down to every MenuItem and
                 custom header content by normal property inheritance. -->
            <Setter Property="FontSize"
                    Value="{DynamicResource MenuFontSize}"/>
            <Setter Property="Padding"
                    Value="{DynamicResource MenuPadding}"/>
            <!-- Compensates for the Border's own Margin below (see its
                 comment) - without this, reserving that bleed room for the
                 shadow would also visibly shift the menu 10px down-right from
                 wherever it's normally placed (e.g. flush under a right-
                 clicked row). Net effect together: the visible border renders
                 at exactly the same position as before, just with transparent
                 room framing it now. -->
            <Setter Property="HorizontalOffset"
                    Value="-10"/>
            <Setter Property="VerticalOffset"
                    Value="-10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <!-- Margin reserves room for the DropShadowEffect's
                             blur/offset to actually render into - a Popup
                             sizes itself to its child's plain layout bounds,
                             which ignore an Effect entirely, so without this
                             the shadow was being silently clipped off right at
                             the popup's own edge (invisible, not just faint). -->
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                Margin="10"
                                CornerRadius="8"
                                Effect="{DynamicResource MenuDropShadow}"
                                SnapsToDevicePixels="True">
                            <!-- WPF's stock ContextMenu template wraps the items
                                 host in a ScrollViewer - that is where a menu's
                                 scroll arrows come from. This replacement had
                                 dropped it, so a menu taller than the screen was
                                 simply CUT OFF at the bottom edge with no way to
                                 reach the rest (reported 2026-08-02 with 65
                                 hidden folders in the list; the bookmark list is
                                 the same template and only ever needed the same
                                 number of rows to do it). MaxHeight is what
                                 makes it scroll rather than grow - a ScrollViewer
                                 given unbounded height never scrolls at all. -->
                            <ScrollViewer Style="{DynamicResource MenuScrollViewerStyle}">
                                <StackPanel IsItemsHost="True"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Implicit (no x:Key) rather than assigned via ItemContainerStyle:
             ItemContainerStyle applies to every item in the ContextMenu
             regardless of type, and crashes outright when a Separator
             (mixed in alongside the MenuItems) gets handed a MenuItem-typed
             style. An implicit style only matches MenuItems, leaving
             Separators to their own separate implicit style below. -->
        <!-- The per-row remove button in the 북마크 목록 submenu. Hidden until
             its row is highlighted: the row is already lit under the cursor,
             so the button appearing there reads as belonging to it, and the
             list stays quiet the rest of the time. Foreground is inherited
             from the MenuItem template's own TextBlock.Foreground, so it
             follows the theme without naming a brush. -->
        <!-- The "해제" button on a bookmark-list / hidden-folder-list row.
             It used to be a "−" that appeared only on the hovered row: compact,
             but easy to miss entirely and a small target once found (
             2026-08-02: "-가 너무 작아서 놓치기가 쉽네요"). Now it is a word,
             on every row, always there - so the list says what can be done with
             it without being explored first.
             Quiet by outline rather than by fading: a hairline border and no
             fill until the pointer is on it, at which point it takes the row's
             hover colour. Nothing here is dimmed - that is not how this app
             marks anything secondary - and the smaller font is what keeps the
             word from competing with the folder name beside it. -->
        <Style x:Key="MenuRowActionButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Padding"
                    Value="7,1"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MenuForeground}"/>
            <!-- A step below the menu's own size, so the word reads as an
                 action attached to the row rather than as part of the name
                 beside it. A smaller font, not a faded one - the app never
                 marks anything secondary by fading. -->
            <Setter Property="FontSize"
                    Value="{DynamicResource MenuChipFontSize}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Outlined and filled with the same chrome brushes the
                             dialog buttons use (ControlBorder / HoverBackground /
                             ControlHoverBorder), so every button in the app that
                             is a button rather than a row reads as one family.
                             The border used to be MenuDisabledForeground and the
                             hover fill the user's own TreeRowHoverBackground -
                             which made this chip drift with a colour meant for
                             the tree's rows, and left it a shade apart from the
                             buttons in Color Settings. Size stays smaller than a
                             dialog button's on purpose (see above); only the
                             colours are shared. -->
                        <Border x:Name="Chip"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Chip"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="Chip"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ControlHoverBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A menu row that HOLDS a button instead of being one. The lists'
             전체 해제 sits here.
             It needs the menu's own padding, so its right edge lands on the
             same line as the 해제 chips above it - a hand-picked margin was
             out by a few pixels and the column read as crooked. And it needs
             none of a menu item's behaviour: WPF wraps any non-MenuItem in a
             MenuItem container, so the whole row lit up on hover and promised
             a click that only the button actually accepts. -->
        <Style x:Key="MenuButtonRowStyle"
                TargetType="MenuItem">
            <Setter Property="Padding"
                    Value="{DynamicResource MenuItemPadding}"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="StaysOpenOnClick"
                    Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <!-- Follows the tree's font zoom (see ApplyLayoutMetrics), with a
                 roomier vertical base than the fixed 14,4 it replaces. That
                 tight value existed for HD-class (1366x768) displays; now that
                 padding scales with the font, a small screen is handled by
                 picking a smaller font rather than everyone getting the
                 cramped spacing. -->
            <Setter Property="Padding"
                    Value="{DynamicResource MenuItemPadding}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    TextBlock.Foreground="{DynamicResource MenuForeground}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Reserves no space for regular (non-checkable) items -
                                         Collapsed items don't participate in Auto-column sizing,
                                         so every existing menu keeps its current layout untouched.
                                         Checkable items (see the IsCheckable trigger) switch this
                                         to Hidden instead, so the check column's width is reserved
                                         even for their unchecked siblings and everything still lines
                                         up in a column. -->
                                    <Path x:Name="CheckMark"
                                            Grid.Column="0"
                                            Data="M1,4.5 L4,7.5 L9,1.5"
                                            Stroke="{DynamicResource MenuForeground}"
                                            StrokeThickness="1.4"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            Width="10"
                                            Height="8"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed"/>
                                    <ContentPresenter Grid.Column="1"
                                            ContentSource="Header"
                                            VerticalAlignment="Center"/>
                                    <TextBlock x:Name="GestureText"
                                            Grid.Column="2"
                                            Text="{TemplateBinding InputGestureText}"
                                            Foreground="{DynamicResource SecondaryForeground}"
                                            FontSize="{DynamicResource MenuGestureFontSize}"
                                            Margin="24,0,0,0"
                                            VerticalAlignment="Center"/>
                                    <!-- Submenu items (a MenuItem with child MenuItems, like the
                                         language picker) have no InputGestureText, so this shares
                                         the same column - only one of the two is ever visible. -->
                                    <Path x:Name="SubmenuArrow"
                                            Grid.Column="2"
                                            Data="M0,0 L4,4 L0,8"
                                            Stroke="{DynamicResource MenuForeground}"
                                            StrokeThickness="1.4"
                                            StrokeLineJoin="Round"
                                            StrokeStartLineCap="Round"
                                            StrokeEndLineCap="Round"
                                            Margin="24,0,2,0"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <!-- The part WPF's MenuItem logic actually looks for by name to host
                                 and position a submenu popup - the previous template omitted it
                                 entirely, so a MenuItem with children (Role=SubmenuHeader) had
                                 no way to ever show that submenu; clicking it just did nothing. -->
                            <Popup x:Name="PART_Popup"
                                    Placement="Right"
                                    HorizontalOffset="-12"
                                    VerticalOffset="-10"
                                    AllowsTransparency="True"
                                    Focusable="False"
                                    PopupAnimation="None"
                                    IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="{DynamicResource MenuPadding}"
                                        Margin="10"
                                        Effect="{DynamicResource MenuDropShadow}"
                                        SnapsToDevicePixels="True">
                                    <!-- Same omission, same fix as the
                                         ContextMenu template above - and this is
                                         the one that actually bit, since both
                                         long lists (숨긴 폴더 목록, 북마크 목록)
                                         are built as inline rows inside a
                                         SUBMENU. -->
                                    <ScrollViewer Style="{DynamicResource MenuScrollViewerStyle}">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- The chrome hover, not the tree's own selection
                                 colour. A menu draws its background and its
                                 text from the theme rather than the palette,
                                 and the bar under the pointer was the one part
                                 of it that followed the user's colours - so a
                                 vivid 선택된 항목 turned up in a place nothing
                                 else had answered to it, which read as a
                                 mistake rather than a setting (2026-08-04).
                                 The line is now drawn where it was already:
                                 menus are chrome, the tree is the palette.
                                 Its own brush, not the shared HoverBackground:
                                 that one is two points off the menu's own
                                 background and disappeared against it. -->
                            <Trigger Property="IsHighlighted"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource MenuHighlightBackground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="Bd"
                                        Property="TextBlock.Foreground"
                                        Value="{DynamicResource MenuDisabledForeground}"/>
                            </Trigger>
                            <Trigger Property="IsCheckable"
                                    Value="True">
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Hidden"/>
                            </Trigger>
                            <!-- Opt-in for NON-checkable items sitting among
                                 checkable siblings (options menu's "모든 펼친
                                 폴더 접기"): reserves the same check-column
                                 width they get, so the labels share one left
                                 edge at every font size - replacing a
                                 hardcoded-padding patch that broke when menu
                                 padding became font-scaled. -->
                            <Trigger Property="Tag"
                                    Value="reserve-check-column">
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role"
                                    Value="SubmenuHeader">
                                <Setter TargetName="GestureText"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                                <Setter TargetName="SubmenuArrow"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <!-- An empty GestureText still rendered as a
                                 0-wide TextBlock WITH its 24px left margin,
                                 silently docking that much off the content
                                 column of every gesture-less item - which is
                                 what pushed the (stretching) thumbnail slot
                                 visibly left of the menu's center. -->
                            <Trigger Property="InputGestureText"
                                    Value="">
                                <Setter TargetName="GestureText"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Used only by the "폴더의 표시 개수" stepper in OptionsMenu below - a
             plain TextBox there was very hard to actually type into: WPF's
             Menu manages keyboard/hover focus across its items on its own,
             and that fought with the TextBox for focus the moment the mouse
             drifted even slightly outside it. A pair of single-click +/-
             buttons sidesteps the whole problem - no sustained focus or
             precise mouse containment needed. -->
        <Style x:Key="MenuStepperButtonStyle"
                TargetType="Button">
            <!-- Follows the menu font (ApplyLayoutMetrics): the "+"/"−" inside
                 scales with it, and a fixed box stopped containing that glyph
                 once the font was zoomed up. -->
            <Setter Property="Width"
                    Value="{DynamicResource MenuStepperButtonSize}"/>
            <Setter Property="Height"
                    Value="{DynamicResource MenuStepperButtonSize}"/>
            <Setter Property="Background"
                    Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundText}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <!-- These two glyphs are the whole affordance - a hairline "+" at
                 a small font reads as decoration rather than a button. -->
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <!-- Margin, not alignment: see MenuStepperGlyphMargin
                                 in ApplyLayoutMetrics for why centring alone
                                 leaves these sitting low. -->
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="{DynamicResource MenuStepperGlyphMargin}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource ControlHoverBackground}"/>
                            </Trigger>
                            <!-- After the hover trigger so it wins for a
                                 disabled button. A stepper at its limit greys
                                 out that direction instead of staying lit and
                                 doing nothing when pressed. -->
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="Transparent"/>
                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.35"/>
                                <Setter Property="Cursor"
                                        Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A Separator placed inside a Menu/ContextMenu doesn't resolve a
             plain implicit `TargetType="Separator"` style at all - the
             ItemContainerGenerator looks it up via the specific
             MenuItem.SeparatorStyleKey resource key instead, so that's the
             key this has to be registered under to actually take effect.
             (That's also why the default two-tone "recessed groove" bevel -
             meant for light backgrounds - kept showing through as a stray
             bright/white line with its own baked-in margins no matter what
             we set on a plain Separator style.) -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
                TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <!-- Vertical margin 6 (was 4): group boundaries carry
                             the menu's breathing room now that per-row padding
                             plateaus at 6px - the VS Code rhythm the user
                             compared against (rows inside a group tight,
                             groups clearly parted). See ApplyLayoutMetrics. -->
                        <Border Height="1"
                                Background="{DynamicResource SeparatorBrush}"
                                Margin="2,5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Assigned to ExplorerTree itself (not via ItemContainerStyle, unlike
             ExplorerItemContextMenu below), so it's what shows up when
             right-clicking empty tree space rather than an actual row. -->
        <!-- Every menu in this file reports its open/closed state so auto-hide
             can stand down while one is up - a menu renders as its own window
             outside the sidebar's bounds, which both hide paths would otherwise
             read as "the user left". See MainWindow.xaml.cs's _openMenuCount. -->
        <!-- PreviewMouseRightButtonUp on every ContextMenu below: WPF invokes a
             menu item on right-button-release too while it sits inside a
             ContextMenu (Win32 heritage), which is how repeatedly right-clicking
             through image rows kept "just opening" a file - the second click
             landed on the freshly-opened menu (often its thumbnail row, a click
             target) instead of the row it covered. See
             ContextMenu_PreviewMouseRightButtonUp. -->
        <ContextMenu x:Key="ExplorerEmptySpaceContextMenu"
                Style="{StaticResource DarkContextMenuStyle}"
                Opened="AnyMenu_Opened"
                Closed="AnyMenu_Closed"
                PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp">
            <!-- The GLOBAL refresh - drive list plus every loaded folder -
                 which had no mouse path at all (requested 2026-08-09):
                 the row menu's 새로고침 needs a row and reads only that
                 folder. Explorer's empty-space menu leads with refresh too.
                 No F5 gesture text on purpose - F5 is the row refresh. -->
            <MenuItem Header="{x:Static services:Strings.MenuRefresh}"
                    Click="RefreshAll_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.MenuNewFolder}"
                    InputGestureText="F7"
                    Click="NewFolder_Click"/>
            <Separator/>
            <!-- The three view lists, reachable without a row to right-click -
                 which is the whole point of this menu (2026-08-02). 북마크 has no
                 "add" here: adding bookmarks the row under the cursor, and out
                 here there is no row. The jumps and the two lists need none.

                 All three are built on open by the same handlers the options
                 menu and the row menu use, so there is one implementation of
                 each no matter which menu it was opened from. -->
            <MenuItem Header="{x:Static services:Strings.MenuBookmark}"
                    AutomationProperties.AutomationId="emptyBookmark"
                    SubmenuOpened="EmptySpaceBookmarkSubmenu_Opened">
                <MenuItem Header=""/>
            </MenuItem>
            <MenuItem Header="{x:Static services:Strings.MenuHiddenFolderList}"
                    SubmenuOpened="HiddenFolderSubmenu_Opened">
                <MenuItem Header=""/>
            </MenuItem>
            <MenuItem Header="{x:Static services:Strings.MenuFileFilter}"
                    SubmenuOpened="FileFilterSubmenu_Opened">
                <MenuItem Header=""/>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="ExplorerItemContextMenu"
                Style="{StaticResource DarkContextMenuStyle}"
                Opened="ExplorerItemContextMenu_Opened"
                Closed="AnyMenu_Closed"
                PreviewKeyDown="ExplorerItemContextMenu_PreviewKeyDown"
                PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp"
                PreviewMouseRightButtonDown="ExplorerItemContextMenu_PreviewMouseRightButtonDown">
            <!-- Image thumbnail (single image file only): the slot is reserved
                 at its fixed size the moment the menu opens - we already know
                 from the extension whether this row gets one - so the async
                 arrival of the actual picture never reflows the open menu.
                 Clicking it opens the picture in the VIEWER (see
                 ThumbnailMenuItem_Click) - the thumbnail is the image, so
                 "bigger, here" is what a click on it reads as, and the
                 default app is still one Enter or double-click away. This
                 replaced a "뷰어에서 보기" row that said the same thing in
                 words directly under the picture (2026-08-09).
                 THIS ITEM AND THE SEPARATOR BELOW MUST STAY THE MENU'S FIRST
                 TWO - TreeViewItem_PreviewMouseRightButtonDown matches them
                 positionally (`menu.Items is [MenuItem, Separator, ..]`).
                 Everything after them is found by Tag and can move freely. -->
            <MenuItem Visibility="Collapsed"
                    Tag="thumbnail"
                    Click="ThumbnailMenuItem_Click">
                <MenuItem.Header>
                    <StackPanel>
                        <!-- No fixed Width: the slot stretches to the menu's own
                             content width (whatever the widest text item makes
                             it), with the sized value kept only as a floor so a
                             very narrow menu can't crush the preview. The image
                             letterboxes centered inside (Uniform). -->
                        <!-- Transparent, not the ControlBackground plate it
                             first shipped with: the plate showed as a lighter
                             rounded box around letterboxed images, and the
                             user preferred the picture floating directly on
                             the menu. Transparent (not null) keeps the whole
                             slot clickable. -->
                        <Border MinWidth="{DynamicResource MenuThumbnailWidth}"
                                MaxWidth="{DynamicResource MenuThumbnailMaxWidth}"
                                Height="{DynamicResource MenuThumbnailHeight}"
                                Background="Transparent"
                                Padding="3">
                            <!-- The Image's Width/Height are BOUND to the host
                                 grid rather than left natural: an Image reports
                                 its picture's full natural size during measure,
                                 and since the picture arrives asynchronously
                                 AFTER the menu has laid out, a wide image was
                                 re-measuring - and visibly widening - the whole
                                 open menu the moment it loaded. Bound to the
                                 slot, the image can never influence the menu's
                                 size in either direction; the slot just follows
                                 the width the other items give the menu.
                                 DownOnly still applies within that box: a source
                                 smaller than the slot (an .ico, a tiny image)
                                 shows at its natural size, sharp and centered,
                                 instead of being blown up blurry. -->
                            <Grid>
                                <Image Stretch="Uniform"
                                        StretchDirection="DownOnly"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <!-- Format · pixel size · file size on the first line,
                             modified date on the second, set by
                             UpdateThumbnailRow. One font step below the menu's
                             own size (MenuThumbnailInfoFontSize) - metadata,
                             not a menu item. Foreground explicit: property
                             inheritance from the template's Bd border doesn't
                             reliably reach an explicit TextBlock in Header
                             content (it rendered near-black), so the menu
                             text brush is named outright. -->
                        <TextBlock Foreground="{DynamicResource MenuForeground}"
                                FontSize="{DynamicResource MenuThumbnailInfoFontSize}"
                                HorizontalAlignment="Center"
                                Margin="0,3,0,0"/>
                        <TextBlock Foreground="{DynamicResource MenuForeground}"
                                FontSize="{DynamicResource MenuThumbnailInfoFontSize}"
                                HorizontalAlignment="Center"
                                Margin="0,1,0,0"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <Separator Visibility="Collapsed" Tag="thumbnailSep"/>
            <!-- Multi-selection header row ("N개 항목 선택됨"): shown, with its
                 separator, only while a Ctrl/Shift-click multi-selection is
                 active - text and visibility both set on every open by
                 ExplorerItemContextMenu_Opened, which finds items by POSITION
                 (see its comment), so adding/removing/reordering anything here
                 means updating that handler's list pattern too.
                 The header is a TextBlock with its own Foreground rather than
                 a plain string: the menu style's IsEnabled=False trigger greys
                 items via an INHERITED TextBlock.Foreground, and a local value
                 on the TextBlock outranks that - so this row stays accented
                 while still being unclickable. -->
            <MenuItem IsEnabled="False"
                    Tag="multiInfo"
                    Visibility="Collapsed">
                <MenuItem.Header>
                    <TextBlock FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentForeground}"/>
                </MenuItem.Header>
            </MenuItem>
            <Separator Visibility="Collapsed" Tag="multiInfoSep"/>
            <MenuItem Header="{x:Static services:Strings.MenuAddFavorite}"
                    Tag="addFavorite"
                    Click="AddFavorite_Click"/>
            <!-- A submenu rather than the single toggle it used to be
                 (requested 2026-07-30, from a relayed enquiry): setting one was the
                 only bookmark action reachable by mouse, so the jumps existed
                 only for whoever found the shortcuts, and the options menu's
                 list looked like the whole feature. The first item's header
                 still swaps 추가/해제 per the target row (see
                 ExplorerItemContextMenu_Opened), which also enables the two
                 jumps only while there is somewhere to jump to. -->
            <MenuItem Header="{x:Static services:Strings.MenuBookmark}"
                    SubmenuOpened="BookmarkRowSubmenu_Opened">
                <!-- The bookmarks themselves are appended below these three as
                     the submenu opens (AppendBookmarkListTo) - tags, because
                     that makes this list's length variable. -->
                <MenuItem Header="{x:Static services:Strings.MenuBookmarkAdd}"
                        Tag="bookmarkToggle"
                        InputGestureText="Ctrl+Alt+K"
                        Click="BookmarkMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.BookmarkShortcutPrev}"
                        Tag="bookmarkPrev"
                        InputGestureText="Ctrl+Alt+J"
                        Click="BookmarkPrev_Click"/>
                <MenuItem Header="{x:Static services:Strings.BookmarkShortcutNext}"
                        Tag="bookmarkNext"
                        InputGestureText="Ctrl+Alt+L"
                        Click="BookmarkNext_Click"/>
            </MenuItem>
            <!-- Takes the folder out of the tree; the list below it is how it
                 comes back, so the two are one feature and sit together. Only
                 the tree hides it - the file search still finds what is inside
                 (see AppSettings.HiddenFolderPaths). Enabled per row in
                 ExplorerItemContextMenu_Opened: folders only. -->
            <MenuItem Header="{x:Static services:Strings.MenuHideFolder}"
                    Tag="hideFolder"
                    Click="HideFolder_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuHiddenFolderList}"
                    Tag="hiddenFolderList"
                    SubmenuOpened="HiddenFolderSubmenu_Opened">
                <!-- Placeholder so WPF gives this item a submenu at all; the
                     real rows replace it on open (AppendHiddenFolderListTo). -->
                <MenuItem Header=""/>
            </MenuItem>
            <!-- Global, not about the row under the cursor - but this is the
                 menu the hand is already in when a folder turns out to be full
                 of files you did not want to see (requested 2026-08-02).
                 Same submenu the options menu and the empty-space menu open. -->
            <MenuItem Header="{x:Static services:Strings.MenuFileFilter}"
                    Tag="fileFilter"
                    SubmenuOpened="FileFilterSubmenu_Opened">
                <MenuItem Header=""/>
            </MenuItem>
            <!-- Sort closes this group rather than sitting among the folder
                 actions below: which order a folder's rows come in is a
                 question about how this sidebar presents it, exactly like the
                 four above (2026-08-02 regrouping - see the note at the top of
                 this menu). -->
            <MenuItem Header="{x:Static services:Strings.MenuSort}" Tag="sort">
                <MenuItem Header="{x:Static services:Strings.MenuSortByName}"
                        IsCheckable="True"
                        Tag="name"
                        Click="FolderSortFieldMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuSortByDate}"
                        IsCheckable="True"
                        Tag="date"
                        Click="FolderSortFieldMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuSortByType}"
                        IsCheckable="True"
                        Tag="type"
                        Click="FolderSortFieldMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuSortBySize}"
                        IsCheckable="True"
                        Tag="size"
                        Click="FolderSortFieldMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="{x:Static services:Strings.MenuSortAscending}"
                        IsCheckable="True"
                        Tag="asc"
                        Click="FolderSortDirectionMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuSortDescending}"
                        IsCheckable="True"
                        Tag="desc"
                        Click="FolderSortDirectionMenuItem_Click"/>
                <Separator/>
                <!-- Only enabled when the selected folder actually has its own
                     override (see ExplorerItemContextMenu_Opened) - clears it,
                     same action as clicking the folder's own override icon. -->
                <MenuItem Header="{x:Static services:Strings.MenuFollowDefaultSort}"
                        Click="FolderSortFollowGlobalMenuItem_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.MenuOpen}"
                    InputGestureText="Enter"
                    Click="OpenItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuOpenWith}"
                    Tag="openWith"
                    Click="OpenWithPicker_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.MenuCut}"
                    InputGestureText="Ctrl+X"
                    Click="CutItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuCopy}"
                    InputGestureText="Ctrl+C"
                    Click="CopyItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuPaste}"
                    InputGestureText="Ctrl+V"
                    Click="PasteItem_Click"/>
            <!-- Next to paste, because both make something new in this folder.
                 It used to lead the folder group further up. -->
            <MenuItem Header="{x:Static services:Strings.MenuNewFolder}"
                    Tag="newFolder"
                    InputGestureText="F7"
                    Click="NewFolder_Click"/>
            <!-- 압축 sits with paste rather than in a group of its own: it
                 makes a new file out of the selection, same as paste does, and
                 an extra separator costs every right-click height the menu was
                 deliberately squeezed to save. 압축 풀기 is Collapsed unless the
                 row IS a .zip (ExplorerItemContextMenu_Opened) for the same
                 reason - a permanently-dead row would tax every other menu. -->
            <MenuItem Header="{x:Static services:Strings.MenuCompress}"
                    Tag="compress"
                    Click="CompressItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuExtract}"
                    Tag="extract"
                    Visibility="Collapsed"
                    Click="ExtractItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuRename}"
                    Tag="rename"
                    InputGestureText="F2"
                    Click="RenameItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuDelete}"
                    InputGestureText="Del"
                    Click="DeleteItem_Click"/>
            <!-- Closes the group that changes this folder: re-reading it from
                 disk is what you reach for after doing any of the above (or
                 after something outside the app did). It led the folder group
                 up top until 2026-08-02. -->
            <MenuItem Header="{x:Static services:Strings.MenuRefresh}"
                    Tag="refresh"
                    InputGestureText="F5"
                    Click="RefreshFolder_Click"/>
            <Separator/>
            <!-- Heads the "take this location somewhere else" group - the
                 others hand it to the clipboard, a terminal, an editor or
                 Explorer; this one hands it to the app's own search view. Its
                 point is unchanged: the user is already looking at the folder
                 they want to search, so reaching for the search view's own
                 folder picker would mean browsing back to it. -->
            <MenuItem Header="{x:Static services:Strings.MenuSearchInFolder}"
                    Tag="searchInFolder"
                    Click="SearchInFolder_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuCopyPath}"
                    Tag="copyPath"
                    InputGestureText="Ctrl+Shift+C"
                    Click="CopyPath_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuOpenTerminal}"
                    Click="OpenTerminal_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuOpenWithCode}"
                    Tag="openWithCode"
                    Click="OpenWithCode_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuRevealInExplorer}"
                    Click="RevealInExplorer_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.MenuProperties}"
                    Click="ShowProperties_Click"/>
        </ContextMenu>

        <!-- What the row's sort icon opens. Same items, same handlers and same
             target (the selected folder) as the "정렬 기준" submenu in the
             right-click menu above - shown from a second place because the
             icon is right there on the row, and reaching the submenu means
             opening a menu and then walking into it. Kept flat for that
             reason: one click to the icon, one to the order. -->
        <!-- The TRAY icon's menu. It lived in WinForms until now (NotifyIcon's
             ContextMenuStrip), which is why it was the one surface in the app
             wearing the system's own look while everything else followed the
             theme, which left it the odd one out (2026-08-11). Declared here rather
             than built in App.xaml.cs so it takes DarkContextMenuStyle, the
             theme brushes and MenuFontSize like every other menu, including
             following Ctrl +/-.
             The rows match what the ContextMenuStrip carried; the update row is
             collapsed until there is something to announce, and the toggle's
             label is rewritten each time it opens (the window can be shown or
             hidden by other means in between). -->
        <ContextMenu x:Key="TrayContextMenu"
                Style="{StaticResource DarkContextMenuStyle}"
                Opened="AnyMenu_Opened"
                Closed="AnyMenu_Closed"
                PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp">
            <!-- Addressed by AutomationId, never by position and never by
                 x:Name: a MenuItem declared in a resource dictionary gets no
                 code-behind field, and positional matching has broken two
                 menus in this app already (see OptionsMenu_Opened). -->
            <MenuItem AutomationProperties.AutomationId="trayUpdate"
                    Visibility="Collapsed"
                    Click="TrayUpdateMenuItem_Click"/>
            <Separator AutomationProperties.AutomationId="trayUpdateSeparator"
                    Visibility="Collapsed"/>
            <MenuItem AutomationProperties.AutomationId="trayToggle"
                    Click="TrayToggleMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.TrayAbout}"
                    Click="TrayAboutMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.TrayExit}"
                    Click="TrayExitMenuItem_Click"/>
        </ContextMenu>

        <!-- The header's own menu, and the reason it exists: the X stopped
             ending the app (2026-08-10), which left the tray icon as the only
             way to quit - and the tray icon is optional. A title bar answering
             a right-click with 종료 is the oldest convention there is, and it
             costs no pixels in a strip that has none to give.
             Deliberately short. This is not a second options menu; it is the
             window's own verbs, and 종료 is the one that had nowhere else to
             live.
             도움말 joined it 2026-08-11 instead of taking a header BUTTON, which
             was considered and turned down: the header is for what gets used
             daily, help is opened once or twice in a lifetime, and a seventh
             button there means moving the three width thresholds and the grid
             again - which has already gone wrong twice. It leads the menu, and
             sits behind a separator from the three that act on the app, because
             it is the only row here that does not change anything. -->
        <ContextMenu x:Key="HeaderContextMenu"
                Style="{StaticResource DarkContextMenuStyle}"
                Opened="HeaderContextMenu_Opened"
                Closed="AnyMenu_Closed"
                PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp">
            <!-- THE PRESETS GO ABOVE THIS LINE, inserted in code every time the
                 menu opens (see BuildPresetMenu). They were behind a 프리셋
                 parent item until 2026-08-11; opening this menu to switch the
                 whole app's shape is the common reason to open it at all, so
                 the rows now start where the eye does.

                 This separator is the ANCHOR the insert works against, which is
                 why it carries a Tag: everything above it belongs to the
                 presets and is replaced wholesale on each open. Found by Tag
                 rather than by position - addressing a menu by index has broken
                 two menus in this app already. -->
            <Separator Tag="presets"/>
            <MenuItem Header="{x:Static services:Strings.MenuHelp}"
                    InputGestureText="F1"
                    Click="HelpMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.ToolTipMinimize}"
                    Click="MinimizeButton_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuRestart}"
                    Click="RestartMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.TrayExit}"
                    Click="ExitAppMenuItem_Click"/>
        </ContextMenu>

        <ContextMenu x:Key="FolderSortContextMenu"
                Style="{StaticResource DarkContextMenuStyle}"
                Opened="FolderSortContextMenu_Opened"
                Closed="AnyMenu_Closed"
                PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp">
            <MenuItem Header="{x:Static services:Strings.MenuSortByName}"
                    IsCheckable="True"
                    Tag="name"
                    Click="FolderSortFieldMenuItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuSortByDate}"
                    IsCheckable="True"
                    Tag="date"
                    Click="FolderSortFieldMenuItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuSortByType}"
                    IsCheckable="True"
                    Tag="type"
                    Click="FolderSortFieldMenuItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuSortBySize}"
                    IsCheckable="True"
                    Tag="size"
                    Click="FolderSortFieldMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.MenuSortAscending}"
                    IsCheckable="True"
                    Tag="asc"
                    Click="FolderSortDirectionMenuItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuSortDescending}"
                    IsCheckable="True"
                    Tag="desc"
                    Click="FolderSortDirectionMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.MenuFollowDefaultSort}"
                    Click="FolderSortFollowGlobalMenuItem_Click"/>
        </ContextMenu>

        <!-- What happens when a file finishes playing. Four states rather than
             a switch plus a mode, because they are mutually exclusive answers
             to one question and a checkmark can say which one is in force.

             On the BUTTON rather than on the picture: right-clicking the
             picture already opens the file's own menu, and this is a property
             of the transport, not of the file. -->
        <ContextMenu x:Key="ViewerRepeatContextMenu"
                Style="{StaticResource DarkContextMenuStyle}"
                Opened="ViewerRepeatContextMenu_Opened"
                Closed="AnyMenu_Closed"
                PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp">
            <MenuItem Header="{x:Static services:Strings.ViewerRepeatOff}"
                    IsCheckable="True"
                    Tag="off"
                    Click="ViewerRepeatMenuItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.ViewerRepeatAll}"
                    IsCheckable="True"
                    Tag="all"
                    Click="ViewerRepeatMenuItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.ViewerRepeatOne}"
                    IsCheckable="True"
                    Tag="one"
                    Click="ViewerRepeatMenuItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.ViewerRepeatShuffle}"
                    IsCheckable="True"
                    Tag="shuffle"
                    Click="ViewerRepeatMenuItem_Click"/>
        </ContextMenu>

        <!-- The search results' own sort menu. Deliberately NOT the folder menu
             above: these are different states over a different list - a flat
             result set has no 유형/크기 to sort by, and it has 폴더 그룹 which no
             folder does. Direction doesn't apply to that grouping, so those two
             rows grey out while it's chosen (SearchSortContextMenu_Opened). -->
        <ContextMenu x:Key="SearchSortContextMenu"
                Style="{StaticResource DarkContextMenuStyle}"
                Opened="SearchSortContextMenu_Opened"
                Closed="AnyMenu_Closed"
                PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp">
            <MenuItem Header="{x:Static services:Strings.SortModeFolderGroup}"
                    IsCheckable="True"
                    Tag="group"
                    Click="SearchSortFieldMenuItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuSortByName}"
                    IsCheckable="True"
                    Tag="name"
                    Click="SearchSortFieldMenuItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuSortByDate}"
                    IsCheckable="True"
                    Tag="date"
                    Click="SearchSortFieldMenuItem_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.MenuSortAscending}"
                    IsCheckable="True"
                    Tag="asc"
                    Click="SearchSortDirectionMenuItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuSortDescending}"
                    IsCheckable="True"
                    Tag="desc"
                    Click="SearchSortDirectionMenuItem_Click"/>
        </ContextMenu>

        <!-- Search result rows' own menu. Every action operates on the
             right-clicked result's path (SearchEntry.FullPath) via the same
             ShellFileService/FileOperationService the tree menu uses - no
             FileSystemItem needed. The tree-only items (즐겨찾기/새 폴더/붙여넣기/
             정렬/이름 바꾸기) are intentionally absent: they don't apply to a
             file-only search result. -->
        <ContextMenu x:Key="SearchResultContextMenu"
                Style="{StaticResource DarkContextMenuStyle}"
                Opened="SearchResultContextMenu_Opened"
                Closed="AnyMenu_Closed"
                PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp"
                PreviewMouseRightButtonDown="SearchResultContextMenu_PreviewMouseRightButtonDown">
            <!-- Same image-thumbnail slot as the tree menu's (same reserved-
                 before-open rules; configured by
                 SearchResultsList_PreviewMouseRightButtonDown, positional
                 pattern in SearchResultContextMenu_Opened - keep in sync).
                 Clicking opens the file, like the row itself. -->
            <MenuItem Visibility="Collapsed"
                    Tag="thumbnail"
                    Click="SearchOpen_Click">
                <MenuItem.Header>
                    <StackPanel>
                        <Border MinWidth="{DynamicResource MenuThumbnailWidth}"
                                MaxWidth="{DynamicResource MenuThumbnailMaxWidth}"
                                Height="{DynamicResource MenuThumbnailHeight}"
                                Background="Transparent"
                                Padding="3">
                            <Grid>
                                <Image Stretch="Uniform"
                                        StretchDirection="DownOnly"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <TextBlock Foreground="{DynamicResource MenuForeground}"
                                FontSize="{DynamicResource MenuThumbnailInfoFontSize}"
                                HorizontalAlignment="Center"
                                Margin="0,3,0,0"/>
                        <TextBlock Foreground="{DynamicResource MenuForeground}"
                                FontSize="{DynamicResource MenuThumbnailInfoFontSize}"
                                HorizontalAlignment="Center"
                                Margin="0,1,0,0"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <Separator Visibility="Collapsed" Tag="thumbnailSep"/>
            <!-- Groups mirror the tree menu's taxonomy (open / edit /
                 path-and-tools / properties) so the same action always lives
                 in the same group in both menus - the items the search view
                 doesn't have are simply absent, but nothing is REGROUPED. -->
            <MenuItem Header="{x:Static services:Strings.MenuOpen}"
                    Click="SearchOpen_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuOpenWith}"
                    Click="SearchOpenWith_Click"/>
            <!-- The row's own double click, written down: a single click now
                 previews into the panel without closing the list, so the trip
                 to the tree needs somewhere to be read off. The gesture is
                 named here because a label is what teaches one. -->
            <MenuItem Header="{x:Static services:Strings.MenuRevealInTree}"
                    InputGestureText="{x:Static services:Strings.GestureDoubleClick}"
                    Click="SearchRevealInTree_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.MenuCut}"
                    InputGestureText="Ctrl+X"
                    Click="SearchCut_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuCopy}"
                    InputGestureText="Ctrl+C"
                    Click="SearchCopy_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuDelete}"
                    InputGestureText="Del"
                    Click="SearchDelete_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.MenuCopyPath}"
                    InputGestureText="Ctrl+Shift+C"
                    Click="SearchCopyPath_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuOpenTerminal}"
                    Click="SearchOpenTerminal_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuOpenWithCode}"
                    Tag="openWithCode"
                    Click="SearchOpenWithCode_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuRevealInExplorer}"
                    Click="SearchReveal_Click"/>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.MenuProperties}"
                    Click="SearchProperties_Click"/>
        </ContextMenu>

        <ContextMenu x:Key="OptionsMenu"
                Style="{StaticResource DarkContextMenuStyle}"
                Opened="OptionsMenu_Opened"
                Closed="AnyMenu_Closed"
                PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp">
            <!-- One-shot cleanup, unlike the title bar's collapse button (which
                 is a toggle that remembers what was expanded and can restore
                 it). Disabled while nothing is expanded - see
                 OptionsMenu_Opened. -->
            <!-- No reserve-check-column here anymore: the top level lost its
                 last checkable row when the toggles moved into 기본 설정
                 (2026-08-08), so there is no check column left to line up
                 with - reserving one now would indent this row past every
                 neighbour instead. Same for the two submenu rows below. -->
            <MenuItem Header="{x:Static services:Strings.MenuCollapseAllExpanded}"
                    AutomationProperties.AutomationId="collapseAllExpanded"
                    Click="CollapseAllExpandedMenuItem_Click"/>
            <!-- Every toggle the menu has lives in here now (2026-08-08, three
                 rounds the same day: first the set-once housekeeping, then
                 always-on-top and the auto-hide pair, and finally the daily
                 three - so the top level carries no checkable row at all and
                 every remaining row shares one left edge with the sections
                 below). Separators split it window / appearance / behavior.
                 Checked state is set on THIS submenu's children in
                 OptionsMenu_Opened - FindMenuItem only looks at direct
                 children, and leaving a moved id in the outer chain would
                 fail the whole match silently (the v1.3.4/v1.4.0 breakage
                 shape - see the 패널 표시 note there). -->
            <MenuItem Header="{x:Static services:Strings.MenuGeneralSettings}"
                    AutomationProperties.AutomationId="generalSettings">
                <MenuItem Header="{x:Static services:Strings.MenuAlwaysOnTop}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="alwaysOnTop"
                        Click="AlwaysOnTopMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuDockOnRight}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="dockOnRight"
                        Click="DockOnRightMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuStartWithWindows}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="startWithWindows"
                        Click="StartWithWindowsMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuAlwaysShowTrayIcon}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="trayIcon"
                        Click="TrayIconMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="{x:Static services:Strings.MenuShowFolderIcons}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="showFolderIcons"
                        Click="ShowFolderIconsMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuShowFileIcons}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="showFileIcons"
                        Click="ShowFileIconsMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuHideTitleBarTitle}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="hideTitleBarTitle"
                        Click="HideTitleBarTitleMenuItem_Click"/>
                <!-- Beside the two icon toggles because it answers the same kind
                     of question - what the window DRAWS - rather than what it
                     does. The colour rows for the line stay in 색상 설정; this is
                     whether there is a line to colour. -->
                <MenuItem Header="{x:Static services:Strings.MenuShowPanelDividers}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="showPanelDividers"
                        Click="ShowPanelDividersMenuItem_Click"/>
                <!-- 경로 표시줄's toggle was here and is GONE (2026-08-11). The
                     strip stopped being a display of where you are the moment it
                     grew the history chevrons: turning it off took a way of
                     MOVING with it, and an option that can hide a feature is not
                     an option, it is a way to lose one. Always on now. -->
                <Separator/>
                <MenuItem Header="{x:Static services:Strings.MenuAutoCollapse}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="autoCollapse"
                        Click="AutoCollapseMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuAutoHideCloseOnLeave}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="autoHideCloseOnLeave"
                        Click="AutoHideCloseOnLeaveMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuAutoHideUseHandle}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="autoHideUseHandle"
                        Click="AutoHideUseHandleMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuAutoHideSlide}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="autoHideSlide"
                        Click="AutoHideSlideMenuItem_Click"/>
            </MenuItem>
            <!-- The viewer's own settings, in their own group. These two do not
                 change what the tree draws, which is what everything above is
                 about - they are about the pictures and what is kept on disk for
                 them. -->
            <MenuItem Header="{x:Static services:Strings.MenuImageViewer}"
                    AutomationProperties.AutomationId="imageViewer">
                <MenuItem Header="{x:Static services:Strings.MenuPrecacheThumbnails}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="precacheThumbnails"
                        Click="PrecacheThumbnailsMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuClearThumbnailCache}"
                        AutomationProperties.AutomationId="clearThumbnailCache"
                        Click="ClearThumbnailCacheMenuItem_Click"/>
            </MenuItem>
            <!-- Everything about the panel beside the tree in one place: WHAT
                 it shows, then - past a separator - WHERE it sits. The
                 position toggle used to be a row of its own out on the menu,
                 named after favorites; folding it in both drops a line and
                 stops the name lying now that the panel can hold either list
                 (2026-08-02).

                 Three states rather than a favorites on/off toggle: the panel
                 only used to disappear when the favorites list was EMPTY, so
                 giving that row back to the tree meant deleting entries.
                 Checkable so exactly one mode reads as current;
                 OptionsMenu_Opened sets which.

                 Last in the group, directly above the separator: what follows
                 is the bookmark and hidden-folder lists, which is where
                 someone lands next after choosing what the panel shows
                 (2026-08-04). -->
            <MenuItem Header="{x:Static services:Strings.MenuSidePanel}"
                    AutomationProperties.AutomationId="sidePanel">
                <MenuItem Header="{x:Static services:Strings.MenuSidePanelFavorites}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="sidePanelFavorites"
                        Click="SidePanelModeMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuSidePanelBookmarks}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="sidePanelBookmarks"
                        Click="SidePanelModeMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuSidePanelNone}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="sidePanelNone"
                        Click="SidePanelModeMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="{x:Static services:Strings.MenuFavoritesAtBottom}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="favoritesAtBottom"
                        Click="FavoritesAtBottomMenuItem_Click"/>
            </MenuItem>
            <Separator/>
            <!-- Contents are built in code on every open (RebuildBookmarkListMenu)
                 - the list is the user's own bookmarks, so there is nothing to
                 declare here. Sits inside the separators with 색상 설정 rather
                 than up among the toggles: like that one it opens something of
                 its own rather than flipping a setting. -->
            <MenuItem Header="{x:Static services:Strings.MenuBookmarkList}"
                    AutomationProperties.AutomationId="bookmarkList"/>
            <!-- Same shape as the bookmark list above and built the same way -
                 the row context menu carries one too, but this is where someone
                 looks who no longer has the folder's row to right-click. -->
            <MenuItem Header="{x:Static services:Strings.MenuHiddenFolderList}"
                    AutomationProperties.AutomationId="hiddenFolderList"
                    SubmenuOpened="HiddenFolderSubmenu_Opened">
                <MenuItem Header=""/>
            </MenuItem>
            <!-- Which file kinds the tree lists. "전체" sits apart above the
                 separator because it is not a category - it is the empty
                 selection, so it reads as a radio against the rest while the
                 rest multi-select. StaysOpenOnClick throughout: picking three
                 kinds should be three clicks, not three trips back into the
                 menu. -->
            <MenuItem Header="{x:Static services:Strings.MenuFileFilter}"
                    AutomationProperties.AutomationId="fileFilter"
                    SubmenuOpened="FileFilterSubmenu_Opened">
                <!-- Placeholder so WPF gives this item a submenu at all; the
                     real rows replace it on open (FileFilterSubmenu_Opened).
                     Built rather than declared because the same submenu hangs
                     off three different menus - see that handler. -->
                <MenuItem Header=""/>
            </MenuItem>
            <Separator/>
            <!-- Fenced off by separators on both sides: it opens a window,
                 unlike everything around it, so it belongs to neither the
                 toggles above nor the steppers below. -->
            <MenuItem Header="{x:Static services:Strings.MenuColorSettings}"
                    Click="ColorSettingsMenuItem_Click"/>
            <Separator/>
            <!-- Directly above the font SIZE row, not off on its own among the
                 checkboxes (2026-08-02): the two are the same
                 question asked twice, and a reader looking for one will look
                 where the other is.

                 "폴더만 굵게" earns its place as more than a compromise - it
                 makes the structure readable without thickening every file name
                 in the tree. -->
            <MenuItem Header="{x:Static services:Strings.MenuFontWeight}"
                    AutomationProperties.AutomationId="fontWeight">
                <MenuItem Header="{x:Static services:Strings.MenuFontWeightNormal}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="fontWeightNormal"
                        Click="FontWeightMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuFontWeightBold}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="fontWeightBold"
                        Click="FontWeightMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuFontWeightFoldersOnly}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="fontWeightFolders"
                        Click="FontWeightMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuFontWeightFilesOnly}"
                        IsCheckable="True"
                        AutomationProperties.AutomationId="fontWeightFiles"
                        Click="FontWeightMenuItem_Click"/>
            </MenuItem>
            <!-- Font size leads the stepper group deliberately: it was
                 keyboard-only (Ctrl +/-) until a user with presbyopia asked for
                 "a way to change the font size" while row/indent spacing were
                 both sitting right here in the menu. Someone who finds text
                 hard to read looks in the settings menu, not a shortcut list -
                 so the row carries the shortcut in its own label too. -->
            <!-- MenuStepperRowPadding on every stepper row (this one and the
                 five below): the +/- buttons stand taller than a text line, so
                 under the shared MenuItemPadding these rows broke the menu's
                 row rhythm - see ApplyLayoutMetrics for the arithmetic. -->
            <MenuItem StaysOpenOnClick="True"
                    Focusable="False"
                    Padding="{DynamicResource MenuStepperRowPadding}"
                    AutomationProperties.AutomationId="fontSizeRow">
                <MenuItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                Text="{x:Static services:Strings.MenuFontSize}"
                                Foreground="{DynamicResource MenuForeground}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                            <Button Content="−"
                                    Style="{StaticResource MenuStepperButtonStyle}"
                                    Click="FontSizeDecrement_Click"/>
                            <TextBlock Text="12"
                                    Foreground="{DynamicResource MenuForeground}"
                                    Width="26"
                                    TextAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Button Content="+"
                                    Style="{StaticResource MenuStepperButtonStyle}"
                                    Click="FontSizeIncrement_Click"/>
                        </StackPanel>
                    </Grid>
                </MenuItem.Header>
            </MenuItem>
            <!-- StaysOpenOnClick so stepping the value doesn't close the whole
                 options menu out from under the user. -->
            <MenuItem StaysOpenOnClick="True"
                    Focusable="False"
                    Padding="{DynamicResource MenuStepperRowPadding}"
                    AutomationProperties.AutomationId="maxItemsRow">
                <MenuItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                Text="{x:Static services:Strings.MenuMaxItemsPerFolder}"
                                Foreground="{DynamicResource MenuForeground}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                            <Button Content="−"
                                    Style="{StaticResource MenuStepperButtonStyle}"
                                    Click="MaxItemsPerFolderDecrement_Click"/>
                            <TextBlock Text="25"
                                    Foreground="{DynamicResource MenuForeground}"
                                    Width="26"
                                    TextAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Button Content="+"
                                    Style="{StaticResource MenuStepperButtonStyle}"
                                    Click="MaxItemsPerFolderIncrement_Click"/>
                        </StackPanel>
                    </Grid>
                </MenuItem.Header>
            </MenuItem>
            <!-- StaysOpenOnClick so stepping the value doesn't close the whole
                 options menu out from under the user. -->
            <MenuItem StaysOpenOnClick="True"
                    Focusable="False"
                    Padding="{DynamicResource MenuStepperRowPadding}"
                    AutomationProperties.AutomationId="tabSpacingRow">
                <MenuItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                Text="{x:Static services:Strings.MenuTabSpacing}"
                                Foreground="{DynamicResource MenuForeground}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                            <Button Content="−"
                                    Style="{StaticResource MenuStepperButtonStyle}"
                                    Click="TabSpacingDecrement_Click"/>
                            <TextBlock Text="16"
                                    Foreground="{DynamicResource MenuForeground}"
                                    Width="26"
                                    TextAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Button Content="+"
                                    Style="{StaticResource MenuStepperButtonStyle}"
                                    Click="TabSpacingIncrement_Click"/>
                        </StackPanel>
                    </Grid>
                </MenuItem.Header>
            </MenuItem>
            <!-- StaysOpenOnClick so stepping the value doesn't close the whole
                 options menu out from under the user. -->
            <MenuItem StaysOpenOnClick="True"
                    Focusable="False"
                    Padding="{DynamicResource MenuStepperRowPadding}"
                    AutomationProperties.AutomationId="rowSpacingRow">
                <MenuItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                Text="{x:Static services:Strings.MenuRowSpacing}"
                                Foreground="{DynamicResource MenuForeground}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                            <Button Content="−"
                                    Style="{StaticResource MenuStepperButtonStyle}"
                                    Click="RowSpacingDecrement_Click"/>
                            <TextBlock Text="0"
                                    Foreground="{DynamicResource MenuForeground}"
                                    Width="26"
                                    TextAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Button Content="+"
                                    Style="{StaticResource MenuStepperButtonStyle}"
                                    Click="RowSpacingIncrement_Click"/>
                        </StackPanel>
                    </Grid>
                </MenuItem.Header>
            </MenuItem>
            <!-- Sits with the other steppers rather than up among the
                 checkboxes, where it was the one row of its kind and read as
                 stranded. It is an auto-hide setting, so grouping by topic
                 would put it beside "마우스 이탈 시 닫기" - but a menu is read by
                 shape first, and a lone stepper among checkmarks looks like a
                 mistake. -->
            <MenuItem StaysOpenOnClick="True"
                    Focusable="False"
                    Padding="{DynamicResource MenuStepperRowPadding}"
                    AutomationProperties.AutomationId="autoHideSliverWidthRow">
                <MenuItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                Text="{x:Static services:Strings.MenuAutoHideSliverWidth}"
                                Foreground="{DynamicResource MenuForeground}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                            <Button Content="−"
                                    Style="{StaticResource MenuStepperButtonStyle}"
                                    Click="AutoHideSliverWidthDecrement_Click"/>
                            <TextBlock Text="3"
                                    Foreground="{DynamicResource MenuForeground}"
                                    Width="26"
                                    TextAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Button Content="+"
                                    Style="{StaticResource MenuStepperButtonStyle}"
                                    Click="AutoHideSliverWidthIncrement_Click"/>
                        </StackPanel>
                    </Grid>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem StaysOpenOnClick="True"
                    Focusable="False"
                    Padding="{DynamicResource MenuStepperRowPadding}"
                    AutomationProperties.AutomationId="scrollBarThicknessRow">
                <MenuItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                Text="{x:Static services:Strings.MenuScrollBarThickness}"
                                Foreground="{DynamicResource MenuForeground}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                            <Button Content="−"
                                    Style="{StaticResource MenuStepperButtonStyle}"
                                    Click="ScrollBarThicknessDecrement_Click"/>
                            <TextBlock Text="12"
                                    Foreground="{DynamicResource MenuForeground}"
                                    Width="26"
                                    TextAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <Button Content="+"
                                    Style="{StaticResource MenuStepperButtonStyle}"
                                    Click="ScrollBarThicknessIncrement_Click"/>
                        </StackPanel>
                    </Grid>
                </MenuItem.Header>
            </MenuItem>
            <!-- Kept next to Language: both open a submenu, so they read as a
                 pair at the end of the settings block rather than one submenu
                 stranded above a run of steppers. -->
            <MenuItem Header="{x:Static services:Strings.MenuDefaultSort}"
                    AutomationProperties.AutomationId="sortMenu">
                <MenuItem Header="{x:Static services:Strings.MenuSortByName}"
                        IsCheckable="True"
                        Tag="name"
                        Click="SortFieldMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuSortByDate}"
                        IsCheckable="True"
                        Tag="date"
                        Click="SortFieldMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuSortByType}"
                        IsCheckable="True"
                        Tag="type"
                        Click="SortFieldMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuSortBySize}"
                        IsCheckable="True"
                        Tag="size"
                        Click="SortFieldMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="{x:Static services:Strings.MenuSortAscending}"
                        IsCheckable="True"
                        Tag="asc"
                        Click="SortDirectionMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuSortDescending}"
                        IsCheckable="True"
                        Tag="desc"
                        Click="SortDirectionMenuItem_Click"/>
            </MenuItem>
            <!-- Applies live (no restart) - see IconStyleMenuItem_Click.
                 Sits above 언어 rather than below it: this one changes how the
                 tree looks, like the rows of settings it follows, while a
                 language change restarts the app and belongs at the end with
                 the other things that leave. OptionsMenu_Opened matches this
                 menu's items by POSITION, so keep its pattern in sync when
                 touching anything here. -->
            <MenuItem Header="{x:Static services:Strings.MenuIconStyle}"
                    AutomationProperties.AutomationId="iconStyleMenu">
                <MenuItem Header="{x:Static services:Strings.MenuIconStyleDefault}"
                        IsCheckable="True"
                        Tag="default"
                        Click="IconStyleMenuItem_Click"/>
                <MenuItem Header="{x:Static services:Strings.MenuIconStyleShell}"
                        IsCheckable="True"
                        Tag="shell"
                        Click="IconStyleMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="{x:Static services:Strings.MenuLanguage}"
                    AutomationProperties.AutomationId="languageMenu">
                <!-- Non-interactive note, not a language choice - IsEnabled
                     False keeps it unclickable and visually dimmed. -->
                <MenuItem Header="{x:Static services:Strings.LanguageRestartNote}"
                        IsEnabled="False"/>
                <MenuItem Header="한국어"
                        IsCheckable="True"
                        Tag="ko"
                        Click="LanguageMenuItem_Click"/>
                <MenuItem Header="English"
                        IsCheckable="True"
                        Tag="en"
                        Click="LanguageMenuItem_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.MenuExportSettings}"
                    Click="ExportSettingsMenuItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuImportSettings}"
                    Click="ImportSettingsMenuItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuResetSettings}"
                    Click="ResetSettingsMenuItem_Click"/>
            <Separator/>
            <!-- Moved off the header strip (2026-08-10): it sat between
                 the options "..." and the close X, two buttons that get used,
                 and sending the whole window to the tray is not something to
                 do by a slipped click. Here it costs a menu, which is the
                 right price for something you mean to do - and it lands
                 beside 다시 시작, the other lever that acts on the app as a
                 whole rather than on what it is showing. -->
            <MenuItem Header="{x:Static services:Strings.ToolTipMinimize}"
                    Click="MinimizeButton_Click"/>
            <!-- The recovery lever (2026-08-09): when something feels
                 off - possibly another program fighting this one, not even
                 our fault - a restart clears it without hunting the tray
                 icon or changing the language just to reach one. No
                 confirmation: clicking it IS the intent, and the app is
                 back in a second. -->
            <MenuItem Header="{x:Static services:Strings.MenuRestart}"
                    Click="RestartMenuItem_Click"/>
            <!-- F1 is the real way in and this row is how anyone finds out
                 that F1 is. Above 앱 정보 because it answers a question about
                 using the app, which is what someone opening this menu is
                 doing; the version and the licences are what they read once. -->
            <MenuItem Header="{x:Static services:Strings.MenuHelp}"
                    InputGestureText="F1"
                    Click="HelpMenuItem_Click"/>
            <MenuItem Header="{x:Static services:Strings.MenuAbout}"
                    Click="AboutMenuItem_Click"/>
        </ContextMenu>

        <!-- A minimal chevron that rotates 90° on expand, closer to VS Code's
             arrow than the default Windows TreeViewItem expander glyph. A plain
             Setter can't target a nested Freezable (RotateTransform) by name, but
             a Storyboard's TargetProperty path can drill into one directly, so
             the smooth rotation is done via EnterActions/ExitActions instead. -->
        <Style x:Key="ExpanderToggleButtonStyle"
                TargetType="ToggleButton">
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Width"
                    Value="16"/>
            <Setter Property="Height"
                    Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent"
                                Width="16"
                                Height="16">
                            <!-- Open two-segment chevron (no closing/flat edge), so it
                                 reads as a plain "›" rather than a filled flag shape. -->
                            <Path x:Name="Arrow"
                                    Data="M5,3 L9.5,6.5 L5,10"
                                    Stroke="#FF8A8A8A"
                                    StrokeThickness="1.4"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             To="90"
                                                    Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             To="0"
                                                    Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Arrow"
                                        Property="Stroke"
                                        Value="{DynamicResource ForegroundText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerTreeViewItemStyle"
                TargetType="TreeViewItem">
            <!-- Blocks the root TreeView's deliberately huge CacheLength (see
                 ExplorerTree) from inheriting down here. That cache exists only
                 to keep the handful of drive-root containers always realized;
                 a folder can hold up to DisplayCap children - many more once
                 "더 보기" is used - and has never had the realization problem
                 the root had, so it keeps WPF's normal one-page-either-side
                 caching. A local value beats an inherited one, which is what
                 makes this work. -->
            <Setter Property="VirtualizingPanel.CacheLengthUnit"
                    Value="Page"/>
            <Setter Property="VirtualizingPanel.CacheLength"
                    Value="1,1"/>
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <!-- Vertical padding scales with the TreeView's FontSize AND the
                 user's own "행 간격" adjustment - both folded together in
                 ApplyLayoutMetrics (see RowPadding there) rather than a
                 converter, since a converter bound to just one property
                 (FontSize) had no clean way to take this second input too. -->
            <Setter Property="Padding"
                    Value="{DynamicResource RowPadding}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource FolderNameForeground}"/>
            <!-- Inherited down to NameText, exactly like Foreground above. File
                 rows override both in their own trigger, which is what makes
                 "폴더만 굵게" a single resource rather than a special case. -->
            <Setter Property="FontWeight"
                    Value="{DynamicResource FolderNameFontWeight}"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="ContextMenu"
                    Value="{StaticResource ExplorerItemContextMenu}"/>
            <Setter Property="AllowDrop"
                    Value="True"/>
            <EventSetter Event="Expanded"
                    Handler="TreeViewItem_Expanded"/>
            <EventSetter Event="PreviewMouseRightButtonDown"
                    Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
            <EventSetter Event="PreviewMouseLeftButtonDown"
                    Handler="TreeViewItem_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseMove"
                    Handler="TreeViewItem_PreviewMouseMove"/>
            <EventSetter Event="PreviewMouseLeftButtonUp"
                    Handler="TreeViewItem_PreviewMouseLeftButtonUp"/>
            <EventSetter Event="DragEnter"
                    Handler="TreeViewItem_DragOver"/>
            <EventSetter Event="DragOver"
                    Handler="TreeViewItem_DragOver"/>
            <EventSetter Event="Drop"
                    Handler="TreeViewItem_Drop"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="RowBorder"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ExpanderColumn"
                                                Width="{DynamicResource TabSpacingWidth}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="Expander"
                                            Grid.Column="0"
                                                  Style="{StaticResource ExpanderToggleButtonStyle}"
                                                  ClickMode="Press"
                                                  HorizontalAlignment="Center"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                    <ContentPresenter x:Name="PART_Header"
                                            Grid.Column="1"
                                            ContentSource="Header"
                                                      HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <!-- Each nesting level compounds this margin, producing the
                                 cascading indent that the default template gets "for free" -
                                 our custom template has to add it back explicitly. The left
                                 border draws a guide line under the parent arrow's center that
                                 spans exactly this subtree's rendered height (Border sizes to
                                 its child), so it reads as one continuous line VS Code-style
                                 without any per-row depth tracking. Margin/Padding are "탭간격"
                                 (TabSpacingWidth) split around the fixed 1px BorderThickness -
                                 see ApplyLayoutMetrics - so the line stays centered under the
                                 arrow above regardless of the current spacing. -->
                            <Grid x:Name="ItemsHost"
                                    Visibility="Collapsed">
                                <!-- BorderThickness with no brush: the 1px is still reserved,
                                     so every metric ApplyLayoutMetrics splits around it stays
                                     exactly as it was. The line is only PAINTED elsewhere. -->
                                <Border Margin="{DynamicResource TabSpacingGuideMargin}"
                                        BorderThickness="1,0,0,0"
                                        Padding="{DynamicResource TabSpacingGuidePadding}">
                                    <ItemsPresenter/>
                                </Border>
                                <!-- The line drawn over that reserved pixel rather than by it,
                                     because a Border hit-tests wherever it PAINTS: the line was
                                     clickable (the empty strip either side of it never was), and
                                     clicking it selected the ancestor that owns it. Halfway down
                                     a long subtree there is no way to tell which folder a 1px
                                     line belongs to, so it stopped being a target - it shows
                                     depth, and how far a folder reaches, and nothing else. -->
                                <Border x:Name="GuideLine"
                                        Margin="{DynamicResource TabSpacingGuideMargin}"
                                        HorizontalAlignment="Left"
                                        Width="1"
                                        IsHitTestVisible="False"
                                        Background="{DynamicResource TreeGuideLineBrush}"/>
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded"
                                    Value="True">
                                <Setter TargetName="ItemsHost"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <!-- ExpanderColumn's width setter only actually matters combined
                                 with HasItems=False (a file never has this arrow to begin
                                 with) - see FileArrowGutterWidth's own comment in the
                                 Resources block above for when/why it collapses to 0. -->
                            <Trigger Property="HasItems"
                                    Value="False">
                                <Setter TargetName="Expander"
                                        Property="Visibility"
                                        Value="Hidden"/>
                                <Setter TargetName="ExpanderColumn"
                                        Property="Width"
                                        Value="{DynamicResource FileArrowGutterWidth}"/>
                            </Trigger>
                            <!-- Brightens this folder's guide line whenever it's an
                                 ancestor of the currently selected item (maintained by
                                 MainWindow on TreeView.SelectedItemChanged), so the path
                                 down to the active selection is easy to trace. -->
                            <DataTrigger Binding="{Binding IsAncestorOfSelection}"
                                    Value="True">
                                <Setter TargetName="GuideLine"
                                        Property="Background"
                                        Value="{DynamicResource TreeGuideLineActiveBrush}"/>
                            </DataTrigger>
                            <!-- SourceName="RowBorder" (not plain Property="IsMouseOver", which
                                 would read the whole TreeViewItem) matters here: a TreeViewItem's
                                 IsMouseOver is true whenever the pointer is anywhere over its
                                 rendered bounds, and those bounds include every expanded
                                 descendant's rows too (they're part of the same control). Without
                                 this, hovering one deeply nested row lit up its entire hover
                                 background on every ancestor simultaneously, and moving the mouse
                                 around the tree made that whole chain flicker on and off.
                                 RowBorder only spans this row's own header (icon+text) - it's a
                                 sibling of ItemsHost, not a container of it - so checking
                                 IsMouseOver there instead correctly scopes to just this row. -->
                            <Trigger SourceName="RowBorder"
                                    Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <!-- No TargetName: sets TreeViewItem.Foreground itself (see the
                                     IsSelected trigger below for the same reasoning), which the
                                     selected-row trigger's Foreground setter still overrides when
                                     both apply, since it's declared after this one. Folder rows
                                     pick this up by inheritance (NameText sets no local Foreground
                                     of its own); file rows have their own explicit hover/selected
                                     triggers instead (see the HierarchicalDataTemplate below) that
                                     override this by design. -->
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FolderNameHoverForeground}"/>
                            </Trigger>
                            <!-- Ctrl/Shift-click multi-selection rows: painted with the exact
                                 same brushes as the native selection below, so the one row WPF
                                 itself selected and the extra flagged rows are indistinguishable.
                                 Declared BEFORE the IsSelected triggers so native selection's
                                 setters win when both apply to the same row. -->
                            <DataTrigger Binding="{Binding IsMultiSelected}"
                                    Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowSelectedActiveBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FolderNameHighlightForeground}"/>
                            </DataTrigger>
                            <!-- "A drop lands here": the same brushes again, for
                                 the same reason the multi-selection uses them -
                                 one mark, learned once. It is a state of its own
                                 rather than the native selection (which is what
                                 used to be moved here) so that picking a row up
                                 and dragging it out no longer takes the mark off
                                 that row and hands it back on release. Only ever
                                 true on a FOLDER row - ResolveDropTargetFolder
                                 resolves a hovered file to its parent - so file
                                 rows need no matching trigger of their own. -->
                            <DataTrigger Binding="{Binding IsDropTarget}"
                                    Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowSelectedActiveBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FolderNameHighlightForeground}"/>
                            </DataTrigger>
                            <!-- Selected background no longer varies with
                                 Selector.IsSelectionActive: that state flips to False any time
                                 keyboard focus leaves the tree's focus scope - including while
                                 the row's own ContextMenu is open - which read as the selection
                                 highlight flickering on/off on every right-click. Selection now
                                 always renders the same way regardless of focus. -->
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowSelectedActiveBackground}"/>
                            </Trigger>
                            <!-- No TargetName: this sets TreeViewItem.Foreground itself, which
                                 the header's TextBlock then picks up by inheritance (it no
                                 longer sets its own local Foreground). -->
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FolderNameHighlightForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- The blank rows that make room past the last drive: they are
                     scroll range and nothing else. No hover, no click, no
                     keyboard stop, no tooltip - the same set of denials the
                     search view's header rows carry, for the same reason. -->
                <DataTrigger Binding="{Binding IsBottomGap}"
                        Value="True">
                    <Setter Property="Focusable"
                            Value="False"/>
                    <Setter Property="IsHitTestVisible"
                            Value="False"/>
                    <Setter Property="ToolTipService.IsEnabled"
                            Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The grab line for every resize edge (and the viewer's divider).
             The two states carry ALPHA rather than darker greys, and that is
             deliberate: these values are fixed across both themes, so a darker
             grey would soften the line on the dark theme and strengthen it on
             the light one. Alpha blends toward whatever is actually behind, so
             it softens both the same way.
             Softened 2026-08-09 - the opaque #FF6B6B6B / #FF9B9B9B read too
             loud for a 1px hint, from hover onward, "눈에 좀 계속 밟히네요".
             DRAG IS NOW FAINTER THAN HOVER, which looks backwards written down
             and is right in the hand: hover has to say "there is something to
             grab here", and once it IS grabbed the cursor has already turned
             into the resize arrows and says it better than a line can. Same
             base grey for both so the two states read as one scale; only the
             alpha differs, and it is the only thing to touch if they ever need
             another nudge (8C hover / 4D drag).
             IsDragging is declared AFTER IsMouseOver on purpose - both are
             true mid-drag, and the later trigger is the one that wins. -->
        <Style x:Key="ResizeThumbStyle"
                TargetType="Thumb">
            <!-- Mouse-only, like every other grip and chip in this app: a
                 Thumb takes keyboard focus by default, and dragging one left
                 the focus sitting on a grab strip - so the arrow keys stopped
                 reaching the tree, and hiding the strip (entering full screen)
                 stranded the focus entirely (2026-08-09). Nothing here has a
                 keyboard gesture to lose. -->
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="Bar"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bar"
                                        Property="Background"
                                        Value="#8C6B6B6B"/>
                            </Trigger>
                            <Trigger Property="IsDragging"
                                    Value="True">
                                <Setter TargetName="Bar"
                                        Property="Background"
                                        Value="#4D6B6B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The same thumb turned on its side, for the docked window's top and
             bottom edges. A copy rather than one style with a bound orientation:
             the whole template is a Grid holding one Border, and a second copy
             of it costs less than the machinery to rotate the first. -->
        <Style x:Key="ResizeThumbHorizontalStyle"
                TargetType="Thumb">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="Bar"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bar"
                                        Property="Background"
                                        Value="#8C6B6B6B"/>
                            </Trigger>
                            <Trigger Property="IsDragging"
                                    Value="True">
                                <Setter TargetName="Bar"
                                        Property="Background"
                                        Value="#4D6B6B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>




        <Style x:Key="ExplorerTreeViewStyle"
                TargetType="TreeView">
            <!-- Top padding dropped from 8 to 0 - the gap between the top
                 divider and the first drive row (C:) read as too generous. -->
            <Setter Property="Padding"
                    Value="4,0,4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeView">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_TreeScrollViewer"
                                    Focusable="False"
                                    Padding="{TemplateBinding Padding}"
                                          Template="{StaticResource MinimalScrollViewerTemplate}"
                                          CanContentScroll="True"
                                          HorizontalScrollBarVisibility="{Binding Path=(ScrollViewer.HorizontalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}"
                                          VerticalScrollBarVisibility="{Binding Path=(ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every tree row's full path, on hover. Requested by a user
             2026-07-31 (together with a horizontal scrollbar; only this half
             was taken) for names the sidebar's width cuts to "긴폴더이름...",
             and shown on EVERY row rather than only the cut ones - the trimmed-
             only version was built first and rejected: a tooltip that appears
             on some rows and not others reads as broken, and the path is worth
             having either way. This supersedes the older reasoning in the
             favorites style below ("the tree needs no path tooltip, its rows
             sit under their own parents"); favorites and tree now say the same
             kind of thing on hover.

             The full PATH, not just the name that got cut - the path contains
             the name anyway, so nothing is lost by it. Binds
             FileSystemItem.FullPath, so this style belongs to tree rows;
             another item type needs its own tooltip rather than this one,
             which would silently come up blank.

             FontSize is bound through the placement target: a tooltip is its
             own window, outside the tree's visual tree, so it inherits nothing
             and would otherwise ignore Ctrl +/-. The delay is the favorites'
             900ms, not WPF's default - brushing past a row on the way
             somewhere else shouldn't pop anything up. -->
        <!-- Implicit, so all three of the app's tooltips (tree row, favorites
             row, bookmark panel row) take it without being told. They set only
             Content and FontSize, which left the surface itself at WPF's stock
             chrome - a pale background with black text, in a dark-themed window
             (2026-08-02). It follows the theme now, using the same three
             brushes the menus do.

             Defined ABOVE its first use on purpose: the ToolTip objects below
             live inside Setter values, and a style they cannot find yet is a
             style they never get. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background"
                    Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MenuForeground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="8,4"/>
            <!-- No MaxWidth, no wrapping. Both were tried on 2026-08-02 and
                 taken straight back out: a path broken across two lines reads
                 worse than a long one - it splits at whatever space happens to
                 fall near the limit, in the middle of a name. A path is one
                 string and belongs on one line. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One file-kind toggle in the version footer. Deliberately quiet when
             off - text only, no border - so a strip of eight reads as a line of
             labels rather than as eight buttons; the one that is ON is the only
             thing meant to catch the eye. -->
        <Style x:Key="FooterFilterChipStyle"
                TargetType="ToggleButton">
            <!-- Follows Ctrl +/- through the resource, and it is set HERE so
                 that every chip in either strip takes it - the viewer's zoom
                 row used to be the one place left at a fixed 11 (asked
                 for both linked, 2026-08-10). What made that possible was
                 giving the two fixed-width readouts (% and the media time)
                 hidden twins instead of hardcoded widths, so a growing font
                 widens its own slot. -->
            <Setter Property="FontSize"
                    Value="{DynamicResource FooterChipFontSize}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundText}"/>
            <Setter Property="Opacity"
                    Value="0.65"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Margin"
                    Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="5,1"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                            <!-- Grey, not the tree's selection colour and not an
                                 accent: the lit chip has to stand out from the
                                 seven quiet ones without shouting across the
                                 strip. What carries it is the full-strength
                                 text, not the fill (2026-08-02). -->
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource FooterChipCheckedBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FooterChipCheckedForeground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A chip that carries a SHAPE instead of a word. The filter chips'
             template draws its Content into a TextBlock, which is right for
             them and cannot hold a Path - and the filmstrip's switch had been
             making do with box-drawing characters, which read as a broken
             glyph after a while (2026-08-10).

             Everything else is inherited, so the lit/hover states and the
             opacity are the row's, not this chip's own. The shape follows the
             button's Foreground rather than fixing a colour, which is what
             carries it through those states. -->
        <Style x:Key="FooterFilterGlyphChipStyle"
                TargetType="ToggleButton"
                BasedOn="{StaticResource FooterFilterChipStyle}">
            <!-- The box every button in the viewer strip shares. Only used by
                 the viewer, so the footer's filter chips - which size
                 themselves to their words - are untouched by it. -->
            <Setter Property="MinWidth"
                    Value="{DynamicResource ViewerChipBoxWidth}"/>
            <Setter Property="MinHeight"
                    Value="{DynamicResource ViewerChipBoxHeight}"/>
            <Setter Property="Margin"
                    Value="{DynamicResource ViewerChipMargin}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="5,2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource FooterChipCheckedBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FooterChipCheckedForeground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The exclusion chip. Same shape and size as the seven kind chips -
             it belongs to that strip - but it is the only one that TAKES
             files away rather than letting them through, and a strip where
             every chip looks alike would say nothing about that. So it carries
             its own ink instead of the shared ForegroundText, and its lit fill
             is a wash of the same hue rather than the grey/blue the others
             take. Colour, not opacity: dimming is how this app marks nothing
             (see the 흐리게 rule) and a filter that hides files has to be the
             most legible thing in the footer, not the least.

             The two inks are theme-fixed like FooterChipChecked* above, NOT a
             new row in 색상 설정 - one more colour to pick is a cost every
             user pays for a strip most of them will never turn on. -->
        <Style x:Key="FooterExcludeChipStyle"
                TargetType="ToggleButton"
                BasedOn="{StaticResource FooterFilterChipStyle}">
            <Setter Property="Foreground"
                    Value="{DynamicResource FooterChipExcludeForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="5,1"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                            <!-- Lit exactly the way the seven kind chips are -
                                 a solid fill with white on it - just in this
                                 chip's own hue instead of theirs. A tinted
                                 wash was tried first, so that the coloured ink
                                 could stay in both states, and the on/off
                                 difference was too quiet to read (
                                 2026-08-10). The hue alone already says which
                                 chip this is; the fill has the other job. -->
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource FooterChipExcludeCheckedBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FooterChipCheckedForeground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The chip above, minus the checked state: the viewer's zoom stepper
             (− and +) does something rather than IS something, so it can't be
             a ToggleButton, but it sits in the same strip as 맞춤/1:1 and has
             to match them pixel for pixel. Kept as a separate Style rather
             than a shared template because the checked trigger is the only
             difference and duplicating four setters beats a BasedOn chain
             across two control types. -->
        <Style x:Key="FooterActionChipStyle"
                TargetType="Button">
            <!-- "Match them pixel for pixel" now includes the zoom: same
                 resource as the toggles above. -->
            <Setter Property="FontSize"
                    Value="{DynamicResource FooterChipFontSize}"/>
            <!-- These are the ones left carrying a bare glyph once 맞춤, 1:1 and
                 내비게이터 became marks - − + < > and the transport row. The
                 outline is what makes them read as buttons beside the icons,
                 and the shared box is what keeps the row even (asked for
                 both, 2026-08-10). -->
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ViewerChipBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="MinWidth"
                    Value="{DynamicResource ViewerChipBoxWidth}"/>
            <Setter Property="MinHeight"
                    Value="{DynamicResource ViewerChipBoxHeight}"/>
            <Setter Property="Margin"
                    Value="{DynamicResource ViewerChipMargin}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundText}"/>
            <Setter Property="Opacity"
                    Value="0.65"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Margin"
                    Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="5,1"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                            <!-- A step that can't be taken (already at fit, or
                                 at 800%) stays visible and stops answering -
                                 the alternative, hiding it, would shuffle the
                                 strip's width every time the zoom crosses an
                                 end. Half the resting ink, which is the one
                                 place opacity still means "unavailable"
                                 rather than "secondary". -->
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter Property="Opacity"
                                        Value="0.3"/>
                                <Setter Property="Cursor"
                                        Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The style above, drawing a SHAPE instead of a character - the same
             split FooterFilterGlyphChipStyle makes for the toggles, and for the
             same reason: that template draws Content through a TextBlock, so a
             Path put in one renders as nothing at all (which is how the mute
             speaker came to be invisible, 2026-08-09).
             Everything else is inherited, so the box, the outline, the hover
             and the greyed-out step all stay the row's rather than this
             style's. -->
        <Style x:Key="FooterActionGlyphChipStyle"
                TargetType="Button"
                BasedOn="{StaticResource FooterActionChipStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="5,2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter Property="Opacity"
                                        Value="0.3"/>
                                <Setter Property="Cursor"
                                        Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The little chevron that closes the viewer from the divider, so the
             gesture is where the eye already is instead of a trip to the
             window's top-right corner (2026-08-09). Its own style rather
             than the header's ToggleButtonStyle: this one is a tall narrow
             plate riding a 1px line, not a square button in a row of squares.
             Resting ink matches the footer chips (0.65) so it reads as the
             same quiet class of control. -->
        <!-- Position and volume sliders for the viewer's transport strip. Thin
             enough to read as a readout rather than a control panel, and the
             played part wears the caption's own ink at the same 0.65 the rest
             of the strip does, so nothing here shouts. Every part is
             Focusable=False, like the app's other mouse-only chrome. -->
        <Style x:Key="ViewerMediaSliderStyle"
                TargetType="Slider">
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Height"
                    Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="3"
                                    CornerRadius="1.5"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource TreeGuideLineBrush}"/>
                            <!-- Both repeat buttons fill the control's FULL
                                 height, with the 3px bar drawn inside them.
                                 IsMoveToPointEnabled only answers clicks that
                                 land on the track's own parts, so when they
                                 were 3px tall the strip demanded the cursor
                                 hit a 3-pixel band - or the thumb itself -
                                 and everything else fell through to dead
                                 space ("동그라미를 아주 정확히 클릭한 후",
                                 2026-08-09). The whole 18px band is the
                                 target now. -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                            Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="3"
                                                            CornerRadius="1.5"
                                                            VerticalAlignment="Center"
                                                            Opacity="0.65"
                                                            Background="{DynamicResource ForegroundText}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                            Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12"
                                            Height="12"
                                            Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Width="12"
                                                            Height="12"
                                                            Fill="{DynamicResource ForegroundText}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerCollapseButtonStyle"
                TargetType="Button">
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Opacity"
                    Value="0.65"/>
            <!-- Template-bound rather than fixed: the collapse chevron sits on
                 the viewer's background, the expand chevron on the tree's. -->
            <Setter Property="Background"
                    Value="{DynamicResource ViewerBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowPathTooltip"
                TargetType="TextBlock">
            <Setter Property="ToolTipService.InitialShowDelay"
                    Value="900"/>
            <Setter Property="ToolTipService.ShowDuration"
                    Value="20000"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Content="{Binding FullPath}"
                            FontSize="{Binding PlacementTarget.FontSize, RelativeSource={RelativeSource Self}}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type models:FileSystemItem}"
                ItemsSource="{Binding Children}">
            <!-- A horizontal StackPanel measures children with infinite available
                 width, so TextTrimming never actually engaged - the text just
                 rendered past the edge and got clipped with no "...". A Grid's
                 star column constrains the TextBlock to the real remaining width. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="RowIcon"
                        Grid.Column="0"
                        Source="{Binding Icon}"
                        Width="{DynamicResource IconSize}"
                        Height="{DynamicResource IconSize}"
                        Margin="{DynamicResource FolderRowIconMargin}"
                       VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- Network marker: a small dot on a folder icon's lower-left
                     corner when the item lives on a network drive - the same
                     idea as Explorer badging the network drive's own icon, so
                     NAS territory stays recognizable deep in a scroll. Shown
                     by trigger (IsOnNetworkDrive + folder + icon visible - it
                     must vanish along with the icon when folder icons are
                     toggled off). Green, the conventional "connected" hue,
                     with a dark rim so it reads on top of the yellow folder.
                     Turns RED while the drive isn't answering (see
                     IsNetworkDriveOffline and MainWindow's poll) - Explorer
                     crosses the drive out in the same situation. Same dot,
                     same place, only the colour: at 7px a cross is mush,
                     while a colour change on a shape already in the eye's
                     memory reads instantly. -->

                <Ellipse x:Name="NetworkBadge"
                        Grid.Column="0"
                        Width="7"
                        Height="7"
                        Fill="#FF3FBF6B"
                        Stroke="#66000000"
                        StrokeThickness="1"
                        Margin="{DynamicResource FolderRowIconMargin}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Visibility="Collapsed"/>
                <!-- Foreground and FontSize intentionally not set here - both inherit
                     (Foreground from the TreeViewItem for selection-driven white text,
                     FontSize from the TreeView so Ctrl+/- zoom can rescale every row). -->
                <TextBlock x:Name="NameText"
                           Grid.Column="1"
                           Text="{Binding Name}"
                           VerticalAlignment="Center"
                        Style="{StaticResource RowPathTooltip}"
                        TextTrimming="CharacterEllipsis"/>
                <!-- VS Code-style inline rename: swapped in for NameText while
                     IsEditing (see the DataTrigger below) instead of opening a
                     separate popup dialog. Focus/selection and commit/cancel
                     are handled in code-behind (RenameTextBox_* in MainWindow.xaml.cs). -->
                <TextBox x:Name="NameEditBox"
                         Grid.Column="1"
                         Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="Collapsed"
                         Background="#FF3C3C3C"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#FF5A5A5A"
                         BorderThickness="1"
                         Padding="2,0"
                         VerticalAlignment="Center"
                         IsVisibleChanged="RenameTextBox_IsVisibleChanged"
                         KeyDown="RenameTextBox_KeyDown"
                         LostFocus="RenameTextBox_LostFocus"
                         Loaded="RenameTextBox_Loaded"/>
                <!-- Shown in place of icon+name for the synthetic "… 더 보기 (N)"
                     row that caps oversized folders (FileSystemItem.DisplayCap);
                     clicking it reveals the rest (see
                     TreeViewItem_PreviewMouseLeftButtonDown). -->
                <TextBlock x:Name="ShowMoreText"
                           Grid.Column="1"
                           Text="{Binding ShowMoreLabel}"
                           Foreground="{DynamicResource ShowMoreForeground}"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Opacity="0.65"
                           FontStyle="Italic"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Shown only when this folder has its own remembered sort
                     (HasSortOverride - see FileSystemItem and
                     Services/FileSystemService.SortOverrides), independent of
                     the app-wide default. Click OPENS THE SORT MENU (see
                     TreeViewItem_PreviewMouseLeftButtonDown's
                     clickedOnSortOverrideIcon check) - it used to rotate
                     through the states instead, which stopped working the
                     moment 유형/크기 joined 이름/날짜: five states already took
                     four clicks to reach the last one, and nine is not a
                     control. The menu names every state in words and clears
                     the override too.
                     Wrapped in its own Border so that check can find the click
                     by name without also matching some other Border further
                     up the row (RowBorder's hover/selection highlight, etc). -->
                <Border x:Name="SortOverrideIconBorder"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        Background="Transparent"
                        Margin="{DynamicResource SortOverrideIconMargin}"
                        Padding="{DynamicResource SortOverrideIconPadding}"
                        Cursor="Hand"
                        ToolTip="{Binding SortOverrideTooltip}">
                    <!-- Right margin (6) clears the overlay scrollbar's 5px
                         hit-test width (MinimalScrollBarStyle) - that 5px is
                         the floor for this number, not a preference: it's
                         drawn on top of full-bleed row content
                         (see MinimalScrollViewerTemplate) and still hit-tests
                         at Opacity 0, so without this gap it silently steals
                         clicks meant for this icon. Padding (6 horizontal,
                         0 vertical - the 13px-tall image already fits inside
                         the row's existing height set by the 16px folder/file
                         icon, so any vertical padding here would be what
                         pushes the row taller only while this icon shows)
                         widens the actual clickable area well beyond the
                         image itself, which is otherwise a fiddly target to
                         land a click on. -->
                    <!-- Vector, not one of the old PNG pairs: it takes the
                         row's own folder-name brush, so light and dark themes
                         (and any custom colour) need no second asset - which
                         was the blocker that kept 유형/크기 waiting. -->
                    <Path Data="{Binding SortOverrideIconGeometry}"
                            Fill="{DynamicResource FolderNameForeground}"
                            Width="{DynamicResource SortOverrideIconWidth}"
                            Height="{DynamicResource SortOverrideIconHeight}"
                            Stretch="Uniform"
                            VerticalAlignment="Center"/>
                </Border>
                <!-- 책갈피 marker (IsBookmarked, toggled via Ctrl+Alt+K or the
                     right-click menu; Ctrl+Alt+L/J cycles through them).
                     Drawn as an OVERLAY at the row's right edge (column span
                     + right alignment) rather than occupying a column of its
                     own, so appearing never displaces the sort icon - it sits
                     inside the 12px strip that icon already leaves clear for
                     the scrollbar. Not a click target (IsHitTestVisible off,
                     so it can't even steal a row click), which is why living
                     under the scrollbar's hover zone costs nothing. Height
                     follows the font zoom (BookmarkMarkerHeight, grow-only
                     like the sort icon's). The glyph is Material Symbols
                     "bookmark" (SVG v2, flat-top ribbon) kept
                     in its native 960 grid, Stretch doing the fitting - same
                     convention as the header's keep-pin. Fixed mid-blue by
                     design: legible on both themes without adding a 16th
                     palette entry. -->
                <!-- Column of its own (2026-07-28), replacing a full-width
                     overlay pinned to the right edge. The overlay was chosen so
                     that a marker appearing would never displace the sort icon,
                     and it did hold that - but taking no part in layout meant
                     the name simply ran underneath it, which at a narrow window
                     put the ribbon on top of the last letters rather than on
                     the ellipsis. It also came and went while the window was
                     being resized, the row's content briefly outgrowing the
                     viewport it was being right-aligned against. A real column
                     ends both: the star column now measures against what is
                     actually left, so the name trims before the ribbon instead
                     of behind it, and there is nothing left to clip. -->
                <!-- Clicking the ribbon releases the bookmark (2026-08-04). It
                     is where the eye already is when the answer is "not this
                     one any more", and the two routes that existed - Ctrl+Alt+K
                     and the row menu - both ask the user to name a row that is
                     already marked in front of them.
                     The Border is the target rather than the glyph: a ribbon is
                     a few pixels of filled path, and a shape only takes a hit
                     where it paints. The transparent box around it is what
                     makes this the size of a thing meant to be clicked - the
                     same complaint the list rows' "−" lost to in August. -->
                <Border x:Name="BookmarkMarkerBorder"
                        Grid.Column="3"
                        Background="Transparent"
                        Margin="{DynamicResource BookmarkMarkerMargin}"
                        Padding="2,0"
                        Cursor="Hand"
                        ToolTip="{x:Static services:Strings.MenuBookmarkRemove}"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed">
                    <Path x:Name="BookmarkMarker"
                            Data="F1 M240-144v-672h480v672l-240-96-240 96Z"
                            Fill="#FF4A90E2"
                            Stretch="Uniform"
                            Height="{DynamicResource BookmarkMarkerHeight}"
                            VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}"
                        Value="True">
                    <Setter TargetName="NameText"
                            Property="Visibility"
                            Value="Collapsed"/>
                    <Setter TargetName="NameEditBox"
                            Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsShowMore}"
                        Value="True">
                    <Setter TargetName="RowIcon"
                            Property="Visibility"
                            Value="Collapsed"/>
                    <Setter TargetName="NameText"
                            Property="Visibility"
                            Value="Collapsed"/>
                    <Setter TargetName="ShowMoreText"
                            Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
                <!-- The blank rows parked after the last drive (see the
                     아래 여백 section). Same treatment as 더 보기 minus the
                     text: nothing drawn at all, so the run of them reads as
                     empty space rather than as rows. -->
                <DataTrigger Binding="{Binding IsBottomGap}"
                        Value="True">
                    <Setter TargetName="RowIcon"
                            Property="Visibility"
                            Value="Collapsed"/>
                    <Setter TargetName="NameText"
                            Property="Visibility"
                            Value="Collapsed"/>
                </DataTrigger>
                <!-- Only while expanded - a collapsed folder's icon can't be
                     usefully clicked to try a different sort without seeing
                     the result, and it's one less thing sitting in a closed
                     row. Reappears the moment the folder is expanded again,
                     since HasSortOverride itself is untouched by collapsing. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasSortOverride}"
                                Value="True"/>
                        <Condition Binding="{Binding IsExpanded}"
                                Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="SortOverrideIconBorder"
                            Property="Visibility"
                            Value="Visible"/>
                </MultiDataTrigger>
                <!-- Also shown (even with no override yet) while this folder is
                     both expanded AND the current selection, so it's reachable
                     with a single click right after selecting a folder instead
                     of having to go through the right-click menu first -
                     disappears again once selection moves on or the folder
                     collapses, unless that click actually left an override
                     behind (the trigger above keeps it visible while expanded). -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDirectory}"
                                Value="True"/>
                        <Condition Binding="{Binding IsExpanded}"
                                Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="SortOverrideIconBorder"
                            Property="Visibility"
                            Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsDirectory}"
                        Value="True">
                    <Setter TargetName="RowIcon"
                            Property="Visibility"
                            Value="{DynamicResource FolderIconVisibility}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBookmarked}"
                        Value="True">
                    <Setter TargetName="BookmarkMarkerBorder"
                            Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
                <!-- The network dot rides the folder icon: folder rows on a
                     network drive only, and only while the icon itself is
                     showing (folder icons toggled off hides the dot too). -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOnNetworkDrive}"
                                Value="True"/>
                        <Condition Binding="{Binding IsDirectory}"
                                Value="True"/>
                        <Condition Binding="{Binding Visibility, ElementName=RowIcon}"
                                Value="Visible"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NetworkBadge"
                            Property="Visibility"
                            Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsDirectory}"
                        Value="False">
                    <Setter TargetName="RowIcon"
                            Property="Visibility"
                            Value="{DynamicResource FileIconVisibility}"/>
                    <Setter TargetName="RowIcon"
                            Property="Margin"
                            Value="{DynamicResource FileRowIconMargin}"/>
                    <!-- Only actually non-zero when file icons are off and
                         folder icons are on (see ApplyIconMetrics) - the one
                         case where RowIcon is Collapsed and can't carry the
                         guide-line alignment shift itself, so the name/edit
                         box take it instead. -->
                    <Setter TargetName="NameText"
                            Property="Margin"
                            Value="{DynamicResource FileNameMargin}"/>
                    <Setter TargetName="NameEditBox"
                            Property="Margin"
                            Value="{DynamicResource FileNameMargin}"/>
                    <Setter TargetName="NameText"
                            Property="FontWeight"
                            Value="{DynamicResource FileNameFontWeight}"/>
                </DataTrigger>
                <!-- File rows get their own text color instead of inheriting
                     ForegroundText/HighlightForeground from the TreeViewItem
                     (which folder rows still do, unchanged) - the split this
                     came from (see AppSettings.FileNameColorHex). Declared
                     normal -> hover -> selected, so a later trigger's Setter
                     overrides an earlier one's when more than one applies at
                     once (selected+hovered ends up selected-colored) - same
                     precedent as the folder-row triggers above. -->
                <DataTrigger Binding="{Binding IsDirectory}"
                        Value="False">
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource FileNameForeground}"/>
                </DataTrigger>
                <!-- AncestorType=Border (not TreeViewItem.IsMouseOver, which
                     would read the whole subtree - see the folder-row hover
                     trigger's own comment above for why) resolves to
                     RowBorder, the nearest Border ancestor of NameText in the
                     visual tree even though RowBorder lives in a different
                     template (the TreeViewItem's ControlTemplate, not this
                     HierarchicalDataTemplate) - ElementName/SourceName can't
                     cross that template boundary, but a visual-tree,
                     type-based RelativeSource lookup doesn't need to. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDirectory}"
                                Value="False"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                                Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource FileNameHoverForeground}"/>
                </MultiDataTrigger>
                <!-- Multi-selected file rows get the same highlighted text color as
                     the natively-selected one (folder rows inherit it from the
                     TreeViewItem style's own IsMultiSelected trigger instead). -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDirectory}"
                                Value="False"/>
                        <Condition Binding="{Binding IsMultiSelected}"
                                Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource FileNameHighlightForeground}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDirectory}"
                                Value="False"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource FileNameHighlightForeground}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsRoot}"
                        Value="True">
                    <Setter TargetName="NameText"
                            Property="FontWeight"
                            Value="Bold"/>
                </DataTrigger>
                <!-- Waiting on a Ctrl+X paste: the icon fades and the name goes
                     quiet - the row's own colour taken towards the background,
                     not an Opacity (the app doesn't say things by fading text,
                     and over an unknown background a fade is a different colour
                     every time). The icon alone was not enough: it leaves the
                     mark invisible to anyone running with icons off, which is a
                     supported way to use the tree (2026-07-28).
                     It used to go ITALIC too, which is now what "hidden but
                     shown" means (see below). Two states that both quiet the
                     name needed the second signal to differ, so the line is
                     drawn here: italic = hidden, faded icon = cut
                     (2026-08-02, with the user).
                     Split folder/file because the muted colour is derived from
                     whichever colour that row would normally use.
                     Deliberately above the offline trigger below, which sets
                     the same Opacity - a row on a sleeping drive should read
                     as switched off first, and the last matching trigger wins. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCut}" Value="True"/>
                        <Condition Binding="{Binding IsDirectory}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowIcon"
                            Property="Opacity"
                            Value="0.4"/>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource MutedFolderNameForeground}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCut}" Value="True"/>
                        <Condition Binding="{Binding IsDirectory}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowIcon"
                            Property="Opacity"
                            Value="0.4"/>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource MutedFileNameForeground}"/>
                </MultiDataTrigger>
                <!-- A hidden folder on screen anyway - a jump passing through
                     it, or "숨긴 폴더 표시" being on. Italic name, in the user's
                     own folder colour taken a step towards the background
                     (HiddenFolderNameForeground, derived in ApplyUserColors),
                     so it never reads as a folder that simply came back: it is
                     here on purpose and only for now.
                     A translucent row backdrop was built first and dropped -
                     over a dark background it read as a bright rim around the
                     row rather than as a dent (2026-08-02).
                     The ICON is deliberately left alone: a faded icon is what
                     cut means, and these two states have to stay tellable
                     apart at a glance.
                     Above the offline trigger below, which owns the "this row
                     is not live" look outright; the last matching trigger
                     wins. -->
                <DataTrigger Binding="{Binding IsHiddenFolderShown}"
                        Value="True">
                    <Setter TargetName="NameText"
                            Property="FontStyle"
                            Value="Italic"/>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource MutedFolderNameForeground}"/>
                </DataTrigger>
                <!-- Drive not answering: red dot, and the row greyed out.
                     LAST on purpose - every folder/file/selection colour above
                     targets the same Foreground, and the last matching trigger
                     is the one that wins, so anywhere earlier and file names
                     simply stayed their normal colour (2026-07-26: "파일은
                     여전히 밝음, 아이콘만 어두워짐").
                     What stays on screen while a drive is out is a listing
                     from before it went away: worth keeping (it says where you
                     were) but it must not read as live, and the subtree is
                     collapsed and inert until the drive answers again (see
                     ApplyNetworkOfflineState). The dot goes grey with
                     everything else rather than red: the whole row already
                     reads as switched off, and a warning colour on top of that
                     is louder than the situation - a NAS being asleep is
                     normal, not an error (2026-07-26). -->
                <DataTrigger Binding="{Binding IsNetworkDriveOffline}"
                        Value="True">
                    <Setter TargetName="NetworkBadge"
                            Property="Fill"
                            Value="#FF8C9196"/>
                    <Setter TargetName="RowIcon"
                            Property="Opacity"
                            Value="0.5"/>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="#FF8C9196"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <ContextMenu x:Key="FavoriteItemContextMenu"
                Style="{StaticResource DarkContextMenuStyle}"
                Opened="AnyMenu_Opened"
                Closed="AnyMenu_Closed"
                PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp">
            <MenuItem Header="{x:Static services:Strings.MenuRemoveFavorite}"
                    Click="RemoveFavorite_Click"/>
        </ContextMenu>

        <Style x:Key="FavoriteListBoxItemStyle"
                TargetType="ListBoxItem">
            <!-- A favorite row has to line up with the tree rows directly
                 beneath it, so it mirrors ExplorerTreeViewItemStyle's metrics
                 by sharing the very same resources rather than restating their
                 default values: RowPadding (Ctrl+/- zoom and "행 간격"),
                 TabSpacingWidth for the expander stand-in column ("들여쓰기 간격"),
                 and IconSize/FolderRowIconMargin for the folder icon. Those
                 last three used to be hardcoded here at their defaults (16 /
                 16 / 6), which held only while the user left every metric
                 alone - change the indent width, or zoom the font, and the
                 favorites panel alone stayed put while the tree moved. -->
            <!-- ApplyLayoutMetrics in MainWindow.xaml.cs is what recomputes all
                 of them; everything here is DynamicResource so it lands live. -->
            <Setter Property="Padding"
                    Value="{DynamicResource RowPadding}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="ContextMenu"
                    Value="{StaticResource FavoriteItemContextMenu}"/>
            <EventSetter Event="PreviewMouseRightButtonDown"
                    Handler="FavoriteListBoxItem_PreviewMouseRightButtonDown"/>
            <EventSetter Event="PreviewMouseLeftButtonDown"
                    Handler="FavoriteListBoxItem_PreviewMouseLeftButtonDown"/>
            <!-- Favorites are a flat list of folder NAMES, so several entries
                 can read identically ("dist", "src", ...) with nothing on
                 screen to tell them apart - the one place in the app where the
                 full path is information the window doesn't already show. The
                 tree deliberately has no such tooltip: its rows sit under
                 their own parents, so the path is already visible there.
                 Delay is longer than the WPF default so brushing past a row on
                 the way somewhere else doesn't pop anything up, and the font
                 follows the tree's zoom through the placement target (a
                 tooltip is its own window, outside the tree's visual tree, so
                 it inherits nothing on its own). -->
            <Setter Property="ToolTipService.InitialShowDelay"
                    Value="900"/>
            <Setter Property="ToolTipService.ShowDuration"
                    Value="20000"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Content="{Binding Path}"
                            FontSize="{Binding PlacementTarget.FontSize, RelativeSource={RelativeSource Self}}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Stands in for the tree row's own expander column,
                                         which is a separate column from its icon and so
                                         never collapses. Split out from the icon's own
                                         margin so the text after a hidden icon still lines
                                         up with the tree's text (which starts right after
                                         its expander) instead of collapsing flush left with
                                         everything else in it. Shares ExpanderColumn's
                                         TabSpacingWidth rather than hardcoding its default
                                         width, so the "들여쓰기 간격" option moves favorites and
                                         tree rows together. -->
                                    <ColumnDefinition Width="{DynamicResource TabSpacingWidth}"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Favorites are always folders (see AddFavorite's
                                     IsDirectory check), so this can react to
                                     FolderIconVisibility unconditionally - no
                                     IsDirectory check needed the way the tree
                                     row's icon has one. -->
                                <!-- Source is a code-set DynamicResource (not the
                                     folder.png pack URI it used to hardcode) so
                                     the "아이콘 방식" switch swaps the favorites'
                                     folder icon along with the tree's - set at
                                     startup and on every mode change in
                                     MainWindow.ApplyIconStyle. -->
                                <Image Grid.Column="1"
                                        Source="{DynamicResource FavoriteFolderIconSource}"
                                        Width="{DynamicResource IconSize}"
                                        Height="{DynamicResource IconSize}"
                                        Margin="{DynamicResource FolderRowIconMargin}"
                                        VerticalAlignment="Center"
                                        Visibility="{DynamicResource FolderIconVisibility}"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>
                                <!-- FontSize intentionally not set here - inherits down
                                     from FavoritesList, same reasoning as the tree's row
                                     TextBlock (see the HierarchicalDataTemplate above). -->
                                <TextBlock x:Name="FavoriteNameText"
                                        Grid.Column="2"
                                        Text="{Binding DisplayName}"
                                        Foreground="{DynamicResource FolderNameForeground}"
                                        FontWeight="{DynamicResource FolderNameFontWeight}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <!-- FavoriteNameText's own Foreground binding (above) would
                                     otherwise win over inheritance, so this has to target it
                                     directly rather than setting ListBoxItem.Foreground. -->
                                <Setter TargetName="FavoriteNameText"
                                        Property="Foreground"
                                        Value="{DynamicResource FolderNameHoverForeground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowSelectedActiveBackground}"/>
                                <!-- The name follows too, as it does in the
                                     tree. "폴더 이름 강조" says nothing about
                                     only applying to one of the two places a
                                     folder name is shown. Same targeting note
                                     as the hover setter above: the TextBlock's
                                     own Foreground would beat inheritance. -->
                                <Setter TargetName="FavoriteNameText"
                                        Property="Foreground"
                                        Value="{DynamicResource FolderNameHighlightForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="BookmarkPanelItemContextMenu"
                Style="{StaticResource DarkContextMenuStyle}"
                Opened="AnyMenu_Opened"
                Closed="AnyMenu_Closed"
                PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp">
            <MenuItem Header="{x:Static services:Strings.MenuBookmarkRemove}"
                    Click="RemoveBookmarkFromPanel_Click"/>
        </ContextMenu>

        <!-- The favorites row's twin, for when the panel is showing bookmarks
             (AppSettings.SidePanelMode). Kept as its OWN style rather than
             teaching the favorites one to serve both: the favorites row is
             folder-only, drag-reorderable and bound straight to the stored
             entries, and every one of those is different here. The metrics are
             shared through the same resources, so both still line up with the
             tree rows underneath.

             Two things it has that the favorites row does not: a number, and a
             marker for where the Ctrl+Alt+L/J cycle is standing. -->
        <Style x:Key="BookmarkPanelItemStyle"
                TargetType="ListBoxItem">
            <Setter Property="Padding"
                    Value="{DynamicResource RowPadding}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="ContextMenu"
                    Value="{StaticResource BookmarkPanelItemContextMenu}"/>
            <EventSetter Event="PreviewMouseRightButtonDown"
                    Handler="BookmarkPanelItem_PreviewMouseRightButtonDown"/>
            <!-- Same reasoning as the favorites tooltip: a flat list of leaf
                 names, where several rows can read identically. -->
            <Setter Property="ToolTipService.InitialShowDelay"
                    Value="900"/>
            <Setter Property="ToolTipService.ShowDuration"
                    Value="20000"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Content="{Binding Path}"
                            FontSize="{Binding PlacementTarget.FontSize, RelativeSource={RelativeSource Self}}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Just the marker and a hair of air after
                                         it, NOT the tree's full indent
                                         stand-in: the number column is already
                                         width this row's favorites twin does
                                         not spend, and starting the content
                                         further in on top of that pushed it
                                         visibly away from the marker
                                         (2026-08-02). -->
                                    <ColumnDefinition Width="{DynamicResource PanelMarkerColumnWidth}"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Where Ctrl+Alt+L/J is standing right now.
                                     Same blue as the ribbon marker the tree
                                     draws on a bookmarked row, so the two read
                                     as one feature. A bar rather than a
                                     background because selection already owns
                                     the row background, and the two answer
                                     different questions - what you last
                                     clicked, versus where the cycle is. -->
                                <Border x:Name="CycleMarker"
                                        Grid.Column="0"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="#FF4A90E2"
                                        Visibility="Hidden"/>

                                <!-- Counted from the top, so it is also how many
                                     presses away the row is. A smaller font
                                     rather than a faded one - dimming text to
                                     mark it as secondary is not done in this
                                     app. -->
                                <TextBlock x:Name="BookmarkNumberText"
                                        Grid.Column="1"
                                        Text="{Binding Number}"
                                        Foreground="{DynamicResource ShowMoreForeground}"
                                        FontSize="{DynamicResource PanelNumberFontSize}"
                                        MinWidth="{DynamicResource PanelNumberWidth}"
                                        TextAlignment="Right"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"/>

                                <Image x:Name="BookmarkRowIcon"
                                        Grid.Column="2"
                                        Source="{Binding Icon}"
                                        Width="{DynamicResource IconSize}"
                                        Height="{DynamicResource IconSize}"
                                        Margin="{DynamicResource FolderRowIconMargin}"
                                        VerticalAlignment="Center"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>

                                <TextBlock x:Name="BookmarkNameText"
                                        Grid.Column="3"
                                        Text="{Binding Name}"
                                        FontWeight="{DynamicResource FolderNameFontWeight}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis">
                                    <!-- The name's COLOUR is decided here, on
                                         the element itself, rather than in the
                                         template's triggers below. It depends
                                         on the row's state and on what the row
                                         holds at once, and only a binding that
                                         starts from an element can reach the
                                         row: a Condition in
                                         ControlTemplate.Triggers has nothing to
                                         walk up from, and the TemplatedParent
                                         form of it simply never fires - which
                                         looks exactly like a colour nobody
                                         wired, since a trigger that cannot bind
                                         fails in silence (2026-08-04).
                                         From here, FindAncestor reaches the
                                         ListBoxItem the same way every other
                                         binding in this template reaches its
                                         data. Order is base, then file, then
                                         hover, then selection: the last match
                                         wins, so a selected row keeps its
                                         colour while the pointer crosses it. -->
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource FolderNameForeground}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirectory}"
                                                        Value="False">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource FileNameForeground}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                Value="True"/>
                                                        <Condition Binding="{Binding IsDirectory}"
                                                                Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource FolderNameHoverForeground}"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                Value="True"/>
                                                        <Condition Binding="{Binding IsDirectory}"
                                                                Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource FileNameHoverForeground}"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                Value="True"/>
                                                        <Condition Binding="{Binding IsDirectory}"
                                                                Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource FolderNameHighlightForeground}"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                Value="True"/>
                                                        <Condition Binding="{Binding IsDirectory}"
                                                                Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource FileNameHighlightForeground}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Weight only. The colour moved to the element's
                                 own style (see BookmarkNameText above) and must
                                 not also be set from here: a template trigger
                                 outranks a style trigger, so leaving this in
                                 would pin the file colour on and the hover and
                                 selection colours would never show. -->
                            <DataTrigger Binding="{Binding IsDirectory}"
                                    Value="False">
                                <Setter TargetName="BookmarkNameText"
                                        Property="FontWeight"
                                        Value="{DynamicResource FileNameFontWeight}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}"
                                    Value="True">
                                <Setter TargetName="CycleMarker"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                            <!-- Icons turned off: the SLOT goes with the icon,
                                 same as the tree, so the names keep their
                                 column instead of sitting behind an empty gap.
                                 A null Source is how the row says so. -->
                            <DataTrigger Binding="{Binding Icon}"
                                    Value="{x:Null}">
                                <Setter TargetName="BookmarkRowIcon"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>
                            <!-- No matching IsDirectory=True trigger: the folder
                                 colour is already the setter above, and in WPF
                                 the LAST matching trigger wins - a redundant
                                 pair here is exactly how the NAS greying lost
                                 to the file/folder colours in July. -->
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowSelectedActiveBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FavoritesList otherwise falls back to the default ListBox chrome
             (stock Windows scrollbar) since it only had ItemContainerStyle set;
             reusing MinimalScrollViewerTemplate here matches the tree below. -->
        <Style x:Key="FavoritesListBoxStyle"
                TargetType="ListBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Focusable="False"
                                    Padding="{TemplateBinding Padding}"
                                    Template="{StaticResource MinimalScrollViewerTemplate}"
                                    CanContentScroll="True"
                                    HorizontalScrollBarVisibility="{Binding Path=(ScrollViewer.HorizontalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}"
                                    VerticalScrollBarVisibility="{Binding Path=(ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search result rows (the two-line "folder path over filename" entries
             in the Ctrl+F search view). Own hover/selection highlight and the
             bottom margin that spaces one result from the next, since the
             default ListBoxItem chrome would clash with the rest of the app's
             hand-themed look. -->
        <Style x:Key="SearchResultItemStyle"
                TargetType="ListBoxItem">
            <Setter Property="Padding"
                    Value="{DynamicResource SearchRowPadding}"/>
            <Setter Property="Margin"
                    Value="0,0,0,3"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="ContextMenu"
                    Value="{StaticResource SearchResultContextMenu}"/>
            <!-- Same hover contract as the tree rows and the panel lists: the
                 delay is long enough that brushing past on the way somewhere
                 else pops nothing up, and the font follows the placement target
                 because a tooltip is its own window and inherits nothing. The
                 surface itself comes from the implicit ToolTip style. -->
            <Setter Property="ToolTipService.InitialShowDelay"
                    Value="900"/>
            <Setter Property="ToolTipService.ShowDuration"
                    Value="20000"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Content="{Binding TooltipPath}"
                            FontSize="{Binding PlacementTarget.FontSize, RelativeSource={RelativeSource Self}}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowSelectedActiveBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- The synthetic "… 더 보기 (N개)" row stands for no path at
                     all, so it gets no tooltip - a blank one popping up over it
                     would read as a fault. -->
                <DataTrigger Binding="{Binding IsShowMore}"
                        Value="True">
                    <Setter Property="ToolTipService.IsEnabled"
                            Value="False"/>
                </DataTrigger>
                <!-- Folder header rows are labels, not targets: no hand cursor,
                     no hover/selection highlight (IsHitTestVisible=False also
                     lets a click land through to nothing rather than selecting
                     a header), skipped by keyboard nav (Focusable=False), and
                     tucked close to the files beneath them. -->
                <DataTrigger Binding="{Binding IsHeader}"
                        Value="True">
                    <Setter Property="Cursor"
                            Value="Arrow"/>
                    <Setter Property="Focusable"
                            Value="False"/>
                    <Setter Property="IsHitTestVisible"
                            Value="False"/>
                    <Setter Property="Margin"
                            Value="0,3,0,0"/>
                    <Setter Property="Padding"
                            Value="8,2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Recent-search dropdown rows (history Popup under the search box). -->
        <Style x:Key="SearchHistoryItemStyle"
                TargetType="ListBoxItem">
            <Setter Property="Padding"
                    Value="8,4"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Single cell, not a content-column + dedicated resize-grip-column split:
         a reserved "6" column stayed 6px wide even while docked with the grip
         sitting idle (Background="Transparent" at rest - see ResizeThumbStyle),
         so the sidebar's real content never reached the window's true right
         edge. The Thumb below now overlays the content instead, the same fix
         already applied to the scrollbars for the same reason. -->
    <Grid x:Name="RootContent">
        <!-- The auto-hide peek slides by moving THIS, not the window. A window
             positioned off the screen edge is not drawn out there, so sliding
             one in makes Windows hand the app a freshly exposed strip to paint
             on every frame - which is what showed up as an unfinished, smearing
             sidebar (2026-08-05). Translating content inside a window that is
             already fully on screen is a composition-thread matrix change: the
             tree is rendered once and then simply shown at a different offset.
             See MainWindow.SlideContentTo. -->
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ContentSlide"/>
        </Grid.RenderTransform>
        <Grid Background="{DynamicResource SidebarBackground}">
            <!-- Three columns for the image viewer panel: the sidebar content
                 lives in the middle column, and the two outer columns are
                 where the viewer opens - right column normally, LEFT column
                 when docked on the screen's right edge, so the panel always
                 grows toward the screen's interior and the tree stays put at
                 the edge (see OpenViewer). Both stay 0 while the viewer is
                 closed, so this grid measures exactly as the original
                 single-column layout did - which is why the tree is declared
                 STAR here.
                 While the viewer is OPEN the roles invert: the tree takes a
                 fixed width and the open panel becomes the star column. See
                 SetViewerColumns, which owns every write to these three and
                 explains why. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ViewerColumnLeft"
                        Width="0"/>
                <ColumnDefinition x:Name="TreeColumn"
                        Width="*"/>
                <ColumnDefinition x:Name="ViewerColumnRight"
                        Width="0"/>
            </Grid.ColumnDefinitions>
            <!-- Row1/Row3 are deliberately neutral names, not "FavoritesRow"/
                 "TreeRow": which one actually hosts the favorites panel vs the
                 tree depends on the "즐겨찾기를 아래에 표시" option (see
                 ApplyFavoritesPosition in code-behind), which swaps both the
                 Grid.Row of FavoritesList/ExplorerTree below AND which of
                 these two RowDefinitions gets the content-fit-height treatment
                 vs Height="*" - MainWindow.xaml.cs's FavoritesRowDef/TreeRowDef
                 properties are the single source of truth for "which is which"
                 right now. FavoritesSplitterRow's own Grid.Row never changes -
                 it always sits between whichever row is on top and whichever
                 is on bottom. -->
            <Grid.RowDefinitions>
                <!-- Fixed, not Auto - so hiding the header alone leaves the row
                     behind as a 36px band of background at the top of the
                     window. The viewer's full cover zeroes this height itself
                     (SetViewerFullscreen) and puts it back on the way out. -->
                <RowDefinition x:Name="HeaderRow"
                        Height="36"/>
                <RowDefinition x:Name="Row1"
                        Height="0"/>
                <RowDefinition x:Name="FavoritesSplitterRow"
                        Height="0"/>
                <RowDefinition x:Name="Row3"
                        Height="*"/>
                <!-- Auto, not the fixed 20 it was: the footer carries the file
                     -kind toggles now, and on a narrow window they wrap to a
                     second line. A fixed height would cut that line off. -->
                <RowDefinition x:Name="VersionFooterRow"
                        Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header. Also doubles as the drag handle: while docked, dragging it
                 past the system drag threshold detaches the window into a free-
                 floating one (see HeaderGrid_MouseMove); once floating, WindowChrome's
                 CaptionHeight takes over native dragging on this same area. -->
            <!-- IsHitTestVisibleInChrome matters here specifically because of
                 CaptionHeight: while docked it's 0 (the whole window is already
                 plain client area, so this has no effect), but once floating
                 WindowChrome sets CaptionHeight to HeaderHeight and, without this,
                 treats this whole Grid as native OS caption territory - meaning
                 clicks here (everywhere except the buttons below, which already
                 had this set individually) never reached our own MouseLeftButtonDown
                 handler at all. They fell straight through to Windows' own default
                 caption handling instead, which explains why double-clicking here
                 while floating maximized the window instead of running our
                 dock-toggle logic (see HeaderGrid_MouseLeftButtonDown) - and why,
                 had this masked drag behavior ever actually needed exercising while
                 already floating, it would have used native OS move-window
                 dragging rather than our own DragMove() call below. -->
            <Grid x:Name="HeaderGrid"
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Background="{DynamicResource HeaderBackground}"
                    MouseLeftButtonDown="HeaderGrid_MouseLeftButtonDown"
                    MouseMove="HeaderGrid_MouseMove"
                    MouseLeftButtonUp="HeaderGrid_MouseLeftButtonUp"
                    ContextMenu="{StaticResource HeaderContextMenu}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- The strip the six header buttons sit in is not a drag
                     handle. Their gaps are 2-4px, and the header's drag only
                     needs the system threshold to be crossed - easy to do by
                     accident on a target that small - so a slightly wandering
                     click on the space BETWEEN two buttons was undocking the
                     window. Declared before the buttons so they stay on top and
                     keep their own clicks; this only ever sees the misses, and
                     swallows them. -->
                <Border Grid.Column="2"
                        Grid.ColumnSpan="6"
                        Background="Transparent"
                        MouseLeftButtonDown="HeaderButtonStrip_MouseLeftButtonDown"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <!-- Pure branding since 2026-07-23: this was the auto-hide
                     toggle for a while (the pin was greyed out when docked),
                     but once the pin became the real pinned/auto-hide toggle
                     the icon doing the same thing invisibly was exactly the
                     kind of confusion the pin change was for - one state,
                     one control. -->
                <Image x:Name="AppIcon"
                        Grid.Column="0"
                        Source="pack://application:,,,/Resources/icon.png"
                        Width="20"
                        Height="20"
                        Margin="8,0,6,0"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="RootPathText"
                        Grid.Column="1"
                        Text="{x:Static services:Strings.RootPathLabel}"
                        Foreground="{DynamicResource ForegroundText}"
                           VerticalAlignment="Center"
                        Margin="2,0,8,0"
                        FontSize="15"
                        FontWeight="Bold"
                        Opacity="0.75"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Search toggle. Swaps the whole content area below the header
                     between the explorer tree and the file-search view (see
                     ToggleSearchView / SetSearchViewActive in code-behind); the
                     glyph itself flips between a magnifier and a left chevron
                     ("back to explorer") the same way CollapseAllButton swaps
                     its arrow Data. -->
                <!-- Column 3, not 2: the pin sits first (2026-07-22)
                     - the two swapped columns, everything else untouched. -->
                <Button x:Name="SearchButton"
                        Grid.Column="3"
                        Style="{StaticResource ToggleButtonStyle}"
                        Click="SearchButton_Click"
                        Margin="{DynamicResource HeaderButtonMargin}"
                        RenderTransform="{StaticResource ShiftUp1px}"
                        ToolTip="{x:Static services:Strings.ToolTipSearch}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Material Symbols "search" (2026-08-10),
                         and the back state it swaps to is "chevron_left" - the
                         same path the viewer's carousel already uses, so that
                         one needed no new file. Both are FILLED now where the
                         pair used to be stroked arcs and lines, which is what
                         lets the two states share one Path element and take
                         ForegroundText like the rest of the family.
                         See SearchGlyphMagnifier / SearchGlyphBack. -->
                    <Path x:Name="SearchButtonIcon"
                            Data="M765-144 526-383q-30 22-65.79 34.5-35.79 12.5-76.18 12.5Q284-336 214-406t-70-170q0-100 70-170t170-70q100 0 170 70t70 170.03q0 40.39-12.5 76.18Q599-464 577-434l239 239-51 51ZM384-408q70 0 119-49t49-119q0-70-49-119t-119-49q-70 0-119 49t-49 119q0 70 49 119t119 49Z M0-960H960M0 0H960"
                            Fill="{DynamicResource ForegroundText}"
                            Stretch="Uniform"
                            Width="{DynamicResource HeaderGlyphBox}"
                            Height="{DynamicResource HeaderGlyphBox}"
                            RenderTransformOrigin="0.5,0.5"
                            RenderTransform="{StaticResource HeaderGlyphGrow}"/>
                </Button>
                <Button x:Name="PinButton"
                        Grid.Column="2"
                        Style="{StaticResource ToggleButtonStyle}"
                        Click="PinButton_Click"
                        Margin="{DynamicResource HeaderButtonMargin}"
                        Visibility="Collapsed"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Material Symbols "keep" / "keep_off" (
                         2026-08-10). The pin was already this family's "keep",
                         but from a separately downloaded file and shown in TWO
                         STATES BY ROTATION: upright = pinned open, lying on its
                         side = auto-hiding, which is the tool-window pushpin
                         language Visual Studio and friends use.

                         Now it is two whole shapes, the way play/pause and the
                         mute toggle in the viewer already work. What that
                         trades: the rotation is a convention people who use
                         docked tool windows already know, while a struck-out
                         pin says "not pinned" to someone who knows no
                         convention at all - and the glyph is 13px, where a 90
                         degree turn is a small difference to read. See
                         UpdatePinButtonVisibility.

                         It used to set Height alone, on the reasoning that a
                         square box would fit this tall narrow shape by its
                         height and leave it half the magnifier's width. The
                         960 box makes that rule unnecessary AND wrong: every
                         glyph now takes the same square box and Material's own
                         proportions decide the rest, which is what finally made
                         the pin stop reading as the small one. -->
                    <Path x:Name="PinButtonIcon"
                            Data="m624-480 96 96v72H516v228l-36 36-36-36v-228H240v-72l96-96v-264h-48v-72h384v72h-48v264Zm-282 96h276l-66-66v-294H408v294l-66 66Zm138 0Z M0-960H960M0 0H960"
                            Fill="{DynamicResource ForegroundText}"
                            Stretch="Uniform"
                            Width="{DynamicResource HeaderGlyphBox}"
                            Height="{DynamicResource HeaderGlyphBox}"
                            RenderTransformOrigin="0.5,0.5"
                            RenderTransform="{StaticResource HeaderGlyphGrow}"/>
                </Button>
                <!-- The image viewer toggle - opens/closes the preview panel
                     beside the tree (see OpenViewer/CloseViewer). On the same
                     hand-built 16-unit box as the magnifier.
                     A PICTURE, not the eye it started as: an eye is the
                     general "preview" sign, and it promised the panel could
                     show the contents of any file (2026-08-09) - which
                     it can't; anything that isn't an image gets its shell
                     icon. The tooltip already said 이미지 뷰어 and that was
                     not enough, which is the usual result of leaving the
                     correction to a tooltip. -->
                <Button x:Name="ViewerButton"
                        Grid.Column="4"
                        Style="{StaticResource ToggleButtonStyle}"
                        Click="ViewerButton_Click"
                        Margin="{DynamicResource HeaderButtonMargin}"
                        RenderTransform="{StaticResource ShiftUp1px}"
                        ToolTip="{x:Static services:Strings.ToolTipViewer}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Material Symbols "image" (Resources/Icons/image_16dp_
                         E3E3E3_FILL0_wght400_GRAD0_opsz24.svg), chosen after
                         the hand-drawn one stood out against its neighbours.
                         The weight was settled by eye against the arithmetic
                         and the arithmetic won: this app's glyphs are 1.4 in a
                         16 box = 8.8%, 400/24 works out at about 8.3%, and it
                         is the one that sits right. 500/20 read heavy; 300/24
                         was tried after it and read worse the other way
                         ("이건 더 이상하네요"), so 400 it is. Smaller opsz
                         thickens the stroke at the same weight, which is why
                         both axes have to be picked together - 24 throughout.
                         The dp in the filename is irrelevant: every download
                         gives the same 960-box path.
                         STRETCH="UNIFORM" IS WHAT MAKES IT VISIBLE: Material's
                         paths live in a 960 box with NEGATIVE y, and a Path
                         defaults to Stretch="None" - the geometry is then drawn
                         at those literal coordinates, entirely outside the
                         element's own box, and clipped away to nothing. Uniform
                         normalises it into the Width/Height below instead,
                         which is also why no Viewbox is needed.
                         13, not 16: Stretch fits the path's BOUNDS, dropping
                         the padding the 960 box builds in, and the neighbouring
                         hand-drawn glyphs sit inset by about that much. -->
                    <Path Data="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h560q33 0 56.5 23.5T840-760v560q0 33-23.5 56.5T760-120H200Zm0-80h560v-560H200v560Zm40-80h480L570-480 450-320l-90-120-120 160Zm-40 80v-560 560Z M0-960H960M0 0H960"
                            Fill="{DynamicResource ForegroundText}"
                            Stretch="Uniform"
                            Width="{DynamicResource HeaderGlyphBox}"
                            Height="{DynamicResource HeaderGlyphBox}"
                            RenderTransformOrigin="0.5,0.5"
                            RenderTransform="{StaticResource HeaderGlyphGrow}"/>
                </Button>
                <Button x:Name="CollapseAllButton"
                        Grid.Column="5"
                        Style="{StaticResource ToggleButtonStyle}"
                        Click="CollapseAllButton_Click"
                        Margin="{DynamicResource HeaderButtonMargin}"
                        RenderTransform="{StaticResource ShiftUp1px}"
                        ToolTip="{x:Static services:Strings.ToolTipCollapseAll}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Material Symbols "chevron_line_up" (
                         2026-08-10), replacing a hand-drawn filled triangle.
                         The ceiling line is what the triangle never said: this
                         folds everything UP TO the top, it is not a direction.

                         The restore state is the SAME path mirrored, by a
                         ScaleTransform this button owns - not a second icon.
                         That keeps the pair exactly each other's reflection,
                         which is what the two triangles were chosen for in the
                         first place, and it stays an instant swap rather than
                         an animated rotation (which visibly swung the old
                         glyph sideways mid-flip). The shared grow transform
                         rides in the group so this glyph keeps the size
                         stepping its siblings have - same arrangement the pin
                         beside it uses. -->
                    <Path x:Name="CollapseAllArrow"
                            Data="M288-600v-72h384v72H288Zm51 363-51-51 192-192 192 192-51 51-141-141-141 141Z M0-960H960M0 0H960"
                            Fill="{DynamicResource ForegroundText}"
                            Stretch="Uniform"
                            Width="{DynamicResource HeaderGlyphBox}"
                            Height="{DynamicResource HeaderGlyphBox}"
                            RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CollapseAllFlip"
                                        ScaleY="1"/>
                                <StaticResource ResourceKey="HeaderGlyphGrow"/>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                </Button>
                <Button x:Name="OptionsButton"
                        Grid.Column="6"
                        Style="{StaticResource ToggleButtonStyle}"
                        Click="OptionsButton_Click"
                        Margin="{DynamicResource HeaderButtonMargin}"
                        ToolTip="{x:Static services:Strings.ToolTipOptions}"
                        ContextMenu="{StaticResource OptionsMenu}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid>
                        <!-- Material Symbols "more_horiz" (
                             2026-08-10). The same three dots the hand-built
                             version drew, which is exactly why it is worth
                             swapping: three Ellipses at 3px with 1px margins
                             were a guess at the family's spacing, and this is
                             the family's spacing. -->
                        <Path Data="M263.79-408Q234-408 213-429.21t-21-51Q192-510 213.21-531t51-21Q294-552 315-530.79t21 51Q336-450 314.79-429t-51 21Zm216 0Q450-408 429-429.21t-21-51Q408-510 429.21-531t51-21Q510-552 531-530.79t21 51Q552-450 530.79-429t-51 21Zm216 0Q666-408 645-429.21t-21-51Q624-510 645.21-531t51-21Q726-552 747-530.79t21 51Q768-450 746.79-429t-51 21Z M0-960H960M0 0H960"
                                Fill="{DynamicResource ForegroundText}"
                                Stretch="Uniform"
                                Width="{DynamicResource HeaderGlyphBox}"
                                Height="{DynamicResource HeaderGlyphBox}"
                                RenderTransformOrigin="0.5,0.5"
                                RenderTransform="{StaticResource HeaderGlyphGrow}"/>
                        <!-- Update-available indicator: lit by
                             CheckForUpdateOnceAsync when GitHub's latest
                             release is newer than this build. Display only -
                             clicking stays the normal options menu. -->
                        <!-- Nudged further up-right than its first placement
                             (-2,-3): the 15% glyph grow widened the "..." and
                             the dot read as overlapping its last dot
                             (reported on the live v1.2.1 update test). -->
                        <Ellipse x:Name="UpdateAvailableDot"
                                Width="5"
                                Height="5"
                                Fill="{DynamicResource AccentForeground}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-7,-5,0"
                                Visibility="Collapsed"/>
                    </Grid>
                </Button>
                <!-- The tray-minimise button used to sit here, between the
                     options "..." and the close X. It moved into the options
                     menu (2026-08-10): it was a one-click way to make
                     the whole window disappear, parked between the two header
                     buttons that actually get used, and a slipped click sent
                     the app to the tray. Nothing about it needed to be one
                     click - see the menu item above 다시 시작.
                     Every threshold in ApplyHeaderMetrics came down by one
                     button's width when it went. -->
                <!-- A few extra pixels on the right (vs. every other header
                     button's uniform 2px) so the X glyph reads as centered in
                     its own hit-box instead of crowding the window's true
                     right edge. -->
                <Button x:Name="CloseButton"
                        Grid.Column="7"
                        Style="{StaticResource ToggleButtonStyle}"
                        Click="CloseButton_Click"
                        Margin="{DynamicResource HeaderCloseButtonMargin}"
                        RenderTransform="{StaticResource ShiftUp2px}"
                        ToolTip="{x:Static services:Strings.ToolTipPutAway}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Material Symbols "minimize" (2026-08-11).
                         It was a "close" X until this button stopped closing
                         anything - it puts the sidebar away now, in whichever
                         way the current mode offers - and an X that ends
                         nothing is a drawing that lies.

                         Three better-sounding candidates were rejected,
                         each for the same reason and each correctly:
                         keyboard_double_arrow_right collides with the PIN,
                         which already says which edge things go to;
                         close_fullscreen with the viewer's full screen;
                         right_panel_close with the viewer toggle, which is
                         literally a panel switch. Meaning alone is not enough -
                         a glyph has to be read against its NEIGHBOURS.

                         "minimize" and not the "remove" bar this app already
                         carries for zoom-out: remove's bar is centred, and it
                         is the LOW bar that means a window put away. -->
                    <Path Data="M288-144v-72h384v72H288Z M0-960H960M0 0H960"
                            Fill="{DynamicResource ForegroundText}"
                            Stretch="Uniform"
