                        <Button x:Name="SearchHistoryButton"
                                Grid.Column="1"
                                Style="{StaticResource ToggleButtonStyle}"
                                Width="22"
                                Height="20"
                                VerticalAlignment="Center"
                                Margin="0,0,3,0"
                                Click="SearchHistoryButton_Click"
                                ToolTip="{x:Static services:Strings.SearchTooltipHistory}">
                            <!-- Material Symbols "list_arrow" (
                                 2026-08-10), replacing a bare down-chevron.
                                 The chevron only said "down"; this says a LIST
                                 comes down, which is what the button opens -
                                 and it stops reading as the same caret the
                                 tree's expanders use for something else
                                 entirely. -->
                            <Path Data="M240-192 96-336l50-50 58 57v-391h72v391l57-57 51 50-144 144Zm240-48v-72h384v72H480Zm0-204v-72h384v72H480Zm0-204v-72h384v72H480Z M0-960H960M0 0H960"
                                    Fill="{DynamicResource ForegroundText}"
