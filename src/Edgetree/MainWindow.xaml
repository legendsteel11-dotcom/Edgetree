            <!-- Where a dragged favorite would land. Sits over the list rather
                 than inside the item template so it can be drawn BETWEEN two
                 rows, and never takes a hit-test - the drag needs every mouse
                 event to keep reaching the list underneath. Positioned from
                 code (FavoritesReorder region). -->
            <Border x:Name="FavoriteDropIndicator"
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="2"
                    Margin="0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
