                                <ListBox x:Name="SearchHistoryList"
                                        Style="{StaticResource FavoritesListBoxStyle}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        MaxHeight="220"
                                        Padding="2"
                                        ItemContainerStyle="{StaticResource SearchHistoryItemStyle}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        PreviewMouseLeftButtonUp="SearchHistoryList_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                        Text="{Binding}"
                                                        Foreground="{DynamicResource DialogForeground}"
                                                        FontSize="12"
                                                        VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"/>
                                                <!-- Per-entry delete. Handled on its own Click;
                                                     the list's PreviewMouseLeftButtonUp skips
                                                     clicks that land on a Button so this doesn't
                                                     also fill the search box. -->
                                                <Button Grid.Column="1"
                                                        Width="18"
                                                        Height="18"
                                                        Margin="6,0,0,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="{x:Static services:Strings.SearchHistoryDeleteTooltip}"
                                                        Click="SearchHistoryDelete_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd"
                                                                    Background="Transparent"
                                                                    CornerRadius="3">
                                                                <Path Data="M3,3 L9,9 M9,3 L3,9"
                                                                        Stroke="{DynamicResource SecondaryForeground}"
                                                                        StrokeThickness="1.3"
                                                                        StrokeStartLineCap="Round"
                                                                        StrokeEndLineCap="Round"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                        Value="True">
                                                                    <Setter TargetName="Bd"
                                                                            Property="Background"
                                                                            Value="{DynamicResource HoverBackground}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                </StackPanel>

                <!-- Status line: scanning progress / result count / hints.
                     Single line by design - this panel is narrow enough that
                     wrapping costs a whole second row for text that's usually
                     transient, so the strings are kept short instead and the
                     ellipsis below is only a backstop for the narrowest widths
                     (CharacterEllipsis, NOT MiddleEllipsis - that one compiles
                     but throws at runtime when the XAML is parsed). -->
                <StackPanel Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SearchStatusText"
                                Grid.Column="0"
                                Text="{x:Static services:Strings.SearchStatusEmpty}"
                                Foreground="{DynamicResource ShowMoreForeground}"
                                Opacity="0.8"
                                FontSize="11"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Margin="10,6,10,4"/>
                        <!-- Reindex sits at the end of the line it acts on. The
                             blue dot (not a blue glyph) says a change has been
                             seen inside the searched folder since this index was
                             built - see UpdateSearchRefreshIndicator. Same fixed
                             mid-blue as the bookmark ribbon and the update dot,
                             so "the app is pointing at something" stays one
                             colour rather than three. -->
                        <Button x:Name="SearchRefreshButton"
                                Grid.Column="1"
                                Style="{StaticResource ToggleButtonStyle}"
                                Width="24"
                                Height="20"
                                Margin="0,0,6,2"
                                VerticalAlignment="Center"
                                Click="SearchRefreshButton_Click"
                                ToolTip="{x:Static services:Strings.SearchTooltipRefresh}">
                            <Grid Width="15"
                                    Height="15">
                                <!-- Material Symbols "refresh" (
                                     2026-08-10). One path where this was an arc
                                     plus a separate arrowhead triangle - two
                                     shapes that had to be kept meeting each
                                     other by hand at every size. -->
                                <Path Data="M480-192q-120 0-204-84t-84-204q0-120 84-204t204-84q65 0 120.5 27t95.5 72v-99h72v240H528v-72h131q-29-44-76-70t-103-26q-90 0-153 63t-63 153q0 90 63 153t153 63q84 0 144-55.5T693-456h74q-9 112-91 188t-196 76Z M0-960H960M0 0H960"
                                        Fill="{DynamicResource ForegroundText}"
                                        Stretch="Uniform"
                                        Width="{DynamicResource HeaderGlyphBox}"
                                        Height="{DynamicResource HeaderGlyphBox}"/>
                                <!-- Pushed clear of the glyph (and a touch
                                     bigger): sitting against the arc it read as
                                     part of the drawing rather than as a mark on
                                     it. The button has the room - a 15px glyph
                                     in a 24x20 button leaves 4.5px each side. -->
                                <Ellipse x:Name="SearchRefreshStaleDot"
                                        Width="6"
                                        Height="6"
                                        Fill="#FF4A90E2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,-3,-2"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </Grid>
                    <!-- Below the status line, not above it. The results list's
                         own scrollbar lane draws a vertical divider down its
                         left edge (see MinimalScrollViewerTemplate), and that
                         line starts where the list starts - so a horizontal
                         divider sitting above the status text left the two
                         lines offset by the height of that text instead of
                         meeting in a corner. -->
                    <Border Height="1"
                            Background="{DynamicResource PanelDividerBrush}"/>
                    <!-- The pulsing progress bar that used to live here was
                         removed deliberately. A running indicator is the
                         universal idiom for "wait, don't touch anything" - and
                         search results actually stream in *during* the scan, so
                         it was talking users out of the one thing they could
                         already do. The status line's own live count carries
                         the "something is happening" job on its own, and now
                         says outright that searching already works. -->
                </StackPanel>

                <!-- Results: two lines per entry - dim italic folder path over
                     the filename. A single click previews the row in the image
                     panel and leaves the list standing; a double click goes to
                     it in the tree, which is what a single click did before the
                     panel existed (see SearchResultsList_PreviewMouseLeftButtonUp
                     and PreviewSearchResult). With the panel closed a single
                     click still goes to the tree. -->
                <ListBox x:Name="SearchResultsList"
                        Grid.Row="2"
                        Style="{StaticResource FavoritesListBoxStyle}"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        Padding="6,2,4,6"
                        ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        PreviewMouseLeftButtonDown="SearchResultsList_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="SearchResultsList_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="SearchResultsList_PreviewMouseLeftButtonUp"
                        PreviewMouseRightButtonDown="SearchResultsList_PreviewMouseRightButtonDown"
                        SelectionChanged="SearchResultsList_SelectionChanged"
                        KeyDown="SearchResultsList_KeyDown">
                    <ListBox.ItemTemplate>
                        <!-- One row is either a folder header or a file (see
                             Models/SearchRow). IsHeader swaps which line shows:
                             the folder path once, or an indented filename under
                             it. -->
                        <DataTemplate>
                            <Grid>
                                <!-- Folder header: folder icon (gated by the
                                     same ShowFolderIcons toggle as the tree) +
                                     path. -->
                                <StackPanel x:Name="HeaderPanel"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                                    <Image Source="{Binding Icon}"
                                            Width="{DynamicResource IconSize}"
                                            Height="{DynamicResource IconSize}"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Visibility="{DynamicResource FolderIconVisibility}"
                                            RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding DirectoryPath}"
                                            Foreground="{DynamicResource FolderNameForeground}"
                                            FontStyle="Italic"
                                            FontSize="{DynamicResource SearchHeaderFontSize}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <!-- File row: per-extension file icon (gated by
                                     ShowFileIcons) + name, indented under the
                                     folder header. -->
                                <StackPanel x:Name="FilePanel"
                                        Orientation="Horizontal"
                                        Margin="14,0,0,0">
                                    <!-- Cut marks bound as VALUES (SearchRow's
                                         CutOpacity / CutFontStyle), not as
                                         triggers: triggers here applied when a
                                         row was built but did not repaint a row
                                         already on screen when the mark changed
                                         under it. See the note on those
                                         properties. -->
                                    <Image x:Name="SearchRowIcon"
                                            Source="{Binding Icon}"
                                            Opacity="{Binding CutOpacity}"
                                            Width="{DynamicResource IconSize}"
                                            Height="{DynamicResource IconSize}"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Visibility="{DynamicResource FileIconVisibility}"
                                            RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <!-- Inlines built by SearchHighlightBehavior
                                         (matched run in the highlight color)
                                         instead of a plain Text binding. -->
                                    <TextBlock x:Name="SearchRowName"
                                            local:SearchHighlightBehavior.Row="{Binding}"
                                            Foreground="{DynamicResource FileNameForeground}"
                                            FontSize="{DynamicResource SearchFileFontSize}"
                                            FontStyle="{Binding CutFontStyle}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <!-- "… 더 보기 (N개)" - clickable, raises the page
                                     limit (SearchResultsList_PreviewMouseLeftButtonUp). -->
                                <TextBlock x:Name="ShowMoreText"
                                        Text="{Binding ShowMoreLabel}"
                                        Foreground="{DynamicResource ShowMoreForeground}"
                                        FontStyle="Italic"
                                        FontSize="{DynamicResource SearchHeaderFontSize}"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}"
                                        Value="True">
                                    <Setter TargetName="HeaderPanel"
                                            Property="Visibility"
                                            Value="Visible"/>
                                    <Setter TargetName="FilePanel"
                                            Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsShowMore}"
                                        Value="True">
                                    <Setter TargetName="FilePanel"
                                            Property="Visibility"
                                            Value="Collapsed"/>
                                    <Setter TargetName="ShowMoreText"
                                            Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Where the path strip goes while search is up. The strip is
                     ONE control that moves between here and the footer
                     (MovePathBarInto) rather than a second copy: every bit of
                     its behaviour - the dirty flag, the deepest-existing-path
                     walk, the click-away reset - hangs off that one box, and a
                     twin would have needed all of it parameterised to stay
                     honest.
                     Reparented because the search view covers the footer it
                     normally lives in (rows 1-4), and the footer stays covered
                     on purpose: the filter chips beside it act on the TREE, and
                     leaving them showing over a result list would read as
                     though they were filtering it. -->
                <Border x:Name="SearchPathBarHost"
                        Grid.Row="3"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource PanelDividerBrush}"
                        Visibility="Collapsed"/>
            </Grid>

            <!-- The image viewer panel (round 1). Lives in one of the two
                 zero-width outer columns declared at the top of this grid;
                 OpenViewer picks which (screen-interior side), sizes the
                 column and widens the window by the same amount, so opening
                 it never takes a pixel from the tree. Below the header row
                 only - the header spans all three columns above it. The
                 divider border side is set in code to face the tree. -->
            <!-- TWO PIXELS OFF THE TOP, and they are the header divider's
                 (2026-08-11). That line is drawn 2px below the header row on
                 purpose, so it lands inside whatever sits at the top of row 1 -
                 on the tree's side that is a list's background and nobody ever
                 saw it, but here a zoomed picture reaches the panel's own top
                 edge and the line lay ON the photograph. The inset puts the
                 panel's backdrop under the line instead, so it reads as a
                 boundary above the picture rather than a scratch across it.
                 Full screen clears this along with the border and the margins -
                 see SetViewerFullscreen, where every pixel goes back to the
                 picture. -->
            <Border x:Name="ViewerPanel"
                    Grid.Row="1"
                    Grid.RowSpan="4"
                    Grid.Column="2"
                    Visibility="Collapsed"
                    Padding="0,2,0,0"
                    Background="{DynamicResource ViewerBackground}"
                    BorderBrush="{DynamicResource PanelDividerBrush}"
                    BorderThickness="1,0,0,0"
                    PreviewMouseDown="ViewerPanel_PreviewMouseDown"
                    PreviewMouseMove="ViewerPanel_PreviewMouseMove"
                    MouseLeave="ViewerPanel_MouseLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <!-- The filmstrip. Auto, and collapsed when the strip is
                             off, so a viewer without one lays out exactly as it
                             did before this row existed. -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Zoom and pan (round 2) ride entirely on the Image's
                         RenderTransform - no re-layout and no re-decode in a
                         frame, which is the standing rule for anything that
                         runs while the mouse is moving. Stretch stays Uniform,
                         so WPF keeps doing the fit arithmetic for us and the
                         scale factor below is measured RELATIVE to fit: 1.0 is
                         the rest state, and 1:1 is whatever number makes the
                         bitmap's own pixels line up. The host Border is what
                         clips the zoomed-in image to the panel and what the
                         wheel and the drag listen on (an Image only gets mouse
                         events where it has actually drawn pixels, so the
                         letterboxed margins beside a wide picture would be
                         dead to both). -->
                    <Border x:Name="ViewerImageHost"
                            Grid.Row="0"
                            ClipToBounds="True"
                            Background="Transparent"
                            SizeChanged="ViewerImageHost_SizeChanged"
                            MouseWheel="ViewerImageHost_MouseWheel"
                            MouseDown="ViewerImageHost_MouseDown"
                            MouseLeftButtonDown="ViewerImageHost_MouseLeftButtonDown"
                            MouseMove="ViewerImageHost_MouseMove"
                            MouseLeftButtonUp="ViewerImageHost_MouseLeftButtonUp"
                            LostMouseCapture="ViewerImageHost_LostMouseCapture"
                            ContextMenuOpening="ViewerImageHost_ContextMenuOpening">
                        <!-- The picture's own right-click menu. Every file
                             action is the ROW menu's handler unchanged - the
                             viewer shows the tree's selection, so the row they
                             act on IS the picture on screen; the opening
                             handler suppresses the menu whenever that stops
                             being true (empty panel, icon fallback, or a
                             multi-selection, whose count the tree menu is the
                             one to announce). 배경 설정 is the one item of its
                             own, and only offered on a picture WIC actually
                             decoded (not a shell preview of a video/PSD). -->
                        <Border.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenuStyle}"
                                    Opened="AnyMenu_Opened"
                                    Closed="AnyMenu_Closed"
                                    PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp">
                                <!-- NOT the tree's bare "열기" (2026-08-11). In
                                     the tree that word is exactly right - it is
                                     Explorer's own verb and the row is not
                                     showing you anything yet. Here the file is
                                     already open, on the screen, being watched
                                     - so "열기" has nothing left to mean except
                                     "open something", which reads as a file
                                     dialog about to appear.
                                     Naming the destination fixes it, and the
                                     phrase is already in the app twice: the
                                     transport row's own external button and the
                                     line shown when a format will not play. The
                                     row below it (연결 프로그램) then reads as
                                     the pair it is - default, or choose.

                                     No "Enter" gesture on it: while a decoded
                                     image is showing, Enter is the full-screen
                                     toggle. -->
                                <MenuItem Header="{x:Static services:Strings.ViewerOpenExternally}"
                                        Click="OpenItem_Click"/>
                                <MenuItem x:Name="ViewerOpenWithItem"
                                        Header="{x:Static services:Strings.MenuOpenWith}"
                                        Click="OpenWithPicker_Click"/>
                                <MenuItem x:Name="ViewerSetWallpaperItem"
                                        Header="{x:Static services:Strings.MenuSetWallpaper}"
                                        Click="ViewerSetWallpaper_Click"/>
                                <!-- The playback group, shown only while a film
                                     is up. Play/pause and back-to-start are
                                     here as well as in the strip because a
                                     right-click is where a hand already is when
                                     the strip is at the other end of a tall
                                     panel - and because a menu that offers to
                                     mark a position while offering no way to
                                     start the film again reads as half a menu. -->
                                <Separator x:Name="ViewerPlaybackSeparator"
                                        Visibility="Collapsed"/>
                                <!-- The bookmarks come FIRST and are fenced off
                                     on their own (2026-08-11). They are the one
                                     thing in this menu that is about THIS film
                                     rather than about playing it - marking a
                                     place is a decision, where play, rewind,
                                     size and subtitles are all the same act of
                                     watching. Fencing them also puts the row a
                                     hand comes here for at the top of the
                                     group, instead of below four rows the strip
                                     already carries. -->
                                <MenuItem x:Name="ViewerMarkAddItem"
                                        Header="{x:Static services:Strings.ViewerMarkAdd}"
                                        InputGestureText="P · Insert"
                                        Click="ViewerMediaMark_Click"
                                        Visibility="Collapsed"/>
                                <!-- The film's own marks. Built when the menu
                                     opens (ViewerMarkSubmenu_Opened) and shown
                                     only for a video that has any - a submenu
                                     that is always there and usually empty is a
                                     row of nothing to read past. -->
                                <MenuItem x:Name="ViewerMarkListItem"
                                        Header="{x:Static services:Strings.ViewerMarkList}"
                                        SubmenuOpened="ViewerMarkSubmenu_Opened"
                                        Visibility="Collapsed">
                                    <MenuItem Header=""/>
                                </MenuItem>
                                <Separator x:Name="ViewerMarkSeparator"
                                        Visibility="Collapsed"/>
                                <MenuItem x:Name="ViewerPlayPauseItem"
                                        Header="{x:Static services:Strings.ViewerPlay}"
                                        InputGestureText="Space"
                                        Click="ViewerMediaPlayPause_Click"
                                        Visibility="Collapsed"/>
                                <MenuItem x:Name="ViewerRewindItem"
                                        Header="{x:Static services:Strings.ViewerRewind}"
                                        InputGestureText="Home"
                                        Click="ViewerMediaRewind_Click"
                                        Visibility="Collapsed"/>
                                <!-- The film's zoom, HERE and not in the strip:
                                     the transport row is full, and the zoom
                                     strip it would have joined is the one the
                                     transport row replaces (the two describe
                                     the same picture in ways that can't both
                                     apply). A menu row costs nothing until it
                                     is opened. StaysOpenOnClick so stepping
                                     through 50 → 75 → 100 is one visit rather
                                     than three; the numpad's +/- do the same
                                     job without opening anything. -->
                                <MenuItem x:Name="ViewerMediaZoomItem"
                                        StaysOpenOnClick="True"
                                        Focusable="False"
                                        Padding="{DynamicResource MenuStepperRowPadding}"
                                        Visibility="Collapsed">
                                    <!-- MenuRowActionButtonStyle, not the
                                         footer's chip style: a chip carries the
                                         footer's own ink at 0.65, and inside a
                                         popup that resolves against the VIEWER
                                         panel's derived inks - so the row came
                                         out barely legible on the menu's own
                                         surface (reported with a screenshot,
                                         2026-08-10). This style is the one the
                                         other in-menu buttons already use, and
                                         it takes MenuForeground.
                                         The leading label went with it: it said
                                         맞춤, which is also what the button at
                                         the far end says, so the row read as
                                         two of the same word around a number. -->
                                    <!-- Built exactly like the options menu's
                                         own steppers (글꼴 크기, 최대 항목 수):
                                         label on the left, the two boxed
                                         glyphs hard against each other on the
                                         right, MenuStepperButtonStyle for both.
                                         A first attempt used the menu's plain
                                         text-button style and it read as a
                                         different kind of control in the same
                                         menu (reported with a screenshot,
                                         2026-08-10) - one app, one stepper.

                                         No percentage between them, which is
                                         the one place this row departs from
                                         those two. The row stays open while it
                                         is stepped, and the readout is written
                                         by the zoom STRIP's update - which does
                                         not run while a film is up, because
                                         that strip is not on screen. A number
                                         that holds still while the picture
                                         grows is worse than no number, and the
                                         film itself is the readout. -->
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                    Text="{x:Static services:Strings.ViewerZoom}"
                                                    Foreground="{DynamicResource MenuForeground}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                                            <!-- 맞춤 sits in the slot the other
                                                 steppers give to the value, and
                                                 that is the right place for it:
                                                 what those rows READ OUT there,
                                                 this row lets you GO to. A
                                                 separate 맞춤 line underneath
                                                 was tried first and the pair
                                                 read as two unrelated controls
                                                 (2026-08-10). Auto width
                                                 on the middle one - the style's
                                                 square box is cut for a single
                                                 glyph. -->
                                            <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                                <Button Content="−"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerZoomOutButton_Click"/>
                                                <!-- The SAME fit mark the zoom
                                                     strip carries (Material
                                                     Symbols "fit_screen"),
                                                     not the word it used to
                                                     be. One idea drawn one way
                                                     wherever it appears: the
                                                     chip and this row do the
                                                     same thing and now say it
                                                     with the same shape, and a
                                                     word between two glyph
                                                     steppers was the last
                                                     place in the viewer where
                                                     an action was spelled out
                                                     rather than drawn. -->
                                                <!-- Box the size of its
                                                     neighbours, slot the width
                                                     of the readouts below:
                                                     MenuStepperMarkMargin is
                                                     the difference, split in
                                                     two. The style's own Width
                                                     is left alone, which is
                                                     what makes the three boxes
                                                     in this row identical. -->
                                                <Button Style="{StaticResource MenuStepperButtonStyle}"
                                                        Margin="{DynamicResource MenuStepperMarkMargin}"
                                                        ToolTip="{x:Static services:Strings.ViewerZoomFit}"
                                                        Click="ViewerFitChip_Click">
                                                    <Path Data="M792-576v-120H672v-72h120q30 0 51 21.15T864-696v120h-72Zm-696 0v-120q0-30 21.15-51T168-768h120v72H168v120H96Zm576 384v-72h120v-120h72v120q0 30-21.15 51T792-192H672Zm-504 0q-30 0-51-21.15T96-264v-120h72v120h120v72H168Zm72-144v-288h480v288H240Zm72-72h336v-144H312v144Zm0 0v-144 144Z"
                                                            Stretch="Uniform"
                                                            Width="{DynamicResource MenuChipFontSize}"
                                                            Height="{DynamicResource MenuChipFontSize}"
                                                            Fill="{Binding Foreground,
                                                                RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </Button>
                                                <Button Content="+"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerZoomInButton_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <!-- Both rows appear only when a subtitle file
                                     was actually found beside the film - there
                                     is nothing to switch on or size otherwise,
                                     and a permanent pair of dead rows would say
                                     the feature is broken rather than absent. -->
                                <MenuItem x:Name="ViewerSubtitleToggleItem"
                                        Header="{x:Static services:Strings.ViewerSubtitles}"
                                        IsCheckable="True"
                                        Click="ViewerSubtitleToggle_Click"
                                        Visibility="Collapsed"/>
                                <MenuItem x:Name="ViewerSubtitleSizeItem"
                                        StaysOpenOnClick="True"
                                        Focusable="False"
                                        Padding="{DynamicResource MenuStepperRowPadding}"
                                        Visibility="Collapsed">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                    Text="{x:Static services:Strings.ViewerSubtitleSize}"
                                                    Foreground="{DynamicResource MenuForeground}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                                            <!-- The value belongs in the middle
                                                 here, unlike the 영상 크기 row:
                                                 a subtitle size IS a number
                                                 someone tunes and comes back to,
                                                 so this is the options menu's
                                                 stepper unchanged. -->
                                            <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                                <Button Content="−"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerSubtitleSmaller_Click"/>
                                                <TextBlock x:Name="ViewerSubtitleSizeText"
                                                        Foreground="{DynamicResource MenuForeground}"
                                                        Width="{DynamicResource MenuStepperValueWidth}"
                                                        TextAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                <Button Content="+"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerSubtitleLarger_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <!-- Sync, kept per film (see
                                     VideoMarkEntry.SubtitleOffset). Half a
                                     second a press, signed, so the readout says
                                     which way it moved as well as how far. -->
                                <MenuItem x:Name="ViewerSubtitleSyncItem"
                                        StaysOpenOnClick="True"
                                        Focusable="False"
                                        Padding="{DynamicResource MenuStepperRowPadding}"
                                        Visibility="Collapsed">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                    Text="{x:Static services:Strings.ViewerSubtitleSync}"
                                                    Foreground="{DynamicResource MenuForeground}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                                <Button Content="−"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerSubtitleEarlier_Click"/>
                                                <TextBlock x:Name="ViewerSubtitleOffsetText"
                                                        Foreground="{DynamicResource MenuForeground}"
                                                        Width="{DynamicResource MenuStepperValueWidth}"
                                                        TextAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                <Button Content="+"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerSubtitleLater_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <!-- A switch rather than something automatic,
                                     for now: the correction is an approximation
                                     and whether a given film needs it is
                                     something only the eye in front of it can
                                     say. Detecting HDR from the container would
                                     let it apply itself, and that is the next
                                     step if this one turns out to be worth
                                     keeping. -->
                                <MenuItem x:Name="ViewerHdrItem"
                                        Header="{x:Static services:Strings.ViewerHdrToneMap}"
                                        IsCheckable="True"
                                        Click="ViewerHdrToneMap_Click"
                                        Visibility="Collapsed"/>
                                <!-- The two dials, in the same stepper row the
                                     subtitle size uses. They only appear with
                                     the correction switched ON: with it off
                                     they change nothing, and a row that does
                                     nothing is worse than a row that is not
                                     there. How much either wants depends on how
                                     the film was graded, so these are not
                                     settings to get right once - they are
                                     something to nudge while looking. -->
                                <MenuItem x:Name="ViewerHdrBrightnessItem"
                                        StaysOpenOnClick="True"
                                        Focusable="False"
                                        Padding="{DynamicResource MenuStepperRowPadding}"
                                        Visibility="Collapsed">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                    Text="{x:Static services:Strings.ViewerHdrBrightness}"
                                                    Foreground="{DynamicResource MenuForeground}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                                <Button Content="−"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerHdrBrightnessDown_Click"/>
                                                <TextBlock x:Name="ViewerHdrBrightnessText"
                                                        Foreground="{DynamicResource MenuForeground}"
                                                        Width="{DynamicResource MenuStepperValueWidth}"
                                                        TextAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                <Button Content="+"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerHdrBrightnessUp_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="ViewerHdrSaturationItem"
                                        StaysOpenOnClick="True"
                                        Focusable="False"
                                        Padding="{DynamicResource MenuStepperRowPadding}"
                                        Visibility="Collapsed">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                    Text="{x:Static services:Strings.ViewerHdrSaturation}"
                                                    Foreground="{DynamicResource MenuForeground}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                                <Button Content="−"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerHdrSaturationDown_Click"/>
                                                <TextBlock x:Name="ViewerHdrSaturationText"
                                                        Foreground="{DynamicResource MenuForeground}"
                                                        Width="{DynamicResource MenuStepperValueWidth}"
                                                        TextAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                <Button Content="+"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerHdrSaturationUp_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="ViewerHdrContrastItem"
                                        StaysOpenOnClick="True"
                                        Focusable="False"
                                        Padding="{DynamicResource MenuStepperRowPadding}"
                                        Visibility="Collapsed">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                    Text="{x:Static services:Strings.ViewerHdrContrast}"
                                                    Foreground="{DynamicResource MenuForeground}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                                <Button Content="−"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerHdrContrastDown_Click"/>
                                                <TextBlock x:Name="ViewerHdrContrastText"
                                                        Foreground="{DynamicResource MenuForeground}"
                                                        Width="{DynamicResource MenuStepperValueWidth}"
                                                        TextAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                <Button Content="+"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerHdrContrastUp_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator/>
                                <!-- All four are refused while a film is loaded:
                                     a playing MediaElement holds the file OPEN,
                                     so rename and delete fail at the OS and cut
                                     leaves a file marked for a move that can't
                                     happen. Greyed rather than hidden - the rows
                                     every other selection has should not vanish
                                     and move everything under them (
                                     2026-08-10). -->
                                <MenuItem x:Name="ViewerCutItem"
                                        Header="{x:Static services:Strings.MenuCut}"
                                        InputGestureText="Ctrl+X"
                                        Click="CutItem_Click"/>
                                <MenuItem x:Name="ViewerCopyItem"
                                        Header="{x:Static services:Strings.MenuCopy}"
                                        InputGestureText="Ctrl+C"
                                        Click="CopyItem_Click"/>
                                <MenuItem x:Name="ViewerRenameItem"
                                        Header="{x:Static services:Strings.MenuRename}"
                                        InputGestureText="F2"
                                        Click="RenameItem_Click"/>
                                <MenuItem x:Name="ViewerDeleteItem"
                                        Header="{x:Static services:Strings.MenuDelete}"
                                        InputGestureText="Del"
                                        Click="DeleteItem_Click"/>
                                <Separator/>
                                <MenuItem Header="{x:Static services:Strings.MenuCopyPath}"
                                        InputGestureText="Ctrl+Shift+C"
                                        Click="CopyPath_Click"/>
                                <MenuItem Header="{x:Static services:Strings.MenuRevealInExplorer}"
                                        Click="RevealInExplorer_Click"/>
                                <MenuItem Header="{x:Static services:Strings.MenuProperties}"
                                        Click="ShowProperties_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <!-- Uniform with no StretchDirection cap: the user
                             asked for no size ceiling, so a small image may
                             scale up - HighQuality keeps that acceptable. -->
                        <Image x:Name="ViewerImage"
                                Stretch="Uniform"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                RenderTransformOrigin="0.5,0.5"
                                Margin="10">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ViewerZoomScale"
                                            ScaleX="1"
                                            ScaleY="1"/>
                                    <TranslateTransform x:Name="ViewerZoomPan"
                                            X="0"
                                            Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Border>
                    <!-- Zoom navigator: the whole picture small, with a box
                         showing which part of it the panel is currently
                         looking at. A sibling of the host rather than a child,
                         so the host stays a Border with one child and its clip
                         is untouched; it sizes itself to the picture's aspect
                         in code.
                         The plate is a MAP now, not read-only (
                         2026-08-09 - they kept grabbing the white box and
                         getting a whole-image pan instead): press anywhere on
                         it and the view centres there, then follows the drag.
                         It only shows while a pan is possible, so it is never
                         an inert click target; a pan drag that STARTED on the
                         picture keeps its capture and never lands here.
                         Fixed colours, the one place in this app that ignores
                         the theme: what shows through behind it is the PHOTO,
                         so a light-theme plate would vanish on a bright image
                         and a dark one on a dark image. The dark scrim over
                         everything OUTSIDE the box is what keeps the box
                         readable over any picture. -->
                    <Border x:Name="ViewerNavigatorPlate"
                            Grid.Row="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,10,10"
                            Visibility="Collapsed"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="ViewerNavigatorPlate_MouseLeftButtonDown"
                            MouseMove="ViewerNavigatorPlate_MouseMove"
                            MouseLeftButtonUp="ViewerNavigatorPlate_MouseLeftButtonUp"
                            LostMouseCapture="ViewerNavigatorPlate_LostMouseCapture"
                            Background="#CC181818"
                            BorderBrush="#59FFFFFF"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Full strength, dimmed by the SCRIM below and
                                 only OUTSIDE the box - the first design
                                 dimmed the whole thumbnail and brightened
                                 the box's fill, and the inverse was asked for
                                 (2026-08-09): the part you are looking at
                                 stays true, the rest steps back. -->
                            <Image x:Name="ViewerNavigatorImage"
                                    Stretch="Fill"
                                    RenderOptions.BitmapScalingMode="LowQuality"/>
                            <!-- A dark plate with a hole where the box is.
                                 Geometry Rects are render-only updates, so
                                 tracking the pan frame by frame costs the
                                 same as the box's own transform. -->
                            <Path Fill="#59000000">
                                <Path.Data>
                                    <CombinedGeometry GeometryCombineMode="Exclude">
                                        <CombinedGeometry.Geometry1>
                                            <RectangleGeometry x:Name="ViewerNavigatorScrimOuter"/>
                                        </CombinedGeometry.Geometry1>
                                        <CombinedGeometry.Geometry2>
                                            <RectangleGeometry x:Name="ViewerNavigatorScrimHole"/>
                                        </CombinedGeometry.Geometry2>
                                    </CombinedGeometry>
                                </Path.Data>
                            </Path>
                            <!-- Moved by a TranslateTransform, never by Margin:
                                 this box tracks the pan drag frame by frame,
                                 and a margin would run a layout pass on each
                                 one. Width/Height do change on a zoom STEP,
                                 which is once per notch, not once per frame.
                                 No fill of its own any more - the clear
                                 window through the scrim IS the fill. -->
                            <Border x:Name="ViewerNavigatorBox"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    BorderBrush="#FFFFFFFF"
                                    BorderThickness="1"
                                    Background="Transparent"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ViewerNavigatorBoxOffset"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Video playback (round 4). A separate element rather
                         than something the Image could do: WPF draws video
                         through its own path, so none of the zoom/pan
                         transform machinery applies - which is why the zoom
                         strip is swapped out for the transport strip below
                         while this is showing.
                         LoadedBehavior/UnloadedBehavior Manual: playback
                         starts on an explicit click and NEVER on selection,
                         or arrow-keying a folder would set several films
                         playing at once. The Source is cleared the moment the
                         selection leaves - a playing MediaElement holds the
                         file open, and this app's own rename and delete are
                         two rows away. -->
                    <!-- The clip the zoom made necessary. ViewerImage has always
                         had one (ViewerImageHost is the Border that carries it);
                         the media element is that Border's SIBLING, so nothing
                         held it in and a zoomed film simply grew out over the
                         tree (reported with a screenshot, 2026-08-10). Its own
                         Border, rather than clipping the row's Grid, so the play
                         overlay and the navigator keep the bounds they had. -->
                    <Border Grid.Row="0"
                            ClipToBounds="True">
                    <MediaElement x:Name="ViewerMedia"
                            Margin="10"
                            Visibility="Collapsed"
                            Stretch="Uniform"
                            LoadedBehavior="Manual"
                            UnloadedBehavior="Manual"
                            ScrubbingEnabled="True"
                            RenderTransformOrigin="0.5,0.5"
                            MouseDown="ViewerImageHost_MouseDown"
                            MediaOpened="ViewerMedia_MediaOpened"
                            MediaEnded="ViewerMedia_MediaEnded"
                            MediaFailed="ViewerMedia_MediaFailed"
                            BufferingStarted="ViewerMedia_BufferingStarted"
                            BufferingEnded="ViewerMedia_BufferingEnded">
                        <!-- Scale only, and centred. The picture's transform
                             group carries a pan as well; a film does not, by
                             decided 2026-08-10 - left-drag is
                             already play/pause here, and splitting it by
                             whether the film happens to be zoomed would be the
                             conditional gesture this app keeps refusing. So the
                             film grows about its middle and stays there. -->
                        <MediaElement.RenderTransform>
                            <ScaleTransform x:Name="ViewerMediaScale"/>
                        </MediaElement.RenderTransform>
                    </MediaElement>
                    </Border>
                    <!-- The subtitle line. OUTSIDE the media element's clip and
                         its scale on purpose: it is not part of the picture, so
                         zooming the film must not zoom the words, and it should
                         stay put and stay readable while the picture moves under
                         it.

                         A filled box behind the text rather than an outline or a
                         shadow (2026-08-10, "디즈니플러스 자막 같이"): a
                         box is one shape that works over any frame, while an
                         outline needs a second pass over every glyph and a
                         shadow needs an effect - and both are the kind of thing
                         that reads as almost-right rather than right.

                         Never hit-testable. It sits over the film, and the film
                         takes clicks (play/pause). -->
                    <Border x:Name="ViewerSubtitlePlate"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="16,0,16,18"
                            Padding="10,3"
                            CornerRadius="3"
                            Background="#A6000000"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ViewerSubtitleText"
                                Foreground="#FFFFFFFF"
                                TextAlignment="Center"
                                TextWrapping="Wrap"/>
                    </Border>
                    <!-- The one affordance that turns a still frame into a
                         promise the panel can keep. Only up for a video that
                         isn't playing; clicking the picture itself is left
                         alone, since that gesture already means pan. -->
                    <Button x:Name="ViewerPlayOverlay"
                            Grid.Row="0"
                            Width="64"
                            Height="64"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            Click="ViewerPlayOverlay_Click"
                            ToolTip="{x:Static services:Strings.ViewerPlay}">
                        <!-- Light plate, dark mark, no outline (2026-08-10:
                             the dark-plate-and-white-triangle version "다른데
                             플레이버튼하고 너무 같아서"). Both halves are
                             translucent, so the still frame reads through the
                             button rather than being covered by it - which is
                             also what keeps a 64px disc from looking like a
                             sticker dropped on the picture. The outline went
                             with the dark plate: an edge is what a button needs
                             when it is darker than everything around it, and
                             this one is lighter. Hover just makes the plate more
                             solid; nothing moves or grows. -->
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="Plate"
                                            Fill="#B0FFFFFF"/>
                                    <Path Data="M 24,18 L 44,32 L 24,46 Z"
                                            Fill="#C0000000"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                            Value="True">
                                        <Setter TargetName="Plate"
                                                Property="Fill"
                                                Value="#D8FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- What a non-image selection shows instead: the file's
                         own shell icon, natural size, centered. -->
                    <Image x:Name="ViewerIconImage"
                            Grid.Row="0"
                            Width="64"
                            Height="64"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"/>
                    <!-- Name, a wide gap, then ONE metadata line (resolution ·
                         size · date) - briefly three lines, folded back the
                         same day: nothing more is coming to this caption
                         (2026-08-08). The name wears the tree's own
                         file-name colour; the metadata line wears the footer
                         chips' unchecked ink (ForegroundText at the chips'
                         own 0.65 - matching them is the user's spec here, so
                         the no-opacity rule yields to the pairing). -->
                    <!-- The filmstrip: the carousel counter, opened out. What
                         < 35 / 257 > says in numbers this says in pictures, and
                         it walks the SAME list (GetViewerCarouselItems) so the
                         two can never disagree about what the folder holds.
                         Films are in that list as of 2026-08-10 - a strip that
                         emptied itself in a folder of films would be a strange
                         thing to call a filmstrip, and the counter was widened
                         with it rather than left counting something else.

                         CanContentScroll, and the wheel handler that goes with
                         it, are what make this move a CELL at a time instead of
                         a pixel at a time (and the same choice the
                         tree made for its rows). Virtualized in the same
                         breath: it is what keeps a 257-frame folder to the
                         dozen containers on screen, and the shell is only asked
                         about a cell once one exists.

                         No animation anywhere in here. Following the selection
                         is an instant jump - see SyncFilmstripToSelection. -->
                    <!-- The border is the divider the strip needed: without a
                         line the frames simply began, and the picture and the
                         strip read as one crowded thing. At rest it is barely
                         there - the panel's own divider ink, one pixel - and the
                         grip on top of it does the rest (see the Thumb below):
                         a touch stronger under the cursor, FAINTER again while
                         being dragged, which is this app's standing rule for
                         grab lines (the hand is already on it; it does not need
                         to be told twice). -->
                    <Border x:Name="ViewerFilmstripHost"
                            Grid.Row="1"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource PanelDividerBrush}"
                            Visibility="Collapsed">
                      <Grid>
                        <ListBox x:Name="ViewerFilmstrip"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4,5,4,4"
                                Focusable="False"
                                ScrollViewer.CanContentScroll="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                PreviewMouseWheel="ViewerFilmstrip_PreviewMouseWheel"
                                PreviewMouseLeftButtonDown="ViewerFilmstrip_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="ViewerFilmstrip_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="ViewerFilmstrip_PreviewMouseLeftButtonUp">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,3,0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <!-- On the CONTAINER, not inside the cell:
                                         the whole frame answers, including the
                                         letterboxed margins a portrait picture
                                         leaves, so there is no dead strip where
                                         the name refuses to appear. Name carries
                                         the extension, which is half of what the
                                         strip cannot show. -->
                                    <Setter Property="ToolTip" Value="{Binding Name}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <!-- TWO STATES, TWO CHANNELS.
                                                     Both were borders at first
                                                     and they fought: the trigger
                                                     that ran last won, so the
                                                     selected cell could not show
                                                     hover at all, and a row of
                                                     outlines blinking on and off
                                                     under the cursor sat right
                                                     next to the one outline that
                                                     was supposed to mean
                                                     something (confusing as it stood,
                                                     user 2026-08-10).

                                                     Selection keeps the line -
                                                     it is the state that must
                                                     survive the mouse being
                                                     somewhere else entirely.
                                                     Hover became BRIGHTNESS,
                                                     which is a channel the line
                                                     does not use, so the two now
                                                     stack instead of replacing
                                                     each other: the selected cell
                                                     lights up under the cursor
                                                     like every other one and
                                                     keeps its frame.

                                                     The wash goes over the whole
                                                     cell rather than the
                                                     letterbox alone - a picture
                                                     the same shape as its cell
                                                     leaves no letterbox, and a
                                                     hover that only some cells
                                                     can show is worse than the
                                                     borders were. -->
                                                <Border x:Name="Frame"
                                                        BorderThickness="2"
                                                        BorderBrush="Transparent"
                                                        Background="#14808080"
                                                        SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <ContentPresenter x:Name="Cell"/>
                                                        <Border x:Name="Wash"
                                                                Background="Transparent"
                                                                IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- Hover is TWO faint things
                                                         rather than one strong
                                                         one, and they cover each
                                                         other's blind side. A
                                                         white wash reads on a
                                                         dark picture and vanishes
                                                         on a bright one; taking a
                                                         little opacity off the
                                                         cell lets the panel's own
                                                         dark ground through,
                                                         which dulls a BRIGHT
                                                         picture and barely
                                                         touches a dark one. So
                                                         whichever the frame is,
                                                         something moves - and
                                                         both are gentler than the
                                                         single 15% wash they
                                                         replace ("지금은 좀
                                                         강해서요", user
                                                         2026-08-10).

                                                         Per-PIXEL adaptation - a
                                                         wash that knows it is
                                                         over a white sky - would
                                                         need a blend mode, which
                                                         in WPF means a compiled
                                                         pixel shader on every
                                                         cell. Not for a hover.

                                                         Opacity here is a
                                                         composition-stage
                                                         property: no layout, no
                                                         re-decode, nothing per
                                                         frame. (And not the
                                                         dimmed-text rule - this
                                                         is a pointer state on a
                                                         picture, not a way of
                                                         calling something
                                                         secondary.) -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Wash"
                                                                Property="Background"
                                                                Value="#0DFFFFFF"/>
                                                        <Setter TargetName="Cell"
                                                                Property="Opacity"
                                                                Value="0.93"/>
                                                    </Trigger>
                                                    <!-- The tree's OWN selection
                                                         colour, not a separate
                                                         accent: the strip and
                                                         the tree are showing the
                                                         same selection, so it
                                                         would be odd for the two
                                                         to mark it in different
                                                         colours - and this one
                                                         follows 색상 설정, so it
                                                         is the colour the user
                                                         actually chose to mean
                                                         "this one" (
                                                         2026-08-10). A border
                                                         here rather than a fill,
                                                         because a fill behind a
                                                         picture that covers its
                                                         cell would never be
                                                         seen. -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Frame"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource TreeRowSelectedActiveBackground}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Loaded is where the shell gets asked, so
                                         virtualization decides what is fetched -
                                         see FilmstripCell.Requested for why it
                                         is only ever asked once per cell. -->
                                    <Grid Width="{DynamicResource FilmstripCellWidth}"
                                            Height="{DynamicResource FilmstripCellHeight}"
                                            Background="Transparent"
                                            Loaded="FilmstripCell_Loaded">
                                        <Image Source="{Binding Thumbnail}"
                                                Stretch="Uniform"
                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <!-- A film's thumbnail is just a frame
                                             and a track's is its album art, so
                                             nothing else in the strip would
                                             say which ones play. The panel's own
                                             play button in miniature - same
                                             light plate, same dark mark - in the
                                             CENTRE, where that button is, and
                                             fainter than it: this one is a label
                                             saying what the frame is, not a
                                             control asking to be pressed
                                             (2026-08-10).

                                             Moving it out of the corner also
                                             left the corner free, which is where
                                             the bookmark ribbon went.

                                             Sized from the cell rather than
                                             fixed: the strip is resizable, and a
                                             14px disc that reads right on a 64px
                                             frame is a speck on a 200px one and
                                             most of a 40px one. The Path scales
                                             with Stretch, so the triangle keeps
                                             its shape at every size. -->
                                        <Border Width="{DynamicResource FilmstripBadgeSize}"
                                                Height="{DynamicResource FilmstripBadgeSize}"
                                                CornerRadius="{DynamicResource FilmstripBadgeRadius}"
                                                Background="#66FFFFFF"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlayable}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Path Data="M 5,3.5 L 10,7 L 5,10.5 Z"
                                                    Fill="#8A000000"
                                                    Stretch="Uniform"
                                                    Margin="{DynamicResource FilmstripBadgeInset}"/>
                                        </Border>
                                        <!-- The bookmark, in the strip because it
                                             is in the tree: a marked file has to
