            <!-- Shares the row with FavoritesList; exactly one of the two is
                 ever visible, and in "none" mode neither is (see
                 MainWindow.xaml.cs's ApplySidePanelMode). A second ListBox
                 rather than one that swaps its source: the favorites list is
                 bound straight to the stored entries and carries the whole
                 drag-to-reorder gesture on top of them, none of which a
                 bookmark row wants. Deliberately no reorder here - the order
                 IS the Ctrl+Alt+L/J cycle order, so dragging it would rewire
                 the shortcuts silently (2026-08-02). -->
            <ListBox x:Name="BookmarkPanelList"
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource FavoritesListBoxStyle}"
