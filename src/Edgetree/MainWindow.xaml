                                            Opacity="0.65"
                                            TextAlignment="Center"
                                            VerticalAlignment="Center"/>
                                </Grid>
                                <!-- The speaker is the mute toggle, which is
                                     where every player puts it. The slash is
                                     drawn as a second Path shown only while
                                     muted, so the icon itself never has to be
                                     swapped for another shape. -->
                                <!-- Material Symbols "volume_up" / "volume_off"
                                     (2026-08-10), replacing a
                                     hand-drawn speaker with a stroked slash
                                     laid over it. The family draws the muted
                                     state as its own whole shape, so the two
                                     are now a pair of marks like play/pause -
                                     and the old worry about keeping a separate
                                     slash registered against the speaker at
                                     every size goes with it. -->
                                <Button x:Name="ViewerMediaMute"
                                        Style="{StaticResource FooterActionGlyphChipStyle}"
                                        Click="ViewerMediaMute_Click"
                                        ToolTip="{x:Static services:Strings.ViewerMute}">
                                    <Grid>
                                        <Path x:Name="ViewerMediaVolumeIcon"
                                                Data="M552-152v-75q86-23 139-93.26 53-70.25 53-159.5 0-89.24-53.5-158.74Q637-708 552-734v-75q116 25 190 117t74 211q0 119-73.5 211.5T552-152ZM144-385v-192h144l192-192v576L288-385H144Zm408 55v-302q45.12 20.4 70.56 61.2Q648-530 648-480.52q0 48.52-25.44 89.23Q597.12-350.59 552-330ZM408-595l-90 90H216v48h102l90 90v-228Zm-91 113Z"
                                                Stretch="Uniform"
                                                Width="{DynamicResource ViewerChipIconSize}"
                                                Height="{DynamicResource ViewerChipIconSize}"
                                                Fill="{Binding Foreground,
                                                    RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        <Path x:Name="ViewerMediaMuteIcon"
                                                Data="M768-90 661-197q-22 14-52.5 26.5T552-152v-74q12-5 28.5-11.5T608-250L480-378v187L288-383H144v-192h138L90-768l51-51 678 678-51 51Zm-6-209-52-52q16-29 25-61.5t9-66.5q0-89-53.5-158.5T552-733v-74q117 23 190.5 116T816-479q0 48-14 93.5T762-299ZM638-423l-86-86v-122q45 20 70.5 61.5T648-479q0 14-2 28t-8 28ZM480-581l-93-93 93-93v186Zm-72 216v-85l-72-72-18 19H216v48h102l90 90Zm-36-121Z"
                                                Visibility="Collapsed"
                                                Stretch="Uniform"
                                                Width="{DynamicResource ViewerChipIconSize}"
                                                Height="{DynamicResource ViewerChipIconSize}"
                                                Fill="{Binding Foreground,
                                                    RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    </Grid>
                                </Button>
                                <Slider x:Name="ViewerMediaVolume"
                                        Style="{StaticResource ViewerMediaSliderStyle}"
                                        MouseWheel="ViewerMediaVolume_MouseWheel"
                                        Width="80"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="0.6"
                                        VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="ViewerMediaVolume_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="ViewerMediaVolume_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="ViewerMediaVolume_PreviewMouseLeftButtonUp"
                                        ValueChanged="ViewerMediaVolume_ValueChanged"/>
                                <!-- WHERE THE SOUND IS COMING FROM, in the tree
                                     (2026-08-11). It answers a question only
                                     this row can raise: background play and the
                                     search results both let the transport hold a
                                     file the tree is nowhere near, and the file
                                     name above it names the track without saying
                                     where it lives.

                                     It goes to the FILE, not to its folder - the
                                     folder is where the file is, and landing on
                                     the row itself also hands the panel back, so
                                     the transport is attached again afterwards.

                                     Grouped with 기본 프로그램에서 열기 because the
                                     two are the same kind of thing: both leave
                                     this row for somewhere else. First two out
                                     when the panel narrows, for the same reason.

                                     Material Symbols "folder" - the SAME path
                                     the search box's folder button draws, minus
                                     the box tail that one carries because its
                                     whole set does. Its own width, not the
                                     square icon size: see ViewerChipWideIconSize
                                     for why a wide mark in a square box came out
                                     short. -->
                                <Button x:Name="ViewerMediaRevealInTree"
                                        Style="{StaticResource FooterActionGlyphChipStyle}"
                                        Margin="{DynamicResource ViewerChipGroupMargin}"
                                        Click="ViewerMediaRevealInTree_Click"
                                        ToolTip="{x:Static services:Strings.MenuRevealInTree}">
                                    <Path Data="M168-192q-29 0-50.5-21.5T96-264v-432q0-29.7 21.5-50.85Q139-768 168-768h216l96 96h312q29.7 0 50.85 21.15Q864-629.7 864-600v336q0 29-21.15 50.5T792-192H168Zm0-72h624v-336H450l-96-96H168v432Z"
                                            Stretch="Uniform"
