                                    <TextBlock Text="00:00:00 / 00:00:00"
                                            Visibility="Hidden"
                                            FontSize="{DynamicResource FooterChipFontSize}"/>
                                    <TextBlock x:Name="ViewerMediaTime"
                                            FontSize="{DynamicResource FooterChipFontSize}"
