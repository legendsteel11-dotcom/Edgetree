                                PreviewMouseLeftButtonDown="PathBarBox_PreviewMouseLeftButtonDown"
                                GotKeyboardFocus="PathBarBox_GotKeyboardFocus"
                                LostKeyboardFocus="PathBarBox_LostKeyboardFocus"/>
                        <!-- The SAME chevrons the carousel walks a folder with,
                             which is the pair this app already means "one step
                             either way" by. Sizes are literals here rather than
                             resources because this whole row is - the box's 12pt
                             and the row's 24 are literals too, so a button that
                             followed Ctrl +/- would be the only thing in it that
                             moved.

                             The style brings its own disabled state (0.45), so
                             the end of the stack shows as a greyed chevron that
                             stays in place rather than a button that vanishes
                             and shifts its neighbour.

                             A RESTING OUTLINE, the path field's own brush: these
                             two stand alone on a strip with no other controls,
                             where a header button always has five neighbours to
                             read as a row with. The box beside them is drawn as
                             an outline rather than a filled field, so matching it
                             makes the three read as one strip. Only the disabled
                             state drops the fill; the outline stays either way,
                             which is what keeps the row from twitching as the
                             ends of the stack come and go. -->
                        <Button x:Name="TreeHistoryBackButton"
                                Grid.Column="1"
                                Style="{StaticResource ToggleButtonStyle}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1"
                                Width="22"
                                Height="22"
                                Margin="4,0,0,0"
                                Click="TreeHistoryBackButton_Click"
                                ToolTip="{x:Static services:Strings.TreeHistoryBack}">
                            <Path Data="M576-240 336-480l240-240 51 51-189 189 189 189-51 51Z"
                                    Fill="{DynamicResource ForegroundText}"
                                    Stretch="Uniform"
                                    Width="12"
                                    Height="12"/>
                        </Button>
                        <Button x:Name="TreeHistoryForwardButton"
                                Grid.Column="2"
                                Style="{StaticResource ToggleButtonStyle}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1"
                                Width="22"
                                Height="22"
                                Margin="2,0,0,0"
                                Click="TreeHistoryForwardButton_Click"
                                ToolTip="{x:Static services:Strings.TreeHistoryForward}">
                            <Path Data="M522-480 333-669l51-51 240 240-240 240-51-51 189-189Z"
                                    Fill="{DynamicResource ForegroundText}"
                                    Stretch="Uniform"
                                    Width="12"
                                    Height="12"/>
                        </Button>
                    </Grid>

                    <!-- The version, and then one toggle per file-kind filter
                         (built in code from the same table the menus use - see
                         RebuildFooterFilterChips). Putting them here rather than
                         only in the menus is the point: this strip is where a
                         filter announces itself, so it is where the hand already
                         is when it needs changing.

                         WrapPanel, so a narrow window costs a second line instead
                         of cutting chips off the end. -->
                    <!-- The gap BETWEEN wrapped rows is a top margin on the chips
                         themselves (see AddFooterFilterChip) - a panel's margin
                         sits outside all of them and leaves two lines touching.
                         Top rather than bottom so this panel keeps owning the space
                         under the last row: the two together read as one strip with
                         even air above and below, which a chip-side bottom margin
                         could not do without this going to zero and the strip
                         sitting on the window's edge.
                         Which is what it was doing anyway at 3 (reported with a
                         screenshot, 2026-08-10: "칩버튼이 바닥에 아예 붙어서
                         보입니다"). Now 6, taken from the path row above rather
                         than added, so the footer is the same height with the
                         path bar showing. With it hidden - the default - this
                         panel IS the footer, so there the footer does grow by
                         those 3px, which is the same fix in the configuration
                         that needed it just as much. -->
                    <WrapPanel x:Name="VersionFooterPanel"
                            Orientation="Horizontal"
                            Margin="8,1,4,6">
                    </WrapPanel>
