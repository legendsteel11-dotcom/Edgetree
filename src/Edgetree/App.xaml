<Application x:Class="SidebarExplorer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SidebarExplorer.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Application-level (not MainWindow.Resources) so ColorSettingsWindow
             and AboutWindow - separate Window instances with their own resource
             dictionaries - can share the exact same DynamicResource keys instead
             of each needing their own copy. Dark-mode defaults declared here;
             App.ApplyChromeTheme (called from MainWindow.ApplyColorSettings,
             which runs at startup and on every color/theme change) overwrites
             all of these live when light mode is on. These are the app's
             general "chrome" (menus/dialogs/header icons) - deliberately
             separate from the 15 user-customizable tree colors in
             AppSettings, which is why changing a tree color has never
             recolored a menu (see MainWindow.xaml's own ForegroundText
             comment history). -->
        <SolidColorBrush x:Key="ForegroundText" Color="#FFA8AAAE"/>
        <SolidColorBrush x:Key="HighlightForeground" Color="#FFF0F2F6"/>
        <SolidColorBrush x:Key="HoverBackground" Color="#FF2A2D2E"/>
        <!-- The bar under the pointer in a menu. Its own brush rather than
             HoverBackground, which sits within two points of the menu's
             background (#282A2C) and so came out invisible there - the tree's
             hover is the standard to match, not the dialog's. -->
        <SolidColorBrush x:Key="MenuHighlightBackground" Color="#FF3A3D41"/>
        <!-- The colour picker's own panel. A step darker than the dialog it
             floats over, which is how it sets itself apart now that nothing
             dims behind it - shading the window was separating the panel at
             the cost of the colours being judged through it. -->
        <SolidColorBrush x:Key="PickerPanelBackground" Color="#FF141415"/>
        <SolidColorBrush x:Key="SecondaryForeground" Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#FF282828"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#FF454545"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#FF3C3C3C"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#FF5A5A5A"/>
        <SolidColorBrush x:Key="ControlHoverBackground" Color="#FF505050"/>
        <SolidColorBrush x:Key="ControlHoverBorder" Color="#FF7A7A7A"/>
        <SolidColorBrush x:Key="DialogBackground" Color="#FF252526"/>
        <SolidColorBrush x:Key="DialogHeaderBackground" Color="#FF2D2D2D"/>
        <SolidColorBrush x:Key="DialogForeground" Color="#FFCCCCCC"/>
        <SolidColorBrush x:Key="AccentForeground" Color="#FF4FA8FF"/>
    </Application.Resources>
</Application>
