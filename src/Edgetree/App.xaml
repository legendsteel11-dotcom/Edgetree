<Application x:Class="SidebarExplorer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:SidebarExplorer.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Application-level (not MainWindow.Resources) so ColorSettingsWindow
             and AboutWindow - separate Window instances with their own resource
             dictionaries - can share the exact same DynamicResource keys instead
             of each needing their own copy. Dark-mode defaults declared here;
             App.ApplyChromeTheme (called from MainWindow.ApplyColorSettings,
             which runs at startup and on every color/theme change) overwrites
             all of these live when light mode is on. These are the app's
             general "chrome" (menus/dialogs/header icons) - deliberately
             separate from the 15 user-customizable tree colors in
             AppSettings, which is why changing a tree color has never
             recolored a menu (see MainWindow.xaml's own ForegroundText
             comment history). -->
        <SolidColorBrush x:Key="ForegroundText" Color="#FFA8AAAE"/>
        <SolidColorBrush x:Key="HighlightForeground" Color="#FFF0F2F6"/>
        <SolidColorBrush x:Key="HoverBackground" Color="#FF2A2D2E"/>
        <!-- The bar under the pointer in a menu. Its own brush rather than
             HoverBackground, which sits within two points of the menu's
             background (#282A2C) and so came out invisible there - the tree's
             hover is the standard to match, not the dialog's. -->
        <SolidColorBrush x:Key="MenuHighlightBackground" Color="#FF3A3D41"/>
        <!-- The colour picker's own panel. A step darker than the dialog it
             floats over, which is how it sets itself apart now that nothing
             dims behind it - shading the window was separating the panel at
             the cost of the colours being judged through it. -->
        <SolidColorBrush x:Key="PickerPanelBackground" Color="#FF141415"/>
        <SolidColorBrush x:Key="SecondaryForeground" Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#FF282828"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#FF454545"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="ControlBackground" Color="#FF3C3C3C"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#FF5A5A5A"/>
        <SolidColorBrush x:Key="ControlHoverBackground" Color="#FF505050"/>
        <SolidColorBrush x:Key="ControlHoverBorder" Color="#FF7A7A7A"/>
        <SolidColorBrush x:Key="DialogBackground" Color="#FF252526"/>
        <SolidColorBrush x:Key="DialogHeaderBackground" Color="#FF2D2D2D"/>
        <SolidColorBrush x:Key="DialogForeground" Color="#FFCCCCCC"/>
        <SolidColorBrush x:Key="AccentForeground" Color="#FF4FA8FF"/>

        <!-- MOVED HERE FROM MainWindow, 2026-08-11. These were window-level,
             which meant every window that is not MainWindow drew the SYSTEM
             scrollbar - fine while the only other windows were short dialogs
             that never scrolled, and immediately visible the moment the help
             window did. A style that describes "what a scrollbar looks like in
             this app" belongs to the app.

             The four keys below are DEFAULTS for the same reason. The styles
             ask for them by DynamicResource, which resolves from the element
             upwards, so inside MainWindow its own (zoom-adjusted) values still
             win; anywhere else these answer instead of nothing.

             THE TYPES HAVE TO MATCH MainWindow'S, exactly. ScrollGutterWidth is
             a GridLength and not a Double, and getting that wrong crashed the
             help window on open while the tree carried on perfectly - because
             the tree never reaches these, it finds MainWindow's own first. A
             fallback is only ever exercised by the thing that has no other
             answer, so a mistake in one is invisible everywhere it works. -->
        <system:Double x:Key="ScrollBarThickness">12</system:Double>
        <GridLength x:Key="ScrollGutterWidth">13</GridLength>
        <SolidColorBrush x:Key="MenuForeground" Color="#FFCCCCCC"/>
        <SolidColorBrush x:Key="PanelDividerBrush" Color="#FF3A3A3A"/>
        <!-- A thin, translucent scrollbar thumb (VS Code style) instead of the
             stock Windows scrollbar chrome. Implicit (no x:Key) so it applies to
             every ScrollBar in scope, including the TreeView's internal one. -->
        <Style x:Key="MinimalScrollBarThumb"
                TargetType="Thumb">
            <Setter Property="Background"
                    Value="#33FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging"
                                    Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background"
                                        Value="#70FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Keyed explicitly (not implicit-by-TargetType) and wired directly onto
             PART_VerticalScrollBar/PART_HorizontalScrollBar below - relying on
             implicit TargetType resolution here previously lost to the theme's
             own ScrollBar styling inside ScrollViewer's default template. -->
        <Style x:Key="MinimalScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Background"
                    Value="Transparent"/>
            <!-- Hidden at rest; hit-testing still works at Opacity 0, so moving the
                 mouse toward the edge is enough to reveal it (VS Code / overlay-
                 scrollbar style), and it fades back out once the mouse leaves. -->
            <Setter Property="Opacity"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <!-- Track defaults to Vertical and ignores the ScrollBar's own
                                 Orientation unless explicitly bound - without this, a
                                 horizontal scrollbar renders as a stray vertical sliver. -->
                            <Track x:Name="PART_Track"
                                    IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollBarThumb"
                                            Style="{StaticResource MinimalScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                            Opacity="0"
                                            Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                            Opacity="0"
                                            Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <!-- A floor on the grab area. Track sizes the thumb
                             purely as viewport ÷ content, with no minimum of
                             its own, so a long tree in a short window shrank it
                             to a few pixels - visible, but not something you
                             can catch with a mouse (2026-08-10, with the
                             window pulled down to about six rows).
                             Set per orientation because the thumb's long axis
                             is the one being squeezed; forcing the other one
                             would push it out of a bar that is only
                             ScrollBarThickness across. -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation"
                                    Value="Vertical">
                                <Setter TargetName="ScrollBarThumb"
                                        Property="MinHeight"
                                        Value="28"/>
                            </Trigger>
                            <Trigger Property="Orientation"
                                    Value="Horizontal">
                                <Setter TargetName="ScrollBarThumb"
                                        Property="MinWidth"
                                        Value="28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- The "thickness" dimension is Width for a vertical scrollbar but
                 Height for a horizontal one; a single fixed Width made the
                 horizontal scrollbar's own Track (now orientation-aware) collapse
                 into a sliver instead of spanning the bottom edge. -->
            <Style.Triggers>
                <Trigger Property="Orientation"
                        Value="Vertical">
                    <Setter Property="Width"
                            Value="{DynamicResource ScrollBarThickness}"/>
                </Trigger>
                <Trigger Property="Orientation"
                        Value="Horizontal">
                    <Setter Property="Height"
                            Value="{DynamicResource ScrollBarThickness}"/>
                </Trigger>
            </Style.Triggers>
            <!-- Revealing this used to be driven from the bar's own
                 MouseEnter/MouseLeave, which meant it only appeared once the
                 cursor was already inside a 5px invisible strip - you had to
                 find a thing you couldn't see in order to make it visible. It
                 is now driven by the ScrollViewer's hover instead (see
                 MinimalScrollViewerTemplate's triggers), so the thumb shows as
                 soon as the pointer is anywhere over the list and can simply be
                 aimed at. Widened from 5 to 8 for the same reason: the search
                 results were the worst case, where a click meant for the
                 scrollbar landed on a result row instead and navigated away to
                 that file - a miss with a consequence, not just an annoyance. -->
        </Style>
        <!-- ScrollViewer's own default template creates PART_VerticalScrollBar /
             PART_HorizontalScrollBar with no explicit Style, which should resolve
             our style implicitly - but empirically it kept losing to the theme's
             own ScrollBar styling. Replacing ScrollViewer's template too, with
             Style="{StaticResource MinimalScrollBarStyle}" set directly on the
             parts, removes any ambiguity about which style wins. -->
        <ControlTemplate x:Key="MinimalScrollViewerTemplate" TargetType="ScrollViewer">
            <!-- Single-cell overlay, not a Grid with a dedicated Auto column/row for
                 each ScrollBar: a reserved column stayed reserved (5px wide) even
                 while the bar itself sat at Opacity 0 between scrolls, so content
                 never actually reached the container's right/bottom edge - a
                 permanent sliver-wide gap, most visible once the sidebar became a
                 free-floating window surrounded by other content instead of flush
                 against the screen edge. Right/Bottom-aligned ScrollBars drawn on
                 top of the full-bleed content instead give the true VS Code-style
                 overlay the styling elsewhere already intended. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Zero until there is actually something to scroll, then
                         widened by the trigger below. The original template
                         overlaid the bar on the content precisely because an
                         always-reserved column left a permanent sliver of empty
                         space down the edge; keying the width off
                         ComputedVerticalScrollBarVisibility keeps that fixed
                         while still giving the bar a lane of its own whenever
                         it appears, so long file names no longer run underneath
                         it. -->
                    <ColumnDefinition x:Name="ScrollGutterColumn"
                            Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- The default ScrollViewer template wraps this in a Border with
                     Padding="{TemplateBinding Padding}" - our replacement dropped
                     that wrapper for the minimal scrollbar layout, which silently
                     made every ScrollViewer.Padding (TreeView's and FavoritesList's
                     both) a no-op. Margin here restores it. -->
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                         Grid.Column="0"
                                         Content="{TemplateBinding Content}"
                                         CanContentScroll="{TemplateBinding CanContentScroll}"
                                         Margin="{TemplateBinding Padding}"/>

                <!-- Marks where the content stops and the bar's lane begins.
                     Shown with the lane, not with the bar's hover fade - it is
                     the boundary that explains why the text ends there, so it
                     has to be there whether or not the pointer is. -->
                <Border x:Name="ScrollGutterLine"
                        Grid.Column="1"
                        Width="1"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource PanelDividerBrush}"
                        Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                <ScrollBar x:Name="PART_VerticalScrollBar"
                           Grid.Column="1"
                           Style="{StaticResource MinimalScrollBarStyle}"
                           Orientation="Vertical"
                           HorizontalAlignment="Right"
                           Value="{TemplateBinding VerticalOffset}"
                           Maximum="{TemplateBinding ScrollableHeight}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                <ScrollBar x:Name="PART_HorizontalScrollBar"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Style="{StaticResource MinimalScrollBarStyle}"
                           Orientation="Horizontal"
                           VerticalAlignment="Bottom"
                           Value="{TemplateBinding HorizontalOffset}"
                           Maximum="{TemplateBinding ScrollableWidth}"
                           ViewportSize="{TemplateBinding ViewportWidth}"
                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>

                <!-- "There is more this way", for MENUS only. Declared here
                     rather than in a duplicated menu template, and Collapsed
                     for everyone: the only thing that ever shows them is
                     MenuScrollViewer_ScrollChanged, and the only style that
                     attaches that handler is MenuScrollViewerStyle. The tree,
                     the favorites list and the search results carry these two
                     Paths and never light them.

                     A menu needs them because its scrollbar is hidden at rest
                     like the tree's - so until the pointer went looking along
                     the edge, the fact that a menu scrolled at all was
                     invisible. Static, never blinking: a menu is a surface the
                     user is already reading, and motion there takes the eye by
                     force rather than informing it (agreed 2026-08-02). One
                     look is all this has to survive. -->
                <!-- Column 0 only, NOT spanning the gutter: centred over the
                     rows, which is what the eye reads as the middle of the
                     menu. Spanning both columns pushed it half the scrollbar's
                     width off from the text it belongs to. The gutter column
                     is 0 wide until there is something to scroll, so this is
                     the true centre either way. -->
                <Path x:Name="MoreAboveGlyph"
                        Grid.Column="0"
                        Data="M0,4 L4,0 L8,4"
                        Stroke="{DynamicResource MenuForeground}"
                        StrokeThickness="1.4"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,1,0,0"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>
                <Path x:Name="MoreBelowGlyph"
                        Grid.Column="0"
                        Data="M0,0 L4,4 L8,0"
                        Stroke="{DynamicResource MenuForeground}"
                        StrokeThickness="1.4"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,1"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
                <!-- The user-set bar thickness plus the 1px divider - both
                     recomputed together in ApplyLayoutMetrics. -->
                <Trigger Property="ComputedVerticalScrollBarVisibility"
                        Value="Visible">
                    <Setter TargetName="ScrollGutterColumn"
                            Property="Width"
                            Value="{DynamicResource ScrollGutterWidth}"/>
                </Trigger>
                <!-- Hovering anywhere in the scrollable area reveals both bars,
                     rather than each bar waiting for the pointer to land on its
                     own hidden strip - see MinimalScrollBarStyle's note. The
                     fade-out is slower and delayed so the bar doesn't vanish
                     the instant the pointer drifts off the list on its way to
                     the thumb. -->
                <Trigger Property="IsMouseOver"
                        Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                        Storyboard.TargetProperty="Opacity"
                                        To="1"
                                        Duration="0:0:0.1"/>
                                <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar"
                                        Storyboard.TargetProperty="Opacity"
                                        To="1"
                                        Duration="0:0:0.1"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PART_VerticalScrollBar"
                                        Storyboard.TargetProperty="Opacity"
                                        To="0"
                                        Duration="0:0:0.6"
                                        BeginTime="0:0:0.3"/>
                                <DoubleAnimation Storyboard.TargetName="PART_HorizontalScrollBar"
                                        Storyboard.TargetProperty="Opacity"
                                        To="0"
                                        Duration="0:0:0.6"
                                        BeginTime="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Application.Resources>
</Application>
