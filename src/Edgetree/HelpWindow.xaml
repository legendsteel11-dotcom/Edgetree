<Window x:Class="SidebarExplorer.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SidebarExplorer.App.Services"
        Title="{x:Static services:Strings.HelpTitle}"
        Width="{DynamicResource HelpDialogWidth}"
        MinWidth="380"
        MinHeight="240"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        FontSize="{DynamicResource HelpFontSize}"
        Background="{DynamicResource DialogBackground}">
    <!-- WindowStyle="None" plus CanResize makes Windows draw its own frame
         again, and on Windows 11 that frame is a bright accent line across the
         top of the window - which is where this one's own title bar is, so it
         read as a second, louder header stuck above ours.
         WindowChrome takes the non-client area back: no caption (ours is in the
         grid below), no glass frame to paint, and a resize border that is still
         a real one. Only this window needs it - the other dialogs are NoResize
         and never grew the frame in the first place. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                GlassFrameThickness="0"
                ResizeBorderThickness="6"
                CornerRadius="0"
                UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="DialogCloseButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Width"
                    Value="28"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Grows with the font and stops at 28 on the way down, and
                     the title inside it now does the same (DialogTitleTextSize)
                     - the bar had a floor and the letters did not, so Ctrl+−
                     left a 28px bar with the title shrunk to nothing inside it
                     (2026-08-11). Pinning the title outright was the first fix
                     and was worse the other way round: a zoomed-up dialog with
                     a default-size title on top of it. -->
                <RowDefinition Height="{DynamicResource DialogTitleBarHeight}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                    Background="{DynamicResource DialogHeaderBackground}"
                    MouseLeftButtonDown="HeaderGrid_MouseLeftButtonDown">
                <!-- The app's own mark, same as 앱 정보 carries. A help window
                     is the one someone opens when they are not sure where they
                     are, so the first thing in it should say whose help it is. -->
                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource DialogTitleIndent}">
                    <!-- The TITLE's size, not the tree's icon size: this one
                         stands beside a line of type rather than in a row of
                         other icons, so what it has to match is the letters -
                         including their floor. -->
                    <Image Source="pack://application:,,,/Resources/icon.png"
                            Width="{DynamicResource DialogTitleTextSize}"
                            Height="{DynamicResource DialogTitleTextSize}"
                            Margin="0,0,7,0"
                            RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{x:Static services:Strings.HelpTitle}"
                            Foreground="{DynamicResource DialogForeground}"
                            FontSize="{DynamicResource DialogTitleTextSize}"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource DialogCloseButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip="{x:Static services:Strings.ButtonClose}"
                        Click="CloseButton_Click">
                    <Path Data="M4,4 L12,12 M12,4 L4,12"
                            Stroke="{DynamicResource DialogForeground}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- Built in code rather than declared: the content is a list of
                 sections of rows and it exists in two languages, so writing it
                 in XAML would mean writing the whole document twice and then
                 keeping the two copies in step. See Services/HelpContent. -->
            <!-- The app's own scrollbar, not the system one. The style used to
                 be declared inside MainWindow, so it reached the tree and
                 nothing else - which nobody noticed until a window other than
                 MainWindow had enough content to scroll. It lives in App.xaml
                 now (2026-08-11). -->
            <ScrollViewer Grid.Row="1"
                    Template="{StaticResource MinimalScrollViewerTemplate}"
                    VerticalScrollBarVisibility="Auto"
                    Padding="18,14,18,16">
                <StackPanel x:Name="SectionHost"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
