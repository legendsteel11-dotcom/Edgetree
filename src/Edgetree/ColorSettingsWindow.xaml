<Window x:Class="SidebarExplorer.App.ColorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SidebarExplorer.App.Services"
        Title="{x:Static services:Strings.ColorSettingsTitle}"
        SizeToContent="Height"
        Width="300"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Background="#FF252526">
    <Window.Resources>
        <Style x:Key="DialogCloseButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Width"
                    Value="28"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#FF2A2D2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorRowLabelStyle"
                TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#FFCCCCCC"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="ColorSwatchStyle"
                TargetType="Border">
            <Setter Property="Width"
                    Value="32"/>
            <Setter Property="Height"
                    Value="20"/>
            <Setter Property="BorderBrush"
                    Value="#FF5A5A5A"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="3"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <!-- Plain Button defaults to the OS theme's white/light chrome, which
             clashed hard against this window's dark background - flat,
             outlined, and rounded to match the rest of the app instead. -->
        <Style x:Key="DialogButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#FFCCCCCC"/>
            <Setter Property="BorderBrush"
                    Value="#FF5A5A5A"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#FF2A2D2E"/>
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="#FF7A7A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            BorderBrush="#FF454545"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                    Background="#FF2D2D2D"
                    MouseLeftButtonDown="HeaderGrid_MouseLeftButtonDown">
                <TextBlock Text="{x:Static services:Strings.ColorSettingsTitle}"
                        Foreground="#FFCCCCCC"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"/>
                <Button Style="{StaticResource DialogCloseButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip="{x:Static services:Strings.ButtonClose}"
                        Click="CloseButton_Click">
                    <Path Data="M4,4 L12,12 M12,4 L4,12"
                            Stroke="#FFCCCCCC"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1"
                    Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelFolderNameFont}"
                        Style="{StaticResource ColorRowLabelStyle}"/>
                <Border x:Name="FolderNameFontSwatch"
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        MouseLeftButtonDown="FolderNameFontSwatch_MouseLeftButtonDown"/>

                <TextBlock Grid.Row="1"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelFolderNameHighlightFont}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="0,10,0,0"/>
                <Border x:Name="FolderNameHighlightFontSwatch"
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        Margin="0,10,0,0"
                        MouseLeftButtonDown="FolderNameHighlightFontSwatch_MouseLeftButtonDown"/>

                <TextBlock Grid.Row="2"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelFolderNameHoverFont}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="0,10,0,0"/>
                <Border x:Name="FolderNameHoverFontSwatch"
                        Grid.Row="2"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        Margin="0,10,0,0"
                        MouseLeftButtonDown="FolderNameHoverFontSwatch_MouseLeftButtonDown"/>

                <TextBlock Grid.Row="3"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelFileNameFont}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="0,10,0,0"/>
                <Border x:Name="FileNameFontSwatch"
                        Grid.Row="3"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        Margin="0,10,0,0"
                        MouseLeftButtonDown="FileNameFontSwatch_MouseLeftButtonDown"/>

                <TextBlock Grid.Row="4"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelFileNameHighlightFont}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="0,10,0,0"/>
                <Border x:Name="FileNameHighlightFontSwatch"
                        Grid.Row="4"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        Margin="0,10,0,0"
                        MouseLeftButtonDown="FileNameHighlightFontSwatch_MouseLeftButtonDown"/>

                <TextBlock Grid.Row="5"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelFileNameHoverFont}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="0,10,0,0"/>
                <Border x:Name="FileNameHoverFontSwatch"
                        Grid.Row="5"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        Margin="0,10,0,0"
                        MouseLeftButtonDown="FileNameHoverFontSwatch_MouseLeftButtonDown"/>

                <!-- Faint divider between the folder/file name colors above
                     and the general app colors below. -->
                <Border Grid.Row="6"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        BorderBrush="#FF3A3A3A"
                        BorderThickness="0,0,0,1"
                        Margin="0,12,0,4"/>

                <TextBlock Grid.Row="7"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelHeader}"
                        Style="{StaticResource ColorRowLabelStyle}"/>
                <Border x:Name="HeaderSwatch"
                        Grid.Row="7"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        MouseLeftButtonDown="HeaderSwatch_MouseLeftButtonDown"/>

                <TextBlock Grid.Row="8"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelHistory}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="0,10,0,0"/>
                <Border x:Name="HistorySwatch"
                        Grid.Row="8"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        Margin="0,10,0,0"
                        MouseLeftButtonDown="HistorySwatch_MouseLeftButtonDown"/>

                <TextBlock Grid.Row="9"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelBackground}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="0,10,0,0"/>
                <Border x:Name="BackgroundSwatch"
                        Grid.Row="9"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        Margin="0,10,0,0"
                        MouseLeftButtonDown="BackgroundSwatch_MouseLeftButtonDown"/>

                <TextBlock Grid.Row="10"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelSelection}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="0,10,0,0"/>
                <Border x:Name="SelectionSwatch"
                        Grid.Row="10"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        Margin="0,10,0,0"
                        MouseLeftButtonDown="SelectionSwatch_MouseLeftButtonDown"/>

                <TextBlock Grid.Row="11"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelHoverBackground}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="0,10,0,0"/>
                <Border x:Name="HoverBackgroundSwatch"
                        Grid.Row="11"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        Margin="0,10,0,0"
                        MouseLeftButtonDown="HoverBackgroundSwatch_MouseLeftButtonDown"/>

                <TextBlock Grid.Row="12"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelGuideLine}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="0,10,0,0"/>
                <Border x:Name="GuideLineSwatch"
                        Grid.Row="12"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        Margin="0,10,0,0"
                        MouseLeftButtonDown="GuideLineSwatch_MouseLeftButtonDown"/>

                <TextBlock Grid.Row="13"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelGuideLineActive}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="0,10,0,0"/>
                <Border x:Name="GuideLineActiveSwatch"
                        Grid.Row="13"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        Margin="0,10,0,0"
                        MouseLeftButtonDown="GuideLineActiveSwatch_MouseLeftButtonDown"/>

                <TextBlock Grid.Row="14"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelPanelDivider}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="0,10,0,0"/>
                <Border x:Name="PanelDividerSwatch"
                        Grid.Row="14"
                        Grid.Column="1"
                        Style="{StaticResource ColorSwatchStyle}"
                        Margin="0,10,0,0"
                        MouseLeftButtonDown="PanelDividerSwatch_MouseLeftButtonDown"/>

                <StackPanel Grid.Row="15"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                    <Button Content="{x:Static services:Strings.ButtonDefaults}"
                            Style="{StaticResource DialogButtonStyle}"
                            Width="70"
                            Margin="0,0,8,0"
                            Click="ResetDefaults_Click"/>
                    <Button Content="{x:Static services:Strings.ButtonClose}"
                            Style="{StaticResource DialogButtonStyle}"
                            Width="70"
                            IsCancel="True"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
