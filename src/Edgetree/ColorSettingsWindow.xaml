<Window x:Class="SidebarExplorer.App.ColorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SidebarExplorer.App.Services"
        Title="{x:Static services:Strings.ColorSettingsTitle}"
        SizeToContent="Height"
        Width="{DynamicResource ColorDialogWidth}"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        FontSize="{DynamicResource DialogFontSize}"
        Background="{DynamicResource DialogBackground}">
    <Window.Resources>
        <Style x:Key="DialogCloseButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Width"
                    Value="28"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorRowLabelStyle"
                TargetType="TextBlock">
            <!-- Trimmed rather than allowed to run under the hex box beside
                 it: the label column is the one that gives way when a long
                 Korean label meets a fixed-width field (2026-08-02). -->
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource DialogFontSize}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="ColorSwatchStyle"
                TargetType="Border">
            <!-- Scaled with the rest (ApplyLayoutMetrics): a swatch is the
                 thing being aimed at in this window, so it has no business
                 staying 32x20 while everything around it grows. -->
            <Setter Property="Width"
                    Value="{DynamicResource DialogSwatchWidth}"/>
            <Setter Property="Height"
                    Value="{DynamicResource DialogSwatchHeight}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="3"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <!-- The colour code beside each swatch. Requested by mail 2026-07-31:
             Windows' own picker has three RGB number boxes and nowhere to paste
             "#2E7D32" from a browser or a design tool, which is how colours
             actually travel.
             Standing in the row rather than behind a gesture. A right-click
             popup was built first and thrown away for two reasons: the app's
             own stuck-capture watchdog releases any popup that holds capture
             without a menu being open, so it closed itself after a second
             (capture-watchdog.log, "released stuck capture: WPF(PopupRoot)"),
             and what was wanted was the field simply BEING there, beside the
             palette. Width was the reason it wasn't there to begin with, and
             that was given up.
             Every box is wired through this one style: it carries the handlers
             and each row only names the swatch it belongs to, so a colour added
             later needs one Tag and nothing else. -->
        <Style x:Key="ColorHexBoxStyle"
                TargetType="TextBox">
            <Setter Property="Width"
                    Value="{DynamicResource DialogHexInputWidth}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource DialogHintFontSize}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="TextAlignment"
                    Value="Center"/>
            <Setter Property="Margin"
                    Value="0,0,14,0"/>
            <Setter Property="Padding"
                    Value="1,1"/>
            <Setter Property="Background"
                    Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="CaretBrush"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="ToolTip"
                    Value="{x:Static services:Strings.ColorHexInputHint}"/>
            <EventSetter Event="Loaded"
                    Handler="HexBox_Loaded"/>
            <EventSetter Event="KeyDown"
                    Handler="HexBox_KeyDown"/>
            <EventSetter Event="LostKeyboardFocus"
                    Handler="HexBox_LostKeyboardFocus"/>
        </Style>

        <!-- Plain Button defaults to the OS theme's white/light chrome, which
             clashed hard against this window's dark background - flat,
             outlined, and rounded to match the rest of the app instead. -->
        <Style x:Key="DialogButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource DialogFontSize}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Padding is bound so a button can size to its own
                             words instead of the fixed width - the export and
                             import pair share a row with 기본값 and would not
                             all fit at 70 each. -->
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ControlHoverBorder}"/>
                            </Trigger>
                            <!-- A fully custom template has no built-in disabled
                                 look at all otherwise - ResetDefaultsButton relies
                                 on this to read as unclickable when colors are
                                 already at the current theme's defaults. -->
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Bar and title both grow with the font and both stop on the
                     way down - see HelpWindow, where the missing floor under
                     the title was caught. -->
                <RowDefinition Height="{DynamicResource DialogTitleBarHeight}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                    Background="{DynamicResource DialogHeaderBackground}"
                    MouseLeftButtonDown="HeaderGrid_MouseLeftButtonDown">
                <!-- The app's own icon beside the title, the same arrangement
                     the help window uses: these windows carry no taskbar entry
                     and no system title bar, so without it a bare "색상 설정"
                     floating over the desktop does not say whose it is. -->
                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource DialogTitleIndent}">
                    <!-- The TITLE's size, not the tree's icon size: it stands
                         beside a line of type rather than in a row of other
                         icons, so what it has to match is the letters. -->
                    <Image Source="pack://application:,,,/Resources/icon.png"
                            Width="{DynamicResource DialogTitleTextSize}"
                            Height="{DynamicResource DialogTitleTextSize}"
                            Margin="0,0,7,0"
                            RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{x:Static services:Strings.ColorSettingsTitle}"
                            Foreground="{DynamicResource DialogForeground}"
                            FontSize="{DynamicResource DialogTitleTextSize}"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource DialogCloseButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip="{x:Static services:Strings.ButtonClose}"
                        Click="CloseButton_Click">
                    <Path Data="M4,4 L12,12 M12,4 L4,12"
                            Stroke="{DynamicResource DialogForeground}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- Two buttons for the theme, one filled to say which is on, and
                 one pair of dice.

                 Why not a single toggle, which is the smaller control: a lone
                 button that named the mode it would switch TO was ambiguous
                 (2026-08-09) - "am I in dark, or does this make it dark?".
                 Two buttons each naming their own mode answer that, and the
                 fill answers which one you are in.

                 What this replaced was two ZONES, each with its own pair of
                 dice, of which one pair was ALWAYS disabled - an artefact of
                 there being two zones rather than anything the user could act
                 on. One pair remains and rolls whatever theme is being looked
                 at, which was already the rule. Six buttons became four and
                 none of them is permanently dead. -->
            <Grid Grid.Row="1"
                    Margin="16,12,16,0">
                <!-- The two theme buttons, the gap, and the two dice.

                     EVERY BUTTON IS Auto AND THE GAP IS THE `*`. A star column
                     does not mean "share the room" when there is not enough of
                     it - it takes what is left and CLIPS whatever does not fit,
                     while an Auto neighbour takes its full width first. So when
                     the switches were `*` the row always cut the same thing: the
                     only buttons in it carrying words (2026-08-12, "Dark Mo…" at
                     the small font sizes). The gap is the one thing here that
                     can give its pixels back, so the gap is what gives. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Two ordinary buttons of this window's one button style,
                     and the ON one is stamped in the app's blue - painted in
                     RefreshThemeToggles, which is also where the reasoning is.
                     A joined segmented control was tried here first and did not
                     read as a control anyone recognised, so the two went back
                     to looking like the buttons they are.

                     They carry their own Padding because the style sets none
                     and these two are the only buttons in the window that
                     never did: they used to sit in `*` columns, which stretched
                     them wide enough that the missing padding never showed. -->
                <Button x:Name="DarkModeButton"
                        Content="{x:Static services:Strings.ColorThemeDarkMode}"
                        Style="{StaticResource DialogButtonStyle}"
                        Padding="10,0"
                        Click="DarkMode_Click"/>
                <Button x:Name="LightModeButton"
                        Grid.Column="1"
                        Content="{x:Static services:Strings.ColorThemeLightMode}"
                        Style="{StaticResource DialogButtonStyle}"
                        Padding="10,0"
                        Margin="6,0,0,0"
                        Click="LightMode_Click"/>
                <!-- The tree's and the panels' edge shading, on/off. It is not
                     a colour, and it is here anyway: named among the options
                     menu's behaviour toggles, "그림자" reads as a shadow around
                     the whole app, where beside the palette it reads as
                     shading inside these lists (the author's call, 2026-08-15).
                     Wears the same accent stamp as the theme pair when it is
                     on, but unlike that pair it stays clickable - it is a
                     switch, and the press that turns it off has to land. -->
                <Button x:Name="EdgeShadesButton"
                        Grid.Column="3"
                        Content="{x:Static services:Strings.ButtonEdgeShades}"
                        Style="{StaticResource DialogButtonStyle}"
                        Padding="10,0"
                        Margin="0,0,6,0"
                        ToolTip="{x:Static services:Strings.ButtonEdgeShadesTip}"
                        Click="EdgeShades_Click"/>
                <Button x:Name="RandomButton"
                        Grid.Column="4"
                        Content="{x:Static services:Strings.ButtonRandomColors}"
                        Style="{StaticResource DialogButtonStyle}"
                        Padding="10,0"
                        ToolTip="{x:Static services:Strings.ButtonRandomColorsTip}"
                        Click="Random_Click"/>
                <!-- The bolder roll, beside the ordinary one rather than
                     replacing it: the quiet die is worth keeping because its
                     small differences are exactly what shows up differently on
                     someone else's monitor, which is the point of rolling at
                     all. This one starts from a primary hue and lifts the
                     saturation ceilings - same readability floors. -->
                <Button x:Name="DaringButton"
                        Grid.Column="5"
                        Style="{StaticResource DialogButtonStyle}"
                        Padding="9,0"
                        Margin="4,0,0,0"
                        ToolTip="{x:Static services:Strings.ButtonDaringColorsTip}"
                        Click="Daring_Click">
                    <!-- Material Symbols "palette" (2026-08-11). The one mark
                         in this window, and it earns that: the button beside it
                         is a word for the ordinary die, and this one is the
                         odd, deliberate thing - which is what a picture says
                         faster than "원색" did. -->
                    <Path Data="M480-96q-79 0-149-30t-122.5-82.5Q156-261 126-331T96-480q0-80 30.5-149.5t84-122Q264-804 335.5-834T488-864q78 0 146.5 27T754-763q51 47 80.5 110T864-518q0 96-67 163t-163 67h-68q-8 0-14 5t-6 13q0 15 15 25t15 53q0 37-27 66.5T480-96Zm0-384Zm-173.5 18.5Q324-479 324-504t-17.5-42.5Q289-564 264-564t-42.5 17.5Q204-529 204-504t17.5 42.5Q239-444 264-444t42.5-17.5Zm120-144Q444-623 444-648t-17.5-42.5Q409-708 384-708t-42.5 17.5Q324-673 324-648t17.5 42.5Q359-588 384-588t42.5-17.5Zm192 0Q636-623 636-648t-17.5-42.5Q601-708 576-708t-42.5 17.5Q516-673 516-648t17.5 42.5Q551-588 576-588t42.5-17.5Zm120 144Q756-479 756-504t-17.5-42.5Q721-564 696-564t-42.5 17.5Q636-529 636-504t17.5 42.5Q671-444 696-444t42.5-17.5ZM480-168q11 0 17.5-8.5T504-192q0-16-15-28t-15-50q0-38 26.5-64t64.5-26h69q66 0 112-46t46-112q0-115-88.5-194.5T488-792q-134 0-227 91t-93 221q0 130 91 221t221 91Z"
                            Stretch="Uniform"
                            Width="{DynamicResource DialogFontSize}"
                            Height="{DynamicResource DialogFontSize}"
                            Fill="{Binding Foreground,
                                RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>

            <Grid Grid.Row="2"
                    Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                        Grid.Column="0"
                        x:Name="LabelFolderName"
                        Text="{x:Static services:Strings.ColorLabelFolderNameFont}"
                        Style="{StaticResource ColorRowLabelStyle}"/>
                <StackPanel Grid.Row="0"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                    <TextBox Tag="FolderNameFontSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="FolderNameFontSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="FolderNameFontSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="1"
                        Grid.Column="0"
                        x:Name="LabelFolderNameHighlight"
                        Text="{x:Static services:Strings.ColorLabelFolderNameHighlightFont}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="FolderNameHighlightFontSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="FolderNameHighlightFontSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="FolderNameHighlightFontSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="2"
                        Grid.Column="0"
                        x:Name="LabelFolderNameHover"
                        Text="{x:Static services:Strings.ColorLabelFolderNameHoverFont}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="FolderNameHoverFontSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="FolderNameHoverFontSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="FolderNameHoverFontSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="3"
                        Grid.Column="0"
                        x:Name="LabelFileName"
                        Text="{x:Static services:Strings.ColorLabelFileNameFont}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="3"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="FileNameFontSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="FileNameFontSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="FileNameFontSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="4"
                        Grid.Column="0"
                        x:Name="LabelFileNameHighlight"
                        Text="{x:Static services:Strings.ColorLabelFileNameHighlightFont}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="4"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="FileNameHighlightFontSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="FileNameHighlightFontSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="FileNameHighlightFontSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="5"
                        Grid.Column="0"
                        x:Name="LabelFileNameHover"
                        Text="{x:Static services:Strings.ColorLabelFileNameHoverFont}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="5"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="FileNameHoverFontSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="FileNameHoverFontSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="FileNameHoverFontSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="6"
                        Grid.Column="0"
                        x:Name="LabelShowMore"
                        Text="{x:Static services:Strings.ColorLabelShowMore}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="6"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="ShowMoreFontSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="ShowMoreFontSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="ShowMoreFontSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <!-- Faint divider between the folder/file name colors above
                     and the general app colors below. -->
                <Border Grid.Row="7"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        BorderBrush="{DynamicResource PanelBorder}"
                        BorderThickness="0,0,0,1"
                        Margin="{DynamicResource DialogDividerMargin}"/>

                <TextBlock Grid.Row="8"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelHeader}"
                        Style="{StaticResource ColorRowLabelStyle}"/>
                <StackPanel Grid.Row="8"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                    <TextBox Tag="HeaderSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="HeaderSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="HeaderSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="9"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelHistory}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="9"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="HistorySwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="HistorySwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="HistorySwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="10"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelBackground}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="10"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="BackgroundSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="BackgroundSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="BackgroundSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="12"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelSelection}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="12"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="SelectionSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="SelectionSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="SelectionSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="13"
                        Grid.Column="0"
                        x:Name="LabelHoverBackground"
                        Text="{x:Static services:Strings.ColorLabelHoverBackground}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="13"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="HoverBackgroundSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="HoverBackgroundSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="HoverBackgroundSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="14"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelGuideLine}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="14"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="GuideLineSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="GuideLineSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="GuideLineSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="15"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelGuideLineActive}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="15"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="GuideLineActiveSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="GuideLineActiveSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="GuideLineActiveSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="16"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelPanelDivider}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="16"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="PanelDividerSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="PanelDividerSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="PanelDividerSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <!-- Row 11, right under 탐색기 배경 (2026-08-08 - the two
                     backgrounds belong together) - declared here out of row
                     order only because it arrived later. -->
                <TextBlock Grid.Row="11"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelViewerBackground}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="11"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="ViewerBackgroundSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="ViewerBackgroundSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="ViewerBackgroundSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <!-- Last, and on its own: it is the one colour on this page
                     that is not seen against the app at all - the sidebar has
                     to be hidden first, so there is nothing to compare it with
                     while it is being set. -->
                <TextBlock Grid.Row="17"
                        Grid.Column="0"
                        Text="{x:Static services:Strings.ColorLabelAutoHideHandle}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="17"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <TextBox Tag="AutoHideHandleSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="AutoHideHandleSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="AutoHideHandleSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <!-- 기본값 sits at the far left, away from 닫기. It throws away
                     every colour on this page and the two used to be neighbours,
                     one button-width apart - the kind of miss that costs the
                     whole palette. Opposite ends of the row is the usual place
                     for a discard action, and the confirm prompt stays either
                     way. -->
                <Grid Grid.Row="18"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,18,0,0">
                    <!-- 내보내기/불러오기 stand with 기본값 rather than beside
                         닫기: all three act on the whole palette, and none of
                         them is what someone reaches for on the way out. -->
                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left">
                        <Button x:Name="ResetDefaultsButton"
                                Content="{x:Static services:Strings.ButtonDefaults}"
                                Style="{StaticResource DialogButtonStyle}"
                                Width="{DynamicResource DialogButtonWidth}"
                                Click="ResetDefaults_Click"/>
                        <Button Content="{x:Static services:Strings.ButtonExportColors}"
                                Style="{StaticResource DialogButtonStyle}"
                                Padding="10,0"
                                Margin="6,0,0,0"
                                Click="ExportColors_Click"/>
                        <Button Content="{x:Static services:Strings.ButtonImportColors}"
                                Style="{StaticResource DialogButtonStyle}"
                                Padding="10,0"
                                Margin="6,0,0,0"
                                Click="ImportColors_Click"/>
                        <!-- Alive only after a 랜덤 roll, and it returns BOTH
                             themes to what they were before the FIRST roll of
                             this window session - closing the window is what
                             commits a roll. Stands with the other
                             whole-palette actions for the same reason they
                             stand together. -->
                        <Button x:Name="UndoRandomButton"
                                Content="{x:Static services:Strings.ButtonUndoRandom}"
                                Style="{StaticResource DialogButtonStyle}"
                                Padding="10,0"
                                Margin="6,0,0,0"
                                IsEnabled="False"
                                Click="UndoRandom_Click"/>
                    </StackPanel>
                    <!-- No 닫기 here. The title bar already carries an X, and a
                         second way out was crowding the three buttons that do
                         the actual work of this window. Esc still closes it -
                         that used to come from this button's IsCancel and now
                         lives in ColorSettingsWindow_PreviewKeyDown, which
                         gives the picker first refusal on the key. -->
                </Grid>
            </Grid>

            <!-- The picker, and why it is a layer inside this window rather
                 than a Popup. A Popup that closes on an outside click does so
                 by holding the mouse with no button down, and the app's own
                 stuck-capture watchdog collects exactly that after three
                 seconds - which is how the earlier right-click popup shut
                 itself (capture-watchdog.log, "released stuck capture:
                 WPF(PopupRoot)"). Dragging here captures the mouse too, but
                 only with the button held, and the watchdog stands down for
                 the whole time any button is down. So this never meets it.
                 It also means no second HWND, so no activation flash to
                 suppress.

                 The layer under the panel is what closes it: a click anywhere
                 outside the panel lands there. Transparent, not dimmed - it
                 was shaded for a while so the panel would stand apart, and
                 that shade fell across the swatches and the labels being
                 judged, which is the one thing this window exists to show
                 truthfully. The panel carries its own darker background
                 instead, so the separation costs nothing behind it. -->
            <Canvas x:Name="PickerLayer"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Panel.ZIndex="10"
                    Background="Transparent"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="PickerLayer_MouseLeftButtonDown">
                <Border x:Name="PickerPanel"
                        Width="250"
                        Background="{DynamicResource PickerPanelBackground}"
                        BorderBrush="{DynamicResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10">
                    <StackPanel>
                        <!-- Saturation across, brightness down, over a fill of
                             the pure hue - the arrangement every picker uses,
                             so nobody has to be told how it works. -->
                        <Border x:Name="FieldHost"
                                Height="140"
                                CornerRadius="3"
                                ClipToBounds="True"
                                Cursor="Cross"
                                MouseLeftButtonDown="FieldHost_MouseLeftButtonDown"
                                MouseMove="FieldHost_MouseMove"
                                MouseLeftButtonUp="FieldHost_MouseLeftButtonUp">
                            <Grid>
                                <Rectangle x:Name="FieldHueFill"/>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0"
                                                EndPoint="1,0">
                                            <GradientStop Offset="0"
                                                    Color="#FFFFFFFF"/>
                                            <GradientStop Offset="1"
                                                    Color="#00FFFFFF"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0"
                                                EndPoint="0,1">
                                            <GradientStop Offset="0"
                                                    Color="#00000000"/>
                                            <GradientStop Offset="1"
                                                    Color="#FF000000"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <!-- Two rings, light over dark: one ring alone
                                     disappears against the half of the field
                                     that matches it. -->
                                <Canvas IsHitTestVisible="False">
                                    <Ellipse x:Name="FieldThumbOuter"
                                            Width="13"
                                            Height="13"
                                            Stroke="#B0000000"
                                            StrokeThickness="3"/>
                                    <Ellipse x:Name="FieldThumbInner"
                                            Width="13"
                                            Height="13"
                                            Stroke="White"
                                            StrokeThickness="1.5"/>
                                </Canvas>
                            </Grid>
                        </Border>

                        <Border x:Name="HueHost"
                                Height="14"
                                Margin="0,8,0,0"
                                CornerRadius="3"
                                ClipToBounds="True"
                                Cursor="Cross"
                                MouseLeftButtonDown="HueHost_MouseLeftButtonDown"
                                MouseMove="HueHost_MouseMove"
                                MouseLeftButtonUp="HueHost_MouseLeftButtonUp">
                            <Grid>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0"
                                                EndPoint="1,0">
                                            <GradientStop Offset="0"
                                                    Color="#FFFF0000"/>
                                            <GradientStop Offset="0.167"
                                                    Color="#FFFFFF00"/>
                                            <GradientStop Offset="0.333"
                                                    Color="#FF00FF00"/>
                                            <GradientStop Offset="0.5"
                                                    Color="#FF00FFFF"/>
                                            <GradientStop Offset="0.667"
                                                    Color="#FF0000FF"/>
                                            <GradientStop Offset="0.833"
                                                    Color="#FFFF00FF"/>
                                            <GradientStop Offset="1"
                                                    Color="#FFFF0000"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Canvas IsHitTestVisible="False">
                                    <Border x:Name="HueThumb"
                                            Width="5"
                                            Height="14"
                                            CornerRadius="2"
                                            BorderBrush="White"
                                            BorderThickness="2">
                                        <Border BorderBrush="#B0000000"
                                                BorderThickness="1"/>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>

                        <!-- The value in the same form it is pasted in, next to
                             the colours picked earlier this session: the native
                             dialog's custom-colour row is gone with it, and a
                             palette that forgets between two rows is worse than
                             none. -->
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="PickerHexText"
                                    Foreground="{DynamicResource DialogForeground}"
                                    FontSize="{DynamicResource DialogHintFontSize}"
                                    VerticalAlignment="Center"/>
                            <StackPanel x:Name="PickerRecent"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>
    </Border>
</Window>
