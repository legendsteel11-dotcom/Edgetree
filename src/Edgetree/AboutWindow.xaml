<Window x:Class="SidebarExplorer.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SidebarExplorer.App.Services"
        Title="{x:Static services:Strings.AboutTitle}"
        SizeToContent="Height"
        Width="300"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Background="{DynamicResource DialogBackground}">
    <Window.Resources>
        <Style x:Key="DialogCloseButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Width"
                    Value="28"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AboutRowLabelStyle"
                TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryForeground}"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Margin"
                    Value="0,0,0,2"/>
        </Style>

        <Style x:Key="AboutRowValueStyle"
                TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
        </Style>

        <Style x:Key="DialogButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ControlHoverBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                    Background="{DynamicResource DialogHeaderBackground}"
                    MouseLeftButtonDown="HeaderGrid_MouseLeftButtonDown">
                <TextBlock Text="Edgetree"
                        Foreground="{DynamicResource DialogForeground}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"/>
                <Button Style="{StaticResource DialogCloseButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip="{x:Static services:Strings.ButtonClose}"
                        Click="CloseButton_Click">
                    <Path Data="M4,4 L12,12 M12,4 L4,12"
                            Stroke="{DynamicResource DialogForeground}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1"
                    Margin="16">
                <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,14">
                    <Image Source="pack://application:,,,/Resources/icon.png"
                            Width="24"
                            Height="24"
                            Margin="0,0,8,0"
                            RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Edgetree"
                            Foreground="{DynamicResource DialogForeground}"
                            FontSize="14"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{x:Static services:Strings.AboutVersionLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock x:Name="VersionText"
                        Style="{StaticResource AboutRowValueStyle}"
                        Margin="0,0,0,10"/>

                <!-- Only appears when the startup update check found a newer
                     release (see the constructor) - the options-button dot
                     says "there's an update", this is where it can actually
                     be fetched. Sits right under the version it supersedes. -->
                <TextBlock x:Name="UpdateLinkText"
                        Foreground="{DynamicResource AccentForeground}"
                        FontSize="12"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        Margin="0,-4,0,10"
                        Visibility="Collapsed"
                        MouseLeftButtonDown="UpdateLink_MouseLeftButtonDown"/>

                <TextBlock Text="{x:Static services:Strings.AboutAuthorLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock Text="{x:Static services:Strings.AboutAuthorValue}"
                        Style="{StaticResource AboutRowValueStyle}"
                        Margin="0,0,0,10"/>

                <TextBlock Text="{x:Static services:Strings.AboutDateLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock x:Name="DateText"
                        Style="{StaticResource AboutRowValueStyle}"
                        Margin="0,0,0,10"/>

                <TextBlock Text="{x:Static services:Strings.AboutLicenseLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock Text="{x:Static services:Strings.AboutLicenseSummary}"
                        Style="{StaticResource AboutRowValueStyle}"
                        Margin="0,0,0,10"/>

                <TextBlock Text="{x:Static services:Strings.AboutGithubLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock Text="github.com/legendsteel11/Edgetree"
                        Foreground="{DynamicResource AccentForeground}"
                        FontSize="12"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        Margin="0,0,0,10"
                        MouseLeftButtonDown="GithubLink_MouseLeftButtonDown"/>

                <TextBlock Text="{x:Static services:Strings.AboutWebsiteLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock Text="edgetree.vercel.app"
                        Foreground="{DynamicResource AccentForeground}"
                        FontSize="12"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        Margin="0,0,0,10"
                        MouseLeftButtonDown="WebsiteLink_MouseLeftButtonDown"/>

                <!-- The other half of a mutual link: TabStick's own site has
                     pointed here since 2026-07-25. Last of the rows on
                     purpose - it's the one line in this window that isn't
                     about Edgetree. -->
                <TextBlock Text="{x:Static services:Strings.AboutOtherToolLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock Text="TabStick"
                        Foreground="{DynamicResource AccentForeground}"
                        FontSize="12"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        MouseLeftButtonDown="OtherToolLink_MouseLeftButtonDown"/>

                <Button Content="{x:Static services:Strings.ButtonClose}"
                        Style="{StaticResource DialogButtonStyle}"
                        Width="70"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0"
                        IsCancel="True"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
