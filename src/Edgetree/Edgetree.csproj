<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness is declared in app.manifest, not here - see the comment
         there. ApplicationHighDpiMode used to be set to PerMonitorV2 at this
         spot and did nothing at all, because it only reaches the WinForms
         entry point this app doesn't use; it just made the setting look
         handled. WFAC010 is the WinForms SDK objecting to the manifest owning
         this instead, which is correct for a WPF-entry app. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.7.1</Version>
    <!-- Explicit rather than left to default from the .csproj filename, so a
         future file rename can't silently change the shipped exe/dll name
         again - the C# namespace stays SidebarExplorer.App throughout the
         source (an app-identity rename, not a source-level one). -->
    <AssemblyName>Edgetree</AssemblyName>
    <Product>Edgetree</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\**\*.png" />
    <Resource Include="Resources\icon-map.json" />
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\icon.png" />
    <!-- Apache-2.0 section 4a wants a copy of the licence IN the distribution,
         which a link cannot satisfy - and this app ships as a single exe with no
         folder to drop a text file into. So it rides inside the exe, and the
         About window writes it out and opens it on request. -->
    <Resource Include="Resources\APACHE-2.0.txt" />
    <!-- Compiled ps_2_0 bytecode for the HDR tone map, committed rather than
         built: WPF's ShaderEffect wants a .ps blob, and producing one needs an
         HLSL compiler that is not part of this toolchain (no Windows SDK on the
         build machine, and this project carries no package dependencies).
         The .hlsl beside it is the source of truth for a human; regenerate the
         blob with tools\compile-shader.ps1, which borrows the D3DCompile that
         already ships inside Windows. -->
    <Resource Include="Resources\HdrToneMap.ps" />
    <None Include="Resources\HdrToneMap.hlsl" />
  </ItemGroup>

  <!-- Microsoft.VisualBasic.FileIO.FileSystem.Delete*(..., RecycleOption.SendToRecycleBin)
       (the simplest reliable way to send deleted items to the Recycle Bin) is
       already available transitively via UseWindowsForms above - an explicit
       <Reference> here just duplicates and conflicts with it. -->

</Project>
